<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'queue', analytics }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.3rem 0;">
          ⏳ Article Moderation Queue
        </h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
          Review, approve, or reject technical articles submitted by developers.
        </p>
      </div>

      <span class="status-pill status-pill--pending" style="font-size: 0.85rem; padding: 0.35rem 0.85rem;">
        ⏳ <%= posts ? posts.length : 0 %> Pending Article<%= (posts && posts.length !== 1) ? 's' : '' %>
      </span>
    </div>

    <% if (!posts || posts.length === 0) { %>
      <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 4rem 2rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
        <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🎉</div>
        <h3 style="font-size: 1.25rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 800;">No Pending Articles</h3>
        <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto; font-size: 0.9rem; line-height: 1.5;">
          All community article submissions have been reviewed and moderated!
        </p>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1.2rem;">
        <% posts.forEach(post => { %>
          <div class="moderation-card">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.9rem; flex-wrap: wrap;">
              <div>
                <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
                  <span class="status-pill status-pill--pending">⏳ Pending Review</span>
                  
                  <% if (post.category) { %>
                    <span class="tech-badge" style="font-size: 0.74rem; padding: 0.15rem 0.55rem; background: var(--primary-indigo-light); color: var(--primary-indigo);"><%= post.category.name %></span>
                  <% } %>

                  <span class="tech-badge" style="font-size: 0.74rem; padding: 0.15rem 0.55rem; font-family: var(--font-mono); <%= post.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.16); color: #ef4444; border-color: rgba(239, 68, 68, 0.3);' : (post.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.16); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: rgba(99, 102, 241, 0.16); color: var(--primary-indigo); border-color: rgba(99, 102, 241, 0.3);') %>">
                    <%= post.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (post.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
                  </span>
                </div>

                <h3 style="font-size: 1.25rem; color: var(--text-main); font-weight: 800; margin: 0 0 0.4rem 0; line-height: 1.35;"><%= post.title %></h3>
                
                <div style="display: flex; gap: 0.7rem; align-items: center; font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono); flex-wrap: wrap;">
                  <span>By @<%= post.author ? (post.author.username || post.author.displayName) : 'Developer' %></span>
                  <span>•</span>
                  <span>Submitted <%= post.createdAtFormatted %></span>
                </div>
              </div>
            </div>

            <!-- Body Excerpt / Preview -->
            <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.1rem 1.3rem; max-height: 180px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.88rem; color: var(--text-body); white-space: pre-line; margin-bottom: 1.2rem; line-height: 1.6;">
              <%= post.body %>
            </div>

            <!-- Moderation Action Buttons -->
            <div style="display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;">
              <form action="/admin/posts/<%= post.id %>/approve" method="POST" style="margin: 0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn" style="background: #059669; color: #ffffff; padding: 0.5rem 1.2rem; font-size: 0.86rem; font-weight: 800; border-radius: var(--radius-lg); box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25); transition: transform 0.2s ease;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'">
                  ✓ Approve &amp; Publish
                </button>
              </form>

              <form action="/admin/posts/<%= post.id %>/reject" method="POST" style="margin: 0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.16); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.5rem 1.2rem; font-size: 0.86rem; border-radius: var(--radius-lg); font-weight: 700;">
                  ✕ Reject
                </button>
              </form>

              <a href="/edit-post/<%= post.id %>" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.5rem 1.1rem; font-size: 0.85rem; border-radius: var(--radius-lg); margin-left: auto; font-weight: 600;">
                Edit Details
              </a>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>

  </main>
</div>
