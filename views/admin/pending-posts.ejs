<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'queue', analytics }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>⏳ Article Moderation Queue</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Review, approve, or reject technical articles submitted by developers.</p>
        </div>

        <span class="tech-badge" style="background: #fffbe6; color: #d46b08; border-color: #ffe58f; font-size: 0.82rem; padding: 0.3rem 0.8rem;">
          ⏳ <%= posts.length %> Pending Article<%= posts.length !== 1 ? 's' : '' %>
        </span>
      </div>

      <% if (posts.length === 0) { %>
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center;">
          <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🎉</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 700;">No Pending Articles</h3>
          <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto; font-size: 0.9rem; line-height: 1.5;">
            All community submissions have been reviewed and moderated!
          </p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.2rem;">
          <% posts.forEach(post => { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-left: 4px solid #f59e0b; padding: 1.6rem 1.8rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);">
              
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.8rem; flex-wrap: wrap;">
                <div>
                  <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                    <span class="comment-status-pill comment-status-pill--pending">⏳ Pending Review</span>
                    <% if (post.category) { %>
                      <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;"><%= post.category.name %></span>
                    <% } %>
                    <span class="tech-badge" style="font-size: 0.7rem; padding: 0.12rem 0.5rem; font-family: var(--font-mono); <%= post.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3);' : (post.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent);') %>">
                      <%= post.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (post.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
                    </span>
                  </div>

                  <h3 style="font-size: 1.25rem; color: var(--text-main); font-weight: 700; margin-bottom: 0.3rem;"><%= post.title %></h3>
                  
                  <div style="display: flex; gap: 0.7rem; align-items: center; font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono); flex-wrap: wrap;">
                    <span>By <%= post.author ? (post.author.displayName || post.author.username) : 'Community Developer' %></span>
                    <span>•</span>
                    <span>Submitted <%= post.createdAtFormatted %></span>
                  </div>
                </div>
              </div>

              <!-- Body Excerpt / Preview -->
              <div style="background: var(--bg-main); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem 1.2rem; max-height: 180px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.88rem; color: var(--text-body); white-space: pre-line; margin-bottom: 1.2rem; line-height: 1.5;">
                <%= post.body %>
              </div>

              <!-- Moderation Action Buttons -->
              <div style="display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;">
                <form action="/admin/posts/<%= post.id %>/approve" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn" style="background: #059669; padding: 0.55rem 1.2rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
                    ✓ Approve &amp; Publish
                  </button>
                </form>

                <form action="/admin/posts/<%= post.id %>/reject" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-delete" style="padding: 0.55rem 1.2rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
                    ✕ Reject
                  </button>
                </form>

                <a href="/edit-post/<%= post.id %>" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.55rem 1rem; font-size: 0.85rem; box-shadow: none; border-radius: var(--radius-lg); margin-left: auto;">
                  Edit Details
                </a>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>
</div>
