<div class="dashboard__grid" style="grid-template-columns: 280px 1fr; gap: 2rem;">
  
  <%- include('../partials/sidebar-admin', { activeTab: 'faq' }) %>

  <main class="dashboard__content">
    
    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.3rem 0;">
          💡 Technical Interview Q&amp;A Management
        </h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
          Manage, edit, and create technical interview questions and model answers.
        </p>
      </div>

      <a href="/admin/faq/add" class="btn" style="padding: 0.65rem 1.4rem; font-size: 0.9rem; font-weight: 700; border-radius: var(--radius-lg);">
        <span>+ Add Question</span>
      </a>
    </div>

    <!-- Questions Data Table -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm);">
      <% if (questions && questions.length > 0) { %>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
          <thead>
            <tr style="background: var(--bg-subtle); border-bottom: 1px solid var(--border-light); color: var(--text-muted); font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase;">
              <th style="padding: 1rem 1.2rem;">ID</th>
              <th style="padding: 1rem 1.2rem;">Question</th>
              <th style="padding: 1rem 1.2rem;">Category</th>
              <th style="padding: 1rem 1.2rem;">Level</th>
              <th style="padding: 1rem 1.2rem;">Upvotes</th>
              <th style="padding: 1rem 1.2rem; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% questions.forEach(q => { %>
              <tr style="border-bottom: 1px solid var(--border-light); transition: background 0.2s;" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 1rem 1.2rem; font-family: var(--font-mono); color: var(--text-muted); font-weight: 700;">#<%= q.id %></td>
                
                <td style="padding: 1rem 1.2rem; max-width: 380px;">
                  <strong style="color: var(--text-main); font-size: 0.95rem; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <%= q.question %>
                  </strong>
                  <span style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
                    slug: <%= q.slug %>
                  </span>
                </td>

                <td style="padding: 1rem 1.2rem;">
                  <span class="tech-badge" style="font-size: 0.75rem; padding: 0.2rem 0.6rem; background: var(--primary-indigo-light); color: var(--primary-indigo);">
                    <%= q.category %>
                  </span>
                </td>

                <td style="padding: 1rem 1.2rem;">
                  <span class="tech-badge" style="font-size: 0.75rem; padding: 0.2rem 0.6rem; font-family: var(--font-mono); <%= q.difficulty === 'Senior' ? 'background: rgba(239, 68, 68, 0.18); color: #fca5a5;' : (q.difficulty === 'Junior' ? 'background: rgba(16, 185, 129, 0.18); color: #6ee7b7;' : 'background: rgba(129, 140, 248, 0.18); color: #a5b4fc;') %>">
                    <%= q.difficulty === 'Senior' ? '🚀 Senior' : (q.difficulty === 'Junior' ? '🌱 Junior' : '⚡ Mid') %>
                  </span>
                </td>

                <td style="padding: 1rem 1.2rem; font-family: var(--font-mono); color: var(--text-main); font-weight: 700;">
                  👍 <%= q.upvotesCount %>
                </td>

                <td style="padding: 1rem 1.2rem; text-align: right;">
                  <div style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
                    <a href="/admin/faq/edit/<%= q.id %>" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-md);">
                      Edit
                    </a>
                    
                    <form action="/admin/faq/delete/<%= q.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this question?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-md);">
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
          No interview questions in database yet. <a href="/admin/faq/add" style="color: var(--primary-indigo); font-weight: 700;">Add the first question &rarr;</a>
        </div>
      <% } %>
    </div>

  </main>

</div>
