<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'overview', analytics }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <!-- Quick Overview Header Banner -->
    <div style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%); border-radius: var(--radius-xl); padding: 1.8rem 2.2rem; color: #ffffff; margin-bottom: 1.8rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.2rem;">
      <div>
        <div style="font-family: var(--font-mono); font-size: 0.82rem; color: #818cf8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.3rem;">👑 Admin Command Console</div>
        <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0; color: #ffffff; line-height: 1.2;">System Dashboard</h1>
        <p style="margin: 0.4rem 0 0 0; opacity: 0.85; font-size: 0.92rem;">Manage content moderation, system metrics, users, and platform settings.</p>
      </div>

      <div style="display: flex; gap: 0.7rem; flex-wrap: wrap;">
        <a href="/admin/posts/pending" class="btn" style="background: #fffbe6; border: 1px solid #ffe58f; color: #d46b08; font-weight: 700; padding: 0.6rem 1.1rem; box-shadow: none; font-size: 0.88rem;">
          <span>⏳ Queue</span>
          <% if (analytics.pendingPostsCount > 0) { %>
            <span style="background: #d46b08; color: #fff; padding: 0.15rem 0.5rem; border-radius: var(--radius-full); font-size: 0.75rem; margin-left: 0.3rem;"><%= analytics.pendingPostsCount %></span>
          <% } %>
        </a>

        <a href="/add-post" class="btn" style="background: #ffffff; color: var(--primary-indigo); border: none; font-weight: 700; padding: 0.6rem 1.1rem; box-shadow: var(--shadow-sm); font-size: 0.88rem;">
          ✏️ Write Article
        </a>
      </div>
    </div>

    <!-- KPI Analytics Grid (4 Metric Cards) -->
    <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin-bottom: 1.8rem;">
      
      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo);">
          📝
        </div>
        <div>
          <div class="stat-card__number"><%= analytics.totalPosts %></div>
          <div class="stat-card__label">Published Articles</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
          👁
        </div>
        <div>
          <div class="stat-card__number"><%= (analytics.totalViews || 0).toLocaleString() %></div>
          <div class="stat-card__label">Total Views</div>
        </div>
      </div>

      <a href="/admin/posts/pending" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
          ⏳
        </div>
        <div>
          <div class="stat-card__number" style="color: #d46b08;"><%= analytics.pendingPostsCount %></div>
          <div class="stat-card__label">Pending Articles</div>
        </div>
      </a>

      <a href="/admin/comments" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.15); color: #059669;">
          💬
        </div>
        <div>
          <div class="stat-card__number" style="color: #059669;"><%= analytics.pendingCommentsCount %></div>
          <div class="stat-card__label">Pending Comments</div>
        </div>
      </a>

      <a href="/admin/courses/pending" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo);">
          🎓
        </div>
        <div>
          <div class="stat-card__number" style="color: var(--primary-indigo);"><%= analytics.pendingCoursesCount || 0 %></div>
          <div class="stat-card__label">Pending Courses</div>
        </div>
      </a>

    </div>

    <!-- All Articles Management Section -->
    <section class="dashboard-section" style="margin-bottom: 0;">
      <div class="dashboard-section__header">
        <div>
          <h2 class="dashboard-section__title">
            <span>📚 Article Repository</span>
          </h2>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Manage and edit all published and draft articles across DevHub.</p>
        </div>

        <span class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent); font-size: 0.8rem;">
          <%= data.length %> Total Posts
        </span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.9rem;">
        <% if (data.length === 0) { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3rem 1.8rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
            <div style="font-size: 2.2rem; margin-bottom: 0.6rem;">📝</div>
            <h3 style="font-size: 1.1rem; color: var(--text-main); margin-bottom: 0.3rem;">No articles in database</h3>
          </div>
        <% } else { %>
          <% data.forEach(post => { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.2rem 1.4rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; gap: 1.2rem; flex-wrap: wrap;">
              
              <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                  <% if (post.status === 'published') { %>
                    <span class="comment-status-pill comment-status-pill--approved">✓ Published</span>
                  <% } else if (post.status === 'pending') { %>
                    <span class="comment-status-pill comment-status-pill--pending">⏳ Pending</span>
                  <% } else if (post.status === 'rejected') { %>
                    <span class="comment-status-pill" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">✕ Rejected</span>
                  <% } %>

                  <% if (post.category) { %>
                    <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;"><%= post.category.name %></span>
                  <% } %>

                  <span class="tech-badge" style="font-size: 0.7rem; padding: 0.12rem 0.5rem; font-family: var(--font-mono); <%= post.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3);' : (post.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent);') %>">
                    <%= post.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (post.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
                  </span>
                </div>

                <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.3rem; line-height: 1.4; overflow-wrap: break-word; word-break: break-word;">
                  <a href="/post/<%= post.id || post._id %>" style="color: var(--text-main); text-decoration: none;"><%= post.title %></a>
                </h3>

                <div style="font-size: 0.78rem; color: var(--text-dim); font-family: var(--font-mono);">
                  <span>👁 <%= (post.viewsCount || 0).toLocaleString() %> views</span>
                  <% if (post.author) { %>
                    <span> • By <%= post.author.displayName || post.author.username %></span>
                  <% } %>
                </div>
              </div>

              <!-- Admin Action Buttons -->
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <% if (post.status === 'pending') { %>
                  <form action="/admin/posts/<%= post.id || post._id %>/approve" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn" style="background: #059669; color: white; padding: 0.45rem 0.85rem; font-size: 0.85rem; border-radius: var(--radius-md);" title="Approve & Publish Article">
                      ✓ Approve
                    </button>
                  </form>

                  <form action="/admin/posts/<%= post.id || post._id %>/reject" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-delete" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;" title="Reject Article">
                      ✕ Reject
                    </button>
                  </form>
                <% } %>

                <a href="/edit-post/<%= post.id || post._id %>" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.45rem 0.9rem; font-size: 0.85rem; box-shadow: none;">
                  Edit
                </a>

                <form action="/delete-post/<%= post.id || post._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this article?');" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-delete" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;">
                    Delete
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        <% } %>
      </div>
    </section>

  </main>
</div>