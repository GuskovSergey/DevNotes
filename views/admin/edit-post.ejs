<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'overview', analytics: typeof analytics !== 'undefined' ? analytics : {} }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>✏️ Edit Article</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Update content, category, cover image, and metadata.</p>
        </div>

        <form action="/delete-post/<%= data.id || data._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this article permanently?');" style="margin: 0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-delete" style="padding: 0.5rem 1.1rem; font-size: 0.85rem; border-radius: var(--radius-lg);">
            🗑 Delete Article
          </button>
        </form>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 2.2rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);">

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 0.8rem 1.1rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem; font-weight: 500; font-size: 0.9rem;">
            ⚠️ <%= errorMessage %>
          </div>
        <% } %>

        <form action="/edit-post/<%= data.id || data._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div style="margin-bottom: 1.2rem;">
            <label for="title" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Article Title *</label>
            <input type="text" placeholder="Article Title" name="title" value="<%= data.title %>" required style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.95rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; margin-bottom: 1.2rem;">
            <div>
              <label for="categoryId" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Category</label>
              <select name="categoryId" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
                <option value="">-- Select Category --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= data.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="featuredImage" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Cover Image</label>
              <% if (data.featuredImage) { %>
                <div style="margin-bottom: 0.6rem; border-radius: var(--radius-md); overflow: hidden; max-width: 160px; border: 1px solid var(--border-light);">
                  <img src="<%= data.featuredImage %>" alt="Current Cover" style="width: 100%; height: auto; display: block;">
                </div>
              <% } %>
              <input type="file" name="featuredImage" accept="image/*" style="width: 100%; padding: 0.6rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.88rem; background: var(--bg-surface); color: var(--text-main);">
            </div>
          </div>

          <div style="margin-bottom: 1.2rem;">
            <label for="tags" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Tags (comma-separated)</label>
            <input type="text" name="tags" value="<%= data.tags ? data.tags.map(t => t.name).join(', ') : '' %>" placeholder="e.g. nodejs, express, sqlite" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label for="body" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Content (Markdown Supported) *</label>
            <textarea name="body" rows="14" required style="width: 100%; padding: 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; font-family: var(--font-mono); background: var(--bg-surface); color: var(--text-main); line-height: 1.5; outline: none; resize: vertical;"><%= data.body %></textarea>
          </div>

          <button type="submit" class="btn" style="width: 100%; padding: 0.8rem; font-size: 0.95rem; font-weight: 700; justify-content: center; border-radius: var(--radius-lg);">
            <span>💾 Save Changes</span>
          </button>
        </form>

      </div>
    </div>

  </main>
</div>