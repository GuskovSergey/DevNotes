<div class="auth-card-wrapper">
  <div class="auth-card">
    
    <!-- Header Logo & Title -->
    <div class="auth-card__logo-area">
      <a href="/" class="header__logo" style="justify-content: center; margin-bottom: 0.5rem; text-decoration: none;">
        <span class="header__logo-badge">&lt;/dev&gt;</span>
        <span class="header__logo-text">DevHub</span>
      </a>
      <h2 style="font-size: 1.6rem; color: var(--text-main); margin-top: 0.5rem; font-weight: 800;">Admin Portal</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Sign in with administrator credentials</p>
    </div>

    <!-- Error Message Banner -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 0.85rem 1.1rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem; font-size: 0.9rem; text-align: center; font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span><%= errorMessage %></span>
      </div>
    <% } %>

    <!-- Admin Sign In Form -->
    <form action="/admin" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="auth-field">
        <label for="adminUsername">Admin Username or Email</label>
        <div class="auth-input-wrapper">
          <input type="text" id="adminUsername" name="username" placeholder="admin" required>
          <span class="auth-input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </span>
        </div>
      </div>

      <div class="auth-field" style="margin-bottom: 1.8rem;">
        <label for="adminPassword">Admin Password</label>
        <div class="auth-input-wrapper">
          <input type="password" id="adminPassword" name="password" placeholder="Enter admin password" required style="padding-right: 2.8rem;">
          <span class="auth-input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          <button type="button" class="password-toggle-btn" data-target="adminPassword" aria-label="Toggle Password Visibility">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" class="btn" style="width: 100%; padding: 0.85rem; font-size: 1rem; border-radius: var(--radius-lg);">
        <span>Sign In to Admin Portal</span>
        &rarr;
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.8rem; padding-top: 1.2rem; border-top: 1px solid var(--border-light);">
      <a href="/auth" style="color: var(--text-muted); font-size: 0.9rem; text-decoration: none;">Looking for regular User Sign In / Registration? &rarr;</a>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.password-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const inputId = btn.getAttribute('data-target');
        const input = document.getElementById(inputId);
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            btn.innerHTML = `
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            `;
          } else {
            input.type = 'password';
            btn.innerHTML = `
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            `;
          }
        }
      });
    });
  });
</script>