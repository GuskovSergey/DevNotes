<div class="dashboard">
  
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'courses', analytics: typeof analytics !== 'undefined' ? analytics : {} }) %>

  <main class="dashboard__content">
    <div class="dashboard-section">
      
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>✏️ Edit Course Track &amp; Lessons</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Update course details and manage syllabus lessons.</p>
        </div>

        <div style="display: flex; gap: 0.6rem;">
          <a href="/admin/courses/<%= course.id %>/lessons/new" class="btn" style="background: #059669; color: #ffffff; padding: 0.5rem 1.1rem; font-size: 0.85rem;">
            + Add Lesson
          </a>

          <a href="/admin/courses" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.5rem 1rem; font-size: 0.85rem; box-shadow: none;">
            &larr; Back to Courses
          </a>
        </div>
      </div>

      <!-- Course Details Form -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 2.2rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); margin-bottom: 2.2rem;">
        <h2 style="font-size: 1.2rem; font-weight: 800; color: var(--text-main); margin-bottom: 1.2rem;">Course Settings</h2>

        <form action="/admin/courses/<%= course.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div style="margin-bottom: 1.2rem;">
            <label for="title" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Course Title *</label>
            <input type="text" name="title" value="<%= course.title %>" required style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.95rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.2rem; margin-bottom: 1.2rem;">
            <div>
              <label for="difficultyLevel" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Difficulty Level</label>
              <select name="difficultyLevel" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
                <option value="Beginner" <%= course.difficultyLevel === 'Beginner' ? 'selected' : '' %>>🌱 Beginner</option>
                <option value="Intermediate" <%= course.difficultyLevel === 'Intermediate' ? 'selected' : '' %>>⚡ Intermediate</option>
                <option value="Advanced" <%= course.difficultyLevel === 'Advanced' ? 'selected' : '' %>>🚀 Advanced</option>
              </select>
            </div>

            <div>
              <label for="estimatedHours" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Estimated Hours</label>
              <input type="number" step="0.5" min="0.5" name="estimatedHours" value="<%= course.estimatedHours %>" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
            </div>

            <div>
              <label for="categoryId" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Category</label>
              <select name="categoryId" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none;">
                <option value="">-- Select Category --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= (course.category && course.category.id === cat.id) ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div style="margin-bottom: 1.2rem;">
            <label for="description" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Short Summary / Description *</label>
            <textarea name="description" rows="3" required style="width: 100%; padding: 0.85rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none; resize: vertical;"><%= course.description %></textarea>
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label for="body" style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">Full Overview &amp; Prerequisites (Markdown Supported)</label>
            <textarea name="body" rows="8" style="width: 100%; padding: 0.85rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; font-family: var(--font-mono); background: var(--bg-surface); color: var(--text-main); outline: none; resize: vertical;"><%= course.body %></textarea>
          </div>

          <button type="submit" class="btn" style="padding: 0.7rem 1.6rem; font-size: 0.9rem; font-weight: 700; border-radius: var(--radius-lg);">
            <span>💾 Save Course Changes</span>
          </button>
        </form>
      </div>

      <!-- Syllabus Lessons Management -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 2.2rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.4rem;">
          <div>
            <h2 style="font-size: 1.2rem; font-weight: 800; color: var(--text-main); margin: 0;">
              📖 Syllabus Lessons (<%= course.lessons ? course.lessons.length : 0 %>)
            </h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0.2rem 0 0 0;">Manage text modules for this course.</p>
          </div>

          <a href="/admin/courses/<%= course.id %>/lessons/new" class="btn" style="background: #059669; color: #ffffff; padding: 0.45rem 1rem; font-size: 0.85rem; border-radius: var(--radius-lg);">
            + Add Lesson
          </a>
        </div>

        <% if (!course.lessons || course.lessons.length === 0) { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 2.5rem; border-radius: var(--radius-lg); text-align: center; color: var(--text-muted);">
            No lessons added to this course yet. Click "+ Add Lesson" above to create the first module!
          </div>
        <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 0.8rem;">
            <% course.lessons.sort((a,b) => (a.order || 0) - (b.order || 0)).forEach(lesson => { %>
              <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); padding: 1rem 1.4rem; border-radius: var(--radius-lg); display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.8rem;">
                  <span style="font-family: var(--font-mono); font-weight: 800; font-size: 0.85rem; color: var(--primary-indigo); background: var(--primary-indigo-light); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <%= lesson.order %>
                  </span>
                  <div>
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin: 0;">
                      <%= lesson.title %>
                    </h3>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <a href="/admin/lessons/<%= lesson.id %>/edit" class="btn" style="background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.35rem 0.8rem; font-size: 0.82rem; box-shadow: none;">
                    Edit
                  </a>

                  <form action="/admin/lessons/<%= lesson.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete lesson?');" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-delete" style="padding: 0.35rem 0.8rem; font-size: 0.82rem;">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

      </div>

    </div>
  </main>
</div>
