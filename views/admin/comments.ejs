<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'comments', analytics }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.3rem 0;">
          💬 Comment Moderation Queue
        </h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
          Approve reader comments to make them public or delete spam and inappropriate remarks.
        </p>
      </div>

      <span class="status-pill status-pill--pending" style="font-size: 0.85rem; padding: 0.35rem 0.85rem;">
        💬 <%= comments ? comments.length : 0 %> Comment<%= (comments && comments.length !== 1) ? 's' : '' %> Total
      </span>
    </div>

    <!-- Summary Stats Ribbon -->
    <div class="faq-stats-grid" style="margin-bottom: 2.2rem;">
      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(99, 102, 241, 0.16); color: var(--primary-indigo);">💬</div>
        <div>
          <div class="stat-card__val"><%= comments ? comments.length : 0 %></div>
          <div class="stat-card__label">Total Comments</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.16); color: var(--accent-emerald);">✓</div>
        <div>
          <div class="stat-card__val"><%= comments ? comments.filter(c => c.isApproved).length : 0 %></div>
          <div class="stat-card__label">Approved &amp; Live</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(245, 158, 11, 0.16); color: #d97706;">⏳</div>
        <div>
          <div class="stat-card__val" style="color: #d97706;"><%= comments ? comments.filter(c => !c.isApproved).length : 0 %></div>
          <div class="stat-card__label">Pending Review</div>
        </div>
      </div>
    </div>

    <!-- Comments List -->
    <% if (!comments || comments.length === 0) { %>
      <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 4rem 2rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
        <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🎉</div>
        <h3 style="font-size: 1.25rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 800;">No Comments to Moderate</h3>
        <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto; font-size: 0.9rem; line-height: 1.5;">
          All discussions across your technical articles are clean and reviewed!
        </p>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1.2rem;">
        <% comments.forEach(comment => { %>
          <div class="moderation-card">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.9rem; flex-wrap: wrap;">
              <div>
                <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
                  <% if (comment.isApproved) { %>
                    <span class="status-pill status-pill--approved">✓ Approved</span>
                  <% } else { %>
                    <span class="status-pill status-pill--pending">⏳ Pending Review</span>
                  <% } %>

                  <% if (comment.post) { %>
                    <a href="/post/<%= comment.post.id %>" target="_blank" class="tech-badge" style="font-size: 0.74rem; padding: 0.15rem 0.55rem; background: var(--primary-indigo-light); color: var(--primary-indigo); text-decoration: none;">
                      📄 <%= comment.post.title %> ↗
                    </a>
                  <% } %>
                </div>

                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <div class="faq-author-avatar" style="width: 34px; height: 34px; font-size: 0.85rem;">
                    <%= (comment.authorName || 'D').charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <strong style="color: var(--text-main); font-size: 1.05rem; display: block;"><%= comment.authorName %></strong>
                    <span style="color: var(--text-muted); font-size: 0.78rem; font-family: var(--font-mono);">&lt;<%= comment.authorEmail %>&gt;</span>
                  </div>
                </div>
              </div>

              <div style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
                Submitted <%= comment.createdAtFormatted %>
              </div>
            </div>

            <!-- Comment Content Box -->
            <p style="color: var(--text-body); font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.2rem 0; background: var(--bg-subtle); padding: 1rem 1.2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); word-break: break-word;">
              <%= comment.content %>
            </p>

            <!-- Moderation Action Buttons -->
            <div style="display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;">
              <% if (!comment.isApproved) { %>
                <form action="/admin/comments/<%= comment.id %>/approve" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn" style="background: #059669; color: #ffffff; padding: 0.5rem 1.2rem; font-size: 0.86rem; font-weight: 800; border-radius: var(--radius-lg); box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25); transition: transform 0.2s ease;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'">
                    ✓ Approve Comment
                  </button>
                </form>
              <% } %>

              <form action="/admin/comments/<%= comment.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this comment?');" style="margin: 0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.16); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.5rem 1.2rem; font-size: 0.86rem; border-radius: var(--radius-lg); font-weight: 700;">
                  🗑 Delete Comment
                </button>
              </form>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>

  </main>
</div>
