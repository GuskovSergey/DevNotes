<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'comments', analytics }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>💬 Comment Moderation Queue</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Approve reader comments to make them public or delete spam and inappropriate remarks.</p>
        </div>

        <span class="tech-badge" style="background: #f0fdf4; color: #15803d; border-color: #bbf7d0; font-size: 0.82rem; padding: 0.3rem 0.8rem;">
          💬 <%= comments.length %> Comment<%= comments.length !== 1 ? 's' : '' %> Total
        </span>
      </div>

      <% if (comments.length === 0) { %>
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center;">
          <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🎉</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 700;">No Comments to Moderate</h3>
          <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto; font-size: 0.9rem; line-height: 1.5;">
            All discussions across your articles are clean and reviewed!
          </p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.2rem;">
          <% comments.forEach(comment => { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-left: 4px solid <%= comment.isApproved ? '#10b981' : '#f59e0b' %>; padding: 1.5rem 1.8rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);">
              
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.8rem; flex-wrap: wrap;">
                <div>
                  <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                    <% if (comment.isApproved) { %>
                      <span class="comment-status-pill comment-status-pill--approved">✓ Approved</span>
                    <% } else { %>
                      <span class="comment-status-pill comment-status-pill--pending">⏳ Pending Review</span>
                    <% } %>

                    <% if (comment.post) { %>
                      <a href="/post/<%= comment.post.id %>" target="_blank" class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem; text-decoration: none;">
                        📄 <%= comment.post.title %> ↗
                      </a>
                    <% } %>
                  </div>

                  <strong style="color: var(--text-main); font-size: 1.05rem;"><%= comment.authorName %></strong>
                  <span style="color: var(--text-muted); font-size: 0.82rem; font-family: var(--font-mono);">(&lt;<%= comment.authorEmail %>&gt;)</span>
                </div>

                <div style="font-size: 0.78rem; color: var(--text-dim); font-family: var(--font-mono);">
                  Submitted <%= comment.createdAtFormatted %>
                </div>
              </div>

              <!-- Comment Content Box -->
              <p style="color: var(--text-body); font-size: 0.95rem; line-height: 1.55; margin-bottom: 1.2rem; background: var(--bg-main); padding: 0.9rem 1.1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); word-break: break-word;">
                <%= comment.content %>
              </p>

              <!-- Moderation Action Buttons -->
              <div style="display: flex; gap: 0.8rem; align-items: center;">
                <% if (!comment.isApproved) { %>
                  <form action="/admin/comments/<%= comment.id %>/approve" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn" style="background: #059669; padding: 0.55rem 1.2rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
                      ✓ Approve Comment
                    </button>
                  </form>
                <% } %>

                <form action="/admin/comments/<%= comment.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this comment?');" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-delete" style="padding: 0.55rem 1.2rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
                    🗑 Delete Comment
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>
</div>
