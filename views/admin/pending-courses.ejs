<div class="dashboard">
  
  <!-- Sidebar Navigation for Admin -->
  <%- include('../partials/sidebar-admin', { currentUser, activeTab: 'course-queue', analytics }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>🎓 Course Moderation Queue</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Review, approve, or reject engineering course tracks submitted by community developers.</p>
        </div>

        <span class="tech-badge" style="background: #e0e7ff; color: #4338ca; border-color: #c7d2fe; font-size: 0.82rem; padding: 0.3rem 0.8rem;">
          🎓 <%= courses.length %> Pending Course<%= courses.length !== 1 ? 's' : '' %>
        </span>
      </div>

      <% if (courses.length === 0) { %>
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center;">
          <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🎉</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 700;">No Pending Courses</h3>
          <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto; font-size: 0.9rem; line-height: 1.5;">
            All course track submissions have been reviewed and moderated!
          </p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.2rem;">
          <% courses.forEach(course => { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-left: 4px solid var(--primary-indigo); padding: 1.6rem 1.8rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);">
              
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.8rem; flex-wrap: wrap;">
                <div>
                  <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                    <span class="comment-status-pill comment-status-pill--pending">⏳ Pending Review</span>
                    <% if (course.category) { %>
                      <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;"><%= course.category.name %></span>
                    <% } %>
                    <span class="tech-badge" style="font-size: 0.7rem; padding: 0.12rem 0.5rem; font-family: var(--font-mono); <%= course.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3);' : (course.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent);') %>">
                      <%= course.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (course.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
                    </span>
                    <span style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">⏱ <%= course.estimatedTime %></span>
                    <span style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">📚 <%= course.lessonsCount %> Lesson<%= course.lessonsCount !== 1 ? 's' : '' %></span>
                  </div>

                  <h3 style="font-size: 1.25rem; color: var(--text-main); font-weight: 700; margin-bottom: 0.3rem;"><%= course.title %></h3>
                  
                  <div style="display: flex; gap: 0.7rem; align-items: center; font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono); flex-wrap: wrap;">
                    <% if (course.author) { %>
                      <span>Author: <strong>@<%= course.author.username %></strong> (<%= course.author.displayName || course.author.username %>)</span>
                      <span>•</span>
                    <% } %>
                    <span>Submitted: <%= course.createdAtFormatted %></span>
                  </div>
                </div>

                <!-- Moderation Action Buttons -->
                <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
                  <form action="/admin/courses/<%= course.id %>/approve" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn" style="background: #059669; color: #ffffff; padding: 0.5rem 1.1rem; font-size: 0.85rem; font-weight: 700; border-radius: var(--radius-lg);">
                      ✓ Approve &amp; Publish
                    </button>
                  </form>

                  <form action="/admin/courses/<%= course.id %>/reject" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-delete" style="padding: 0.5rem 1rem; font-size: 0.85rem; border-radius: var(--radius-lg);">
                      ✕ Reject
                    </button>
                  </form>

                  <a href="/admin/courses/<%= course.id %>/edit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.5rem 0.9rem; font-size: 0.85rem; box-shadow: none; border-radius: var(--radius-lg);">
                    Inspect
                  </a>
                </div>
              </div>

              <!-- Course Summary Preview -->
              <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); padding: 1rem 1.2rem; border-radius: var(--radius-lg); font-size: 0.9rem; color: var(--text-body); line-height: 1.5; margin-top: 0.8rem;">
                <strong>Summary: </strong><%= course.description %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>

    </div>
  </main>
</div>
