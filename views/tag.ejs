<!-- Tag Hero Banner -->
<section class="dev-hero" style="padding: 2.5rem 0 2rem;">
  <div class="dev-hero__body">
    <div class="dev-hero__badge">
      <span class="dev-hero__badge-dot"></span>
      <span>Тег базы знаний</span>
    </div>

    <h1 class="dev-hero__heading" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
      #<%= tag.name %>
    </h1>
    <p class="dev-hero__sub">
      Все статьи и материалы базы знаний по тегу <strong>#<%= tag.name %></strong> на DevHub.
    </p>
  </div>
</section>

<!-- Articles Grid -->
<section class="articles">
  <h2 class="articles__heading">
    Найдено материалов в базе: <%= data.length %>
  </h2>

  <% if (data.length === 0) { %>
    <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 3rem; border-radius: var(--radius-lg); text-align: center; color: var(--text-muted);">
      Материалов с данным тегом в базе знаний пока нет.
    </div>
  <% } else { %>
    <ul class="article-grid">
      <% data.forEach(post => { %>
        <li class="article-card">
          <div class="article-card__media-wrapper">
            <% if (post.category) { %>
              <span class="article-card__badge-floating"><%= post.category.name %></span>
            <% } %>

            <% if (post.featuredImage) { %>
              <img src="<%= post.featuredImage %>" alt="<%= post.title %>" class="article-card__cover">
            <% } else { %>
              <div class="article-card__placeholder">
                <span>&lt;DevHub / Article&gt;</span>
              </div>
            <% } %>
          </div>

          <div class="article-card__body">
            <div class="article-card__meta-top">
              <span><%= post.createdAtFormatted %></span>
              <span>•</span>
              <span>⏱ <%= post.readingTime %></span>
              <span>•</span>
              <span>👁 <%= post.viewsCount %> views</span>
            </div>

            <h3 class="article-card__title">
              <a href="/post/<%= post._id %>"><%= post.title %></a>
            </h3>

            <p class="article-card__excerpt">
              <%= post.body %>
            </p>

            <% if (post.tags && post.tags.length > 0) { %>
              <div class="article-card__tags">
                <% post.tags.forEach(t => { %>
                  <a href="/tag/<%= t.slug %>" class="tech-badge" style="text-decoration: none; font-size: 0.7rem; padding: 0.15rem 0.55rem; <%= t.slug === tag.slug ? 'background: var(--primary-indigo); color: white;' : '' %>">
                    #<%= t.name %>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="article-card__footer">
            <a href="/post/<%= post._id %>" class="article-card__read-link">
              <span>Read Article</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <% if (nextPage !== null) { %>
    <div style="text-align: center; margin-top: 2rem;">
      <a href="/tag/<%= tag.slug %>?page=<%= nextPage %>" class="pagination">&lt; Older Articles</a>
    </div>
  <% } %>
</section>
