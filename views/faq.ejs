<!-- FAQ Hero Banner (Stitch Glassmorphic Design) -->
<section class="dev-hero" style="margin-bottom: 2rem; background: radial-gradient(circle at 50% -20%, rgba(99, 102, 241, 0.22) 0%, rgba(15, 19, 28, 0) 70%), var(--bg-surface);">
  <div class="dev-hero__body">
    <div class="dev-hero__badge">
      <span class="dev-hero__badge-dot"></span>
      <span>💡 DevHub Technical Interview Q&amp;A &amp; Knowledge Base</span>
    </div>

    <h1 class="dev-hero__heading">Technical Interview Q&amp;A</h1>
    <p class="dev-hero__sub">Production-tested backend engineering interview questions, system architecture FAQs, and deep-dive technical explanations.</p>

    <!-- Metrics Stat Cards Ribbon -->
    <div class="faq-stats-grid" style="max-width: 860px; margin: 1.8rem auto 0 auto;">
      <div class="stat-card">
        <div class="stat-card__icon">📚</div>
        <div style="text-align: left;">
          <div class="stat-card__val"><%= questions ? questions.length : 0 %></div>
          <div class="stat-card__label">Interview Questions</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.16); color: var(--accent-emerald);">⚡</div>
        <div style="text-align: left;">
          <div class="stat-card__val"><%= categories ? categories.length : 0 %></div>
          <div class="stat-card__label">Technical Topics</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(245, 158, 11, 0.16); color: #d97706;">💬</div>
        <div style="text-align: left;">
          <div class="stat-card__val">Community</div>
          <div class="stat-card__label">Verified Insights</div>
        </div>
      </div>
    </div>

    <div style="margin-top: 1.8rem;">
      <% if (currentUser) { %>
        <a href="/my/questions/new" class="btn" style="background: #ffffff; color: var(--primary-indigo); border: none; font-weight: 800; padding: 0.75rem 1.6rem; font-size: 0.92rem; border-radius: var(--radius-lg); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15); transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
          <span>+ Ask Question / Submit FAQ &rarr;</span>
        </a>
      <% } else { %>
        <a href="/auth" class="btn" style="background: rgba(255, 255, 255, 0.15); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); font-size: 0.88rem; padding: 0.65rem 1.4rem; border-radius: var(--radius-lg); backdrop-filter: blur(4px);">
          Sign In to Submit Questions &amp; Answers &rarr;
        </a>
      <% } %>
    </div>
  </div>
</section>

<!-- Filter & Mode Control Bar -->
<div style="max-width: 1240px; margin: 0 auto 2.2rem auto;">
  
  <form action="/faq" method="GET" class="faq-controls">
    
    <!-- Top Row: Search Box & Difficulty Selector -->
    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      
      <!-- Search Input -->
      <div style="flex: 1; min-width: 280px; position: relative;">
        <input type="text" name="q" value="<%= searchQuery || '' %>" class="faq-search-input" placeholder="Search questions (e.g. Event Loop, N+1, CSRF, SQLite)...">
        <span style="position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.95rem; pointer-events: none;">🔍</span>
      </div>

      <!-- Difficulty Selector -->
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <label for="difficulty-select" style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-muted); font-weight: 600;">Level:</label>
        <select name="difficulty" id="difficulty-select" onchange="this.form.submit()" style="padding: 0.65rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); background: var(--bg-subtle); color: var(--text-main); font-size: 0.88rem; font-family: var(--font-mono); outline: none; cursor: pointer;">
          <option value="All" <%= activeDifficulty === 'All' ? 'selected' : '' %>>All Levels</option>
          <option value="Junior" <%= activeDifficulty === 'Junior' ? 'selected' : '' %>>🌱 Junior</option>
          <option value="Mid" <%= activeDifficulty === 'Mid' ? 'selected' : '' %>>⚡ Mid</option>
          <option value="Senior" <%= activeDifficulty === 'Senior' ? 'selected' : '' %>>🚀 Senior</option>
        </select>
      </div>

      <button type="submit" class="btn" style="padding: 0.65rem 1.4rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
        Search
      </button>

      <% if (searchQuery || activeCategory !== 'All' || activeDifficulty !== 'All') { %>
        <a href="/faq" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-muted); padding: 0.65rem 1.1rem; font-size: 0.85rem; border-radius: var(--radius-lg); text-decoration: none;">
          Reset Filters ✕
        </a>
      <% } %>

    </div>

    <!-- Bottom Row: Category Tabs & View Mode Switcher -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-light); padding-top: 1.2rem; flex-wrap: wrap; gap: 1rem;">
      
      <!-- Category Filter Pills -->
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <a href="/faq?<%= activeDifficulty !== 'All' ? 'difficulty=' + activeDifficulty + '&' : '' %><%= searchQuery ? 'q=' + searchQuery : '' %>" class="faq-category-pill <%= activeCategory === 'All' ? 'active' : '' %>">
          🌐 All Topics
        </a>

        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <a href="/faq?category=<%= encodeURIComponent(cat) %><%= activeDifficulty !== 'All' ? '&difficulty=' + activeDifficulty : '' %><%= searchQuery ? '&q=' + searchQuery : '' %>" class="faq-category-pill <%= activeCategory === cat ? 'active' : '' %>">
              <%= cat %>
            </a>
          <% }) %>
        <% } %>
      </div>

      <!-- Interactive Mode Toggle (Accordion vs Flashcards) -->
      <div class="faq-mode-toggle">
        <button type="button" id="mode-accordion-btn" class="faq-mode-btn active">
          📜 Accordion List
        </button>
        <button type="button" id="mode-flashcard-btn" class="faq-mode-btn">
          🃏 Flashcard Mode
        </button>
      </div>

    </div>

  </form>

</div>

<!-- Q&A Main Container -->
<div style="max-width: 1240px; margin: 0 auto; padding-bottom: 3.5rem;">
  
  <!-- Mode 1: Accordion List View -->
  <div id="faq-accordion-view" style="display: flex; flex-direction: column; gap: 1.2rem;">
    
    <% if (questions && questions.length > 0) { %>
      <% questions.forEach((q, index) => { %>
        <details class="faq-card" <%= index === 0 ? 'open' : '' %>>
          
          <summary class="faq-card__summary">
            
            <div style="display: flex; flex-direction: column; gap: 0.55rem; flex: 1;">
              <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <span style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--text-dim);">Q<%= index + 1 %></span>

                <span class="tech-badge" style="font-size: 0.75rem; padding: 0.15rem 0.55rem; font-family: var(--font-mono); <%= q.difficulty === 'Senior' ? 'background: rgba(239, 68, 68, 0.18); color: #fca5a5; border-color: rgba(239, 68, 68, 0.3);' : (q.difficulty === 'Junior' ? 'background: rgba(16, 185, 129, 0.18); color: #6ee7b7; border-color: rgba(16, 185, 129, 0.3);' : 'background: rgba(129, 140, 248, 0.18); color: #a5b4fc; border-color: rgba(129, 140, 248, 0.3);') %>">
                  <%= q.difficulty === 'Senior' ? '🚀 Senior' : (q.difficulty === 'Junior' ? '🌱 Junior' : '⚡ Mid') %>
                </span>

                <span class="tech-badge" style="font-size: 0.75rem; padding: 0.15rem 0.55rem; background: var(--primary-indigo-light); color: var(--primary-indigo);">
                  <%= q.category %>
                </span>
              </div>

              <span style="line-height: 1.35; color: var(--text-main); font-size: 1.12rem;">
                ❓ <%= q.question %>
              </span>
            </div>

            <div class="faq-chevron">▾</div>
          </summary>

          <div class="faq-card__body article-content">
            <%- q.answerHtml %>
          </div>

          <!-- Community Answers Section (if present) -->
          <% if (q.communityAnswers && q.communityAnswers.length > 0) { %>
            <div class="faq-community-section">
              <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.9rem; font-family: var(--font-mono); display: flex; align-items: center; gap: 0.5rem;">
                💬 Community Answers &amp; Alternate Insights (<%= q.communityAnswers.length %>)
              </h4>
              <div>
                <% q.communityAnswers.forEach(ca => { %>
                  <div class="faq-community-card">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; flex-wrap: wrap; gap: 0.5rem;">
                      <div style="display: flex; align-items: center; gap: 0.6rem;">
                        <div class="faq-author-avatar">
                          <% if (ca.author && ca.author.avatarUrl) { %>
                            <img src="<%= ca.author.avatarUrl %>" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
                          <% } else { %>
                            <%= ca.author ? (ca.author.displayName || ca.author.username).charAt(0).toUpperCase() : 'D' %>
                          <% } %>
                        </div>
                        <div>
                          <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem;">
                            <%= ca.author ? (ca.author.displayName || ca.author.username) : 'Developer' %>
                          </div>
                          <div style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">Verified Contributor</div>
                        </div>
                      </div>
                      <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);"><%= new Date(ca.createdAt).toDateString() %></span>
                    </div>
                    <div class="article-content" style="font-size: 0.92rem; color: var(--text-body); line-height: 1.6;">
                      <%- ca.answerHtml %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- User Answer Submission Form -->
          <% if (currentUser) { %>
            <details style="margin-top: 1.2rem; padding-top: 0.8rem; border-top: 1px dashed var(--border-light);">
              <summary style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--primary-indigo); cursor: pointer; font-weight: 700; outline: none; display: flex; align-items: center; gap: 0.4rem;">
                ✏️ Submit your explanation / answer to this question
              </summary>
              <form action="/faq/<%= q.id %>/answer" method="POST" style="margin-top: 0.8rem; display: flex; flex-direction: column; gap: 0.8rem;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <textarea name="answer" rows="4" placeholder="Write your technical explanation, alternative approach, or code snippet example..." required style="width: 100%; padding: 0.85rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); background: var(--bg-surface); color: var(--text-main); font-family: var(--font-mono); font-size: 0.88rem; outline: none; resize: vertical;"></textarea>
                <div style="display: flex; justify-content: flex-end;">
                  <button type="submit" class="btn" style="padding: 0.5rem 1.2rem; font-size: 0.84rem; border-radius: var(--radius-lg); font-weight: 700;">
                    Submit Answer for Moderation
                  </button>
                </div>
              </form>
            </details>
          <% } %>

          <!-- Question Footer Bar (Upvote AJAX) -->
          <div style="margin-top: 1.4rem; padding-top: 1rem; border-top: 1px dashed var(--border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem;">
            <div style="font-size: 0.82rem; font-family: var(--font-mono); color: var(--text-muted);">
              Was this technical answer helpful?
            </div>

            <button type="button" class="btn faq-upvote-btn" data-id="<%= q.id %>" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); font-size: 0.82rem; padding: 0.4rem 0.95rem; border-radius: var(--radius-lg); font-weight: 700; transition: all 0.2s ease;">
              <span>👍 Helpful</span>
              <span class="upvote-count" id="upvote-count-<%= q.id %>" style="color: var(--primary-indigo); margin-left: 0.35rem;"><%= q.upvotesCount %></span>
            </button>
          </div>

        </details>
      <% }) %>
    <% } else { %>
      <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); border-radius: var(--radius-xl); padding: 4rem 2rem; text-align: center; color: var(--text-muted);">
        <div style="font-size: 2.5rem; margin-bottom: 0.8rem;">🔍</div>
        <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">No interview questions found</h3>
        <p style="font-size: 0.9rem; margin-bottom: 1.5rem;">Try adjusting your search query or category filter.</p>
        <a href="/faq" class="btn" style="font-size: 0.88rem; padding: 0.6rem 1.4rem;">Reset All Filters</a>
      </div>
    <% } %>

  </div>

  <!-- Mode 2: Flashcard Quiz Mode Container (Hidden by Default) -->
  <div id="faq-flashcard-view" style="display: none;">
    <% if (questions && questions.length > 0) { %>
      <div class="faq-flashcard">
        
        <!-- Progress Bar -->
        <div class="faq-flashcard__progress">
          <div id="flashcard-progress-bar" class="faq-flashcard__bar" style="width: <%= (1 / questions.length) * 100 %>%;"></div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted);">
          <span id="flashcard-counter" style="font-weight: 700; color: var(--text-main);">Question 1 of <%= questions.length %></span>
          <span id="flashcard-category" class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); font-size: 0.78rem;">Node.js Core</span>
        </div>

        <h2 id="flashcard-question" style="font-size: 1.55rem; font-weight: 800; color: var(--text-main); line-height: 1.35; margin-bottom: 2rem;">
          Question Prompt
        </h2>

        <button type="button" id="flashcard-reveal-btn" class="btn" style="padding: 0.8rem 2.2rem; font-size: 0.95rem; font-weight: 800; border-radius: var(--radius-lg); margin-bottom: 1.5rem; box-shadow: 0 4px 14px var(--primary-indigo-light);">
          💡 Reveal Model Answer
        </button>

        <div id="flashcard-answer-box" style="display: none; text-align: left; background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2rem; margin-top: 1.5rem; margin-bottom: 2rem; animation: fadeSlideUp 0.3s ease;" class="article-content">
          <!-- Dynamically populated answer -->
        </div>

        <!-- Flashcard Navigation Buttons -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; border-top: 1px solid var(--border-light); padding-top: 1.5rem; flex-wrap: wrap; gap: 0.8rem;">
          <button type="button" id="flashcard-prev-btn" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); font-size: 0.88rem; border-radius: var(--radius-lg); padding: 0.6rem 1.2rem;">
            &larr; Previous (Left)
          </button>
          
          <button type="button" id="flashcard-random-btn" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--primary-indigo); font-size: 0.88rem; border-radius: var(--radius-lg); padding: 0.6rem 1.2rem; font-weight: 700;">
            🎲 Random Card
          </button>

          <button type="button" id="flashcard-next-btn" class="btn" style="font-size: 0.88rem; border-radius: var(--radius-lg); padding: 0.6rem 1.2rem;">
            Next (Right) &rarr;
          </button>
        </div>

        <!-- Keyboard navigation hints -->
        <div style="margin-top: 1.2rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim);">
          ⌨️ Keyboard: <kbd style="background: var(--bg-subtle); padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid var(--border-light);">←</kbd> Previous • <kbd style="background: var(--bg-subtle); padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid var(--border-light);">Space</kbd> Reveal Answer • <kbd style="background: var(--bg-subtle); padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid var(--border-light);">→</kbd> Next
        </div>

      </div>
    <% } %>
  </div>

</div>

<!-- Flashcard Mode & Upvote Client-side Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Upvote AJAX Handler
    document.querySelectorAll('.faq-upvote-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const questionId = btn.getAttribute('data-id');
        const countSpan = document.getElementById(`upvote-count-${questionId}`);
        try {
          const res = await fetch(`/api/faq/${questionId}/upvote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          const data = await res.json();
          if (data.success && countSpan) {
            countSpan.textContent = data.upvotesCount;
            btn.style.borderColor = 'var(--primary-indigo)';
            btn.style.color = 'var(--primary-indigo)';
            btn.style.background = 'var(--primary-indigo-light)';
          }
        } catch (err) {
          console.error('Error upvoting question:', err);
        }
      });
    });

    // 2. View Mode Toggle (Accordion vs Flashcard)
    const accordionBtn = document.getElementById('mode-accordion-btn');
    const flashcardBtn = document.getElementById('mode-flashcard-btn');
    const accordionView = document.getElementById('faq-accordion-view');
    const flashcardView = document.getElementById('faq-flashcard-view');

    if (accordionBtn && flashcardBtn && accordionView && flashcardView) {
      accordionBtn.addEventListener('click', () => {
        accordionView.style.display = 'flex';
        flashcardView.style.display = 'none';
        
        accordionBtn.classList.add('active');
        flashcardBtn.classList.remove('active');
      });

      flashcardBtn.addEventListener('click', () => {
        accordionView.style.display = 'none';
        flashcardView.style.display = 'block';

        flashcardBtn.classList.add('active');
        accordionBtn.classList.remove('active');

        initFlashcards();
      });
    }

    // 3. Flashcard Quiz Controller
    const rawQuestions = <%- JSON.stringify(questions || []) %>;
    let currentIndex = 0;

    const counterSpan = document.getElementById('flashcard-counter');
    const categorySpan = document.getElementById('flashcard-category');
    const questionH2 = document.getElementById('flashcard-question');
    const revealBtn = document.getElementById('flashcard-reveal-btn');
    const answerBox = document.getElementById('flashcard-answer-box');
    const progressBar = document.getElementById('flashcard-progress-bar');
    const prevBtn = document.getElementById('flashcard-prev-btn');
    const nextBtn = document.getElementById('flashcard-next-btn');
    const randomBtn = document.getElementById('flashcard-random-btn');

    function initFlashcards() {
      if (!rawQuestions || rawQuestions.length === 0) return;
      showCard(currentIndex);
    }

    function showCard(idx) {
      if (idx < 0) idx = rawQuestions.length - 1;
      if (idx >= rawQuestions.length) idx = 0;
      currentIndex = idx;

      const q = rawQuestions[currentIndex];
      if (counterSpan) counterSpan.textContent = `Question ${currentIndex + 1} of ${rawQuestions.length}`;
      if (categorySpan) categorySpan.textContent = q.category || 'Core';
      if (questionH2) questionH2.textContent = q.question;

      if (progressBar) {
        const pct = ((currentIndex + 1) / rawQuestions.length) * 100;
        progressBar.style.width = `${pct}%`;
      }

      if (answerBox) {
        answerBox.innerHTML = q.answerHtml;
        answerBox.style.display = 'none';
      }

      if (revealBtn) revealBtn.style.display = 'inline-flex';

      // Re-trigger syntax highlighting for code snippets inside answer
      if (window.hljs && answerBox) {
        answerBox.querySelectorAll('pre code').forEach(el => window.hljs.highlightElement(el));
      }
    }

    if (revealBtn) {
      revealBtn.addEventListener('click', () => {
        if (answerBox) answerBox.style.display = 'block';
        revealBtn.style.display = 'none';
      });
    }

    if (prevBtn) prevBtn.addEventListener('click', () => showCard(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => showCard(currentIndex + 1));
    if (randomBtn) randomBtn.addEventListener('click', () => {
      const randIdx = Math.floor(Math.random() * rawQuestions.length);
      showCard(randIdx);
    });

    // Keyboard navigation support for Flashcards
    document.addEventListener('keydown', (e) => {
      if (flashcardView && flashcardView.style.display !== 'none') {
        if (e.key === 'ArrowLeft') showCard(currentIndex - 1);
        if (e.key === 'ArrowRight') showCard(currentIndex + 1);
        if (e.key === ' ' || e.code === 'Space') {
          e.preventDefault();
          if (answerBox && answerBox.style.display === 'none' && revealBtn) {
            answerBox.style.display = 'block';
            revealBtn.style.display = 'none';
          }
        }
      }
    });
  });
</script>
