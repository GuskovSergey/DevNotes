<div style="max-width: 1240px; margin: 0 auto; padding-bottom: 3.5rem;">
  
  <!-- Back Breadcrumb Navigation -->
  <div style="margin-bottom: 1.5rem;">
    <a href="/courses" style="display: inline-flex; align-items: center; gap: 0.49rem; color: var(--text-muted); font-size: 0.88rem; text-decoration: none; font-weight: 600; transition: color 0.2s;" onmouseover="this.style.color='var(--primary-indigo)'" onmouseout="this.style.color='var(--text-muted)'">
      &larr; Back to All Courses
    </a>
  </div>

  <!-- Course Hero Header Banner (Stitch Glassmorphic Design) -->
  <div style="background: radial-gradient(circle at 80% 20%, rgba(99, 102, 241, 0.25) 0%, rgba(15, 19, 28, 0) 65%), linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%); border-radius: var(--radius-xl); padding: 2.8rem 2.5rem; color: #ffffff; margin-bottom: 2.2rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); position: relative; overflow: hidden; border: 1px solid rgba(99, 102, 241, 0.3);">
    
    <div style="display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1.2rem; flex-wrap: wrap;">
      <span class="tech-badge" style="background: rgba(129, 140, 248, 0.2); color: #c0c1ff; border-color: rgba(129, 140, 248, 0.4); font-size: 0.8rem; padding: 0.25rem 0.8rem;">
        🎓 DevHub Knowledge Track
      </span>

      <span class="tech-badge" style="font-size: 0.78rem; padding: 0.25rem 0.75rem; font-family: var(--font-mono); <%= course.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.2); color: #fca5a5; border-color: rgba(239, 68, 68, 0.4);' : (course.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border-color: rgba(16, 185, 129, 0.4);' : 'background: rgba(129, 140, 248, 0.2); color: #a5b4fc; border-color: rgba(129, 140, 248, 0.4);') %>">
        <%= course.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (course.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
      </span>

      <span style="opacity: 0.75; font-size: 0.88rem; font-family: var(--font-mono);">⏱ <%= course.estimatedTime %></span>
      <span style="opacity: 0.4;">•</span>
      <span style="opacity: 0.75; font-size: 0.88rem; font-family: var(--font-mono);">📚 <%= course.lessonsCount %> Modules</span>
    </div>

    <h1 style="font-size: clamp(2rem, 3.8vw, 2.7rem); font-weight: 800; color: #ffffff; line-height: 1.2; margin-bottom: 1rem; letter-spacing: -0.02em;">
      <%= course.title %>
    </h1>

    <p style="font-size: 1.08rem; opacity: 0.9; max-width: 860px; line-height: 1.65; margin-bottom: 2rem;">
      <%= course.description %>
    </p>

    <!-- Author Profile & Enrollment Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.4rem; padding-top: 1.4rem; border-top: 1px solid rgba(255, 255, 255, 0.14);">
      <% if (course.author) { %>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 800; overflow: hidden; box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);">
            <% if (course.author.avatarUrl) { %>
              <img src="<%= course.author.avatarUrl %>" alt="Author" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
              <%= (course.author.displayName || course.author.username).charAt(0).toUpperCase() %>
            <% } %>
          </div>
          <div>
            <div style="font-size: 0.92rem; font-weight: 700; color: #ffffff;"><%= course.author.displayName || course.author.username %></div>
            <div style="font-size: 0.76rem; opacity: 0.7; font-family: var(--font-mono);">Course Author &amp; Maintainer</div>
          </div>
        </div>
      <% } %>

      <% if (course.lessons && course.lessons.length > 0) { %>
        <a href="/courses/<%= course.slug %>/lessons/<%= course.lessons[0].slug %>" class="btn" style="background: #ffffff; color: var(--primary-indigo); border: none; font-weight: 800; padding: 0.75rem 1.8rem; font-size: 0.98rem; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);">
          <span><%= (currentUser && course.completedLessonsCount > 0) ? 'Continue Track &rarr;' : 'Start Track &rarr;' %></span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Course Content Grid (Overview & Syllabus) -->
  <div style="display: grid; grid-template-columns: 1fr 340px; gap: 2.2rem; align-items: flex-start;" class="home-layout">
    
    <!-- Left Main Column: Syllabus & Markdown Overview -->
    <div style="min-width: 0;">
      
      <!-- Key Takeaways & Objectives Banner -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem 2.2rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0 0 1rem 0; display: flex; align-items: center; gap: 0.5rem;">
          🎯 Key Skills You Will Master
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.8rem; font-size: 0.92rem; color: var(--text-body);">
          <div style="display: flex; align-items: flex-start; gap: 0.5rem;">
            <span style="color: #10b981; font-weight: 800;">✓</span>
            <span>Production Express MVC Architecture &amp; Clean Layers</span>
          </div>
          <div style="display: flex; align-items: flex-start; gap: 0.5rem;">
            <span style="color: #10b981; font-weight: 800;">✓</span>
            <span>SQLite &amp; Sequelize High-Performance Tuning</span>
          </div>
          <div style="display: flex; align-items: flex-start; gap: 0.5rem;">
            <span style="color: #10b981; font-weight: 800;">✓</span>
            <span>Pino Async JSON Logging &amp; Performance Metrics</span>
          </div>
          <div style="display: flex; align-items: flex-start; gap: 0.5rem;">
            <span style="color: #10b981; font-weight: 800;">✓</span>
            <span>Security Best Practices, CSRF &amp; Input Sanitation</span>
          </div>
        </div>
      </div>

      <!-- Detailed Course Overview Body (if present) -->
      <% if (course.bodyHtml) { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);" class="article-content">
          <%- course.bodyHtml %>
        </div>
      <% } %>

      <!-- Table of Contents / Syllabus Modules -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.6rem; flex-wrap: wrap; gap: 0.8rem;">
          <div>
            <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin: 0;">
              📚 Course Syllabus &amp; Modules
            </h2>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Step-by-step text lessons and code examples.</p>
          </div>

          <span class="tech-badge" style="font-size: 0.82rem; font-family: var(--font-mono); padding: 0.25rem 0.75rem;">
            <%= course.lessonsCount %> Module<%= course.lessonsCount !== 1 ? 's' : '' %>
          </span>
        </div>

        <% if (course.lessons && course.lessons.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            <% course.lessons.forEach((lesson, index) => { %>
              <a href="/courses/<%= course.slug %>/lessons/<%= lesson.slug %>" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-decoration: none; padding: 1.2rem 1.5rem; border-radius: var(--radius-lg); background: var(--bg-subtle); border: 1px solid var(--border-light); transition: all 0.2s ease;" onmouseover="this.style.borderColor='var(--border-accent)'; this.style.transform='translateX(4px)';" onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateX(0)';">
                
                <div style="display: flex; align-items: center; gap: 1.1rem; min-width: 0;">
                  <div style="width: 36px; height: 36px; border-radius: 50%; background: <%= lesson.isCompleted ? '#10b981' : 'var(--primary-indigo-light)' %>; color: <%= lesson.isCompleted ? '#ffffff' : 'var(--primary-indigo)' %>; display: flex; align-items: center; justify-content: center; font-size: 0.88rem; font-weight: 800; font-family: var(--font-mono); flex-shrink: 0; box-shadow: var(--shadow-sm);">
                    <%= lesson.isCompleted ? '✓' : (index + 1) %>
                  </div>

                  <div style="min-width: 0;">
                    <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.2rem 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <%= lesson.title %>
                    </h3>
                    <div style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
                      ⏱ <%= lesson.readingTime %>
                    </div>
                  </div>
                </div>

                <span style="font-size: 0.88rem; color: var(--primary-indigo); font-weight: 700; flex-shrink: 0;">
                  Read Lesson &rarr;
                </span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 2.5rem; border-radius: var(--radius-lg); text-align: center; color: var(--text-muted);">
            No lessons published in this course track yet.
          </div>
        <% } %>

      </div>

    </div>

    <!-- Right Sidebar Widget Band -->
    <aside style="display: flex; flex-direction: column; gap: 1.6rem; position: sticky; top: 90px;">
      
      <!-- Progress Widget (if logged in) -->
      <% if (currentUser) { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.8rem 0;">
            📊 Your Learning Progress
          </h3>
          
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.6rem;">
            <span>Completed</span>
            <span style="font-weight: 800; color: var(--primary-indigo);"><%= course.completedLessonsCount %> / <%= course.lessonsCount %> (<%= course.progressPercent %>%)</span>
          </div>

          <div style="width: 100%; height: 10px; background: var(--bg-subtle); border-radius: var(--radius-full); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light);">
            <div style="width: <%= course.progressPercent %>%; height: 100%; background: linear-gradient(90deg, var(--primary-indigo) 0%, #10b981 100%); transition: width 0.4s ease;"></div>
          </div>

          <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0; line-height: 1.45;">
            Completed lessons are automatically saved to your developer account.
          </p>
        </div>
      <% } else { %>
        <div style="background: linear-gradient(135deg, var(--bg-surface) 0%, var(--primary-indigo-light) 100%); border: 1px solid var(--border-accent); border-radius: var(--radius-xl); padding: 1.8rem;">
          <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.4rem 0;">
            Track Your Progress
          </h3>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.2rem; line-height: 1.5;">
            Sign in to track completed lessons and post comments in the developer community!
          </p>
          <a href="/auth" class="btn" style="width: 100%; justify-content: center; font-size: 0.9rem; font-weight: 700; border-radius: var(--radius-lg);">
            Sign In to Track Progress
          </a>
        </div>
      <% } %>

      <!-- Tech Stack & Prerequisites Card -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem; box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0 0 1rem 0;">
          💡 Track Prerequisites
        </h3>

        <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; color: var(--text-body);">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>🟢</span>
            <span>Basic JavaScript &amp; Node.js</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>⚡</span>
            <span>Express.js Framework Fundamentals</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>🗄️</span>
            <span>SQL &amp; Relational Database Basics</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>💻</span>
            <span>Command Line / Terminal Basics</span>
          </div>
        </div>
      </div>

    </aside>

  </div>

</div>
