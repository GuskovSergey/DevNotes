<div style="max-width: 1240px; margin: 0 auto; padding-bottom: 3.5rem;">
  
  <!-- Back Breadcrumb Bar -->
  <div style="margin-bottom: 1.5rem;">
    <a href="/courses" style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-muted); font-size: 0.9rem; text-decoration: none; font-weight: 600;">
      &larr; Back to All Courses
    </a>
  </div>

  <!-- Course Hero Header Banner -->
  <div style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%); border-radius: var(--radius-xl); padding: 2.5rem; color: #ffffff; margin-bottom: 2.2rem; box-shadow: var(--shadow-sm); position: relative; overflow: hidden;">
    
    <div style="display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;">
      <span class="tech-badge" style="background: rgba(129, 140, 248, 0.2); color: #818cf8; border-color: rgba(129, 140, 248, 0.4); font-size: 0.8rem; padding: 0.25rem 0.75rem;">
        🎓 DevHub Course
      </span>

      <span class="tech-badge" style="font-size: 0.78rem; padding: 0.25rem 0.75rem; font-family: var(--font-mono); <%= course.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.2); color: #fca5a5; border-color: rgba(239, 68, 68, 0.4);' : (course.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border-color: rgba(16, 185, 129, 0.4);' : 'background: rgba(129, 140, 248, 0.2); color: #a5b4fc; border-color: rgba(129, 140, 248, 0.4);') %>">
        <%= course.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (course.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
      </span>

      <span style="opacity: 0.7; font-size: 0.88rem; font-family: var(--font-mono);">⏱ <%= course.estimatedTime %></span>
      <span style="opacity: 0.5;">•</span>
      <span style="opacity: 0.7; font-size: 0.88rem; font-family: var(--font-mono);">📚 <%= course.lessonsCount %> Modules</span>
    </div>

    <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; color: #ffffff; line-height: 1.25; margin-bottom: 0.8rem;">
      <%= course.title %>
    </h1>

    <p style="font-size: 1.05rem; opacity: 0.9; max-width: 820px; line-height: 1.6; margin-bottom: 1.8rem;">
      <%= course.description %>
    </p>

    <!-- Author & Action Row -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.2rem; padding-top: 1.2rem; border-top: 1px solid rgba(255, 255, 255, 0.12);">
      <% if (course.author) { %>
        <div style="display: flex; align-items: center; gap: 0.65rem;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 800; overflow: hidden;">
            <% if (course.author.avatarUrl) { %>
              <img src="<%= course.author.avatarUrl %>" alt="Author" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
              <%= (course.author.displayName || course.author.username).charAt(0).toUpperCase() %>
            <% } %>
          </div>
          <div>
            <div style="font-size: 0.88rem; font-weight: 700; color: #ffffff;"><%= course.author.displayName || course.author.username %></div>
            <div style="font-size: 0.75rem; opacity: 0.7; font-family: var(--font-mono);">Author &amp; Maintainer</div>
          </div>
        </div>
      <% } %>

      <% if (course.lessons && course.lessons.length > 0) { %>
        <a href="/courses/<%= course.slug %>/lessons/<%= course.lessons[0].slug %>" class="btn" style="background: #ffffff; color: var(--primary-indigo); border: none; font-weight: 800; padding: 0.7rem 1.6rem; font-size: 0.95rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-md);">
          <span>Start Learning Track &rarr;</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Course Content Grid (Syllabus & Overview) -->
  <div style="display: grid; grid-template-columns: 1fr 340px; gap: 2.2rem; align-items: flex-start;" class="home-layout">
    
    <!-- Left Main Column: Syllabus / Table of Contents -->
    <div>
      
      <!-- Detailed Course Overview Body (if present) -->
      <% if (course.bodyHtml) { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);" class="article-content">
          <%- course.bodyHtml %>
        </div>
      <% } %>

      <!-- Table of Contents / Syllabus Modules -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin: 0;">
            📚 Course Syllabus
          </h2>
          <span style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-muted);">
            <%= course.lessonsCount %> Modules
          </span>
        </div>

        <% if (course.lessons && course.lessons.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.8rem;">
            <% course.lessons.forEach((lesson, index) => { %>
              <a href="/courses/<%= course.slug %>/lessons/<%= lesson.slug %>" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-decoration: none; padding: 1.1rem 1.4rem; border-radius: var(--radius-lg); background: var(--bg-subtle); border: 1px solid var(--border-light); transition: all 0.2s ease;" onmouseover="this.style.borderColor='var(--border-accent)'; this.style.transform='translateX(4px)';" onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateX(0)';">
                
                <div style="display: flex; align-items: center; gap: 1rem; min-width: 0;">
                  <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= lesson.isCompleted ? '#10b981' : 'var(--primary-indigo-light)' %>; color: <%= lesson.isCompleted ? '#ffffff' : 'var(--primary-indigo)' %>; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 800; font-family: var(--font-mono); flex-shrink: 0;">
                    <%= lesson.isCompleted ? '✓' : (index + 1) %>
                  </div>

                  <div style="min-width: 0;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.2rem 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <%= lesson.title %>
                    </h3>
                    <div style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
                      ⏱ <%= lesson.readingTime %>
                    </div>
                  </div>
                </div>

                <span style="font-size: 0.85rem; color: var(--primary-indigo); font-weight: 700; flex-shrink: 0;">
                  Read &rarr;
                </span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted); margin: 0;">No lessons published in this course yet.</p>
        <% } %>

      </div>

    </div>

    <!-- Right Sidebar Widget Band -->
    <aside style="display: flex; flex-direction: column; gap: 1.5rem;">
      
      <!-- Progress Widget (if logged in) -->
      <% if (currentUser) { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.6rem; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.8rem 0;">
            Your Learning Progress
          </h3>
          
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.5rem;">
            <span>Completed</span>
            <span style="font-weight: 700; color: var(--primary-indigo);"><%= course.completedLessonsCount %> / <%= course.lessonsCount %> (<%= course.progressPercent %>%)</span>
          </div>

          <div style="width: 100%; height: 8px; background: var(--bg-subtle); border-radius: var(--radius-full); overflow: hidden; margin-bottom: 1rem;">
            <div style="width: <%= course.progressPercent %>%; height: 100%; background: linear-gradient(90deg, var(--primary-indigo) 0%, #10b981 100%);"></div>
          </div>

          <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0; line-height: 1.4;">
            Completed lessons are saved automatically to your profile.
          </p>
        </div>
      <% } else { %>
        <div style="background: linear-gradient(135deg, var(--bg-surface) 0%, var(--primary-indigo-light) 100%); border: 1px solid var(--border-accent); border-radius: var(--radius-xl); padding: 1.6rem;">
          <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.4rem 0;">
            Save Your Learning Progress
          </h3>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem; line-height: 1.4;">
            Sign in to track completed lessons and unlock interactive discussion features!
          </p>
          <a href="/auth" class="btn" style="width: 100%; justify-content: center; font-size: 0.88rem;">
            Sign In to Track Progress
          </a>
        </div>
      <% } %>

      <!-- Course Highlights Card -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.6rem; box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0 0 1rem 0;">
          💡 Course Features
        </h3>

        <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; color: var(--text-body);">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>📖</span>
            <span>100% Text &amp; Code Content</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>⏱</span>
            <span>Self-Paced Architecture Track</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>💬</span>
            <span>Community Discussion per Lesson</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span>💻</span>
            <span>IntelliJ Syntax Highlighted Code</span>
          </div>
        </div>
      </div>

    </aside>

  </div>

</div>
