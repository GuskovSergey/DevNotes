<header class="header">
  <!-- Brand Logo with Code Badge -->
  <a href="/" class="header__logo">
    <span class="header__logo-badge">&lt;/&gt;</span>
    <span class="header__logo-text">DevHub</span>
  </a>

  <!-- Centered Pill Navigation -->
  <nav class="header__nav">
    <ul>
      <li>
        <a href="/" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/') ? 'active' : '' %>">
          <span>Home</span>
        </a>
      </li>
      <li>
        <a href="/about" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/about') ? 'active' : '' %>">
          <span>About</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Right Actions: Search, Theme Toggle & User Auth Navigation -->
  <div class="header__right-actions">
    <button class="searchBtn" aria-expanded="false">
      <svg width="15" height="15" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7.79167 13.4583C10.9213 13.4583 13.4583 10.9213 13.4583 7.79167C13.4583 4.66205 10.9213 2.125 7.79167 2.125C4.66205 2.125 2.125 4.66205 2.125 7.79167C2.125 10.9213 4.66205 13.4583 7.79167 13.4583Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.875 14.875L11.7938 11.7938" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Search</span>
      <kbd class="shortcut-badge" style="margin-right: 0; font-size: 0.65rem;">⌘K</kbd>
    </button>

    <!-- Theme Toggle Switcher -->
    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Theme">
      🌙
    </button>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <!-- Logged In User Navigation Pill -->
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <a href="/my/posts/new" class="btn" style="padding: 0.45rem 0.9rem; font-size: 0.85rem; border-radius: var(--radius-full);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.2rem;">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Write
        </a>

        <a href="/my/bookmarks" class="admin-link-btn" style="padding: 0.45rem 0.75rem;" title="Saved Bookmarks">
          🔖
        </a>

        <a href="/account" class="admin-link-btn" style="display: inline-flex; align-items: center; gap: 0.55rem; background: var(--primary-indigo-light); border-color: var(--border-accent); color: var(--primary-indigo); font-weight: 600;">
          <span style="width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800;">
            <%= (currentUser.displayName || currentUser.username).charAt(0).toUpperCase() %>
          </span>
          <span><%= currentUser.displayName || currentUser.username %></span>
        </a>

        <% if (currentUser.role === 'admin') { %>
          <a href="/dashboard" class="admin-link-btn" style="padding: 0.45rem 0.75rem;" title="Admin Dashboard">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </a>
        <% } %>

        <a href="/auth/logout" class="admin-link-btn" style="padding: 0.45rem 0.75rem; background: #fef2f2; border-color: #fecaca; color: #dc2626;" title="Sign Out">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    <% } else { %>
      <!-- Guest User Action Buttons -->
      <a href="/auth" class="admin-link-btn" style="display: inline-flex; align-items: center; gap: 0.4rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        <span>Sign In</span>
      </a>
      <a href="/auth?tab=register" class="btn" style="padding: 0.45rem 1.1rem; font-size: 0.85rem; border-radius: var(--radius-full);">
        Register
      </a>
    <% } %>
  </div>
</header>