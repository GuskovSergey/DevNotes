<header class="header">
  <!-- Brand Logo with Gradient Code Badge -->
  <a href="/" class="header__logo">
    <span class="header__logo-badge">&lt;/dev&gt;</span>
    <span class="header__logo-text">DevHub</span>
  </a>

  <!-- Navigation Links -->
  <nav class="header__nav">
    <ul>
      <li>
        <a href="/" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/') ? 'active' : '' %>">
          <span>Home</span>
        </a>
      </li>

      <!-- Categories Custom Dropdown -->
      <li class="header-dropdown left-align" id="categories-dropdown">
        <button type="button" class="nav-dropdown-btn dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          <span>Categories</span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu">
          <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <a href="/?category=<%= cat.slug %>" class="dropdown-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                <span><%= cat.name %></span>
              </a>
            <% }) %>
          <% } else { %>
            <a href="/?category=development" class="dropdown-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              <span>Development</span>
            </a>
          <% } %>
        </div>
      </li>

      <li>
        <a href="/about" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/about') ? 'active' : '' %>">
          <span>About</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Right Actions: Search, Theme Toggle & User Auth Dropdown -->
  <div class="header__right-actions">
    
    <!-- Command Palette Style Search Button -->
    <button class="searchBtn" aria-expanded="false" title="Search articles (⌘K)">
      <svg width="15" height="15" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7.79167 13.4583C10.9213 13.4583 13.4583 10.9213 13.4583 7.79167C13.4583 4.66205 10.9213 2.125 7.79167 2.125C4.66205 2.125 4.66205 13.4583 7.79167 13.4583Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.875 14.875L11.7938 11.7938" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Search...</span>
      <kbd class="shortcut-badge">⌘K</kbd>
    </button>

    <!-- Theme Toggle Switcher Button -->
    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Light/Dark Theme">
      🌙
    </button>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <!-- Notifications Bell Dropdown / Modal Popover -->
      <div class="header-dropdown" id="notifications-dropdown">
        <button type="button" class="header-notif-btn dropdown-trigger" aria-expanded="false" aria-haspopup="true" title="Notifications" aria-label="Notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
            <span class="header-notif-badge" id="notif-badge"><%= unreadNotificationsCount %></span>
          <% } %>
        </button>

        <div class="dropdown-menu notif-popover-menu">
          <div class="notif-popover-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">Notifications</span>
              <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
                <span class="tech-badge" id="notif-popover-badge" style="font-size: 0.7rem; padding: 0.1rem 0.4rem; background: #ef4444; color: white;"><%= unreadNotificationsCount %> unread</span>
              <% } %>
            </div>
            <button id="mark-all-read-btn" type="button" style="background: none; border: none; color: var(--primary-indigo); font-size: 0.78rem; font-weight: 600; cursor: pointer; padding: 0;">Mark all read</button>
          </div>

          <div class="notif-popover-body" id="notif-popover-list">
            <div style="padding: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.85rem;">Loading notifications...</div>
          </div>

          <div class="notif-popover-footer">
            <a href="/my/notifications" style="color: var(--primary-indigo); font-size: 0.82rem; font-weight: 600; text-decoration: none;">View all notifications &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Logged In User Profile Custom Dropdown -->
      <div class="header-dropdown" id="user-profile-dropdown">
        <button type="button" class="admin-link-btn dropdown-trigger" style="display: inline-flex; align-items: center; gap: 0.55rem; background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-main); font-weight: 600; padding: 0.3rem 0.75rem 0.3rem 0.35rem; border-radius: var(--radius-full);" aria-expanded="false" aria-haspopup="true">
          <span style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; overflow: hidden; flex-shrink: 0;">
            <% if (currentUser.avatarUrl) { %>
              <img src="<%= currentUser.avatarUrl %>" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
              <%= (currentUser.displayName || currentUser.username).charAt(0).toUpperCase() %>
            <% } %>
          </span>
          <span style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.9rem;"><%= currentUser.displayName || currentUser.username %></span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="dropdown-menu">
          <!-- User Details Banner -->
          <div class="dropdown-header-info">
            <div class="dropdown-header-name"><%= currentUser.displayName || currentUser.username %></div>
            <div class="dropdown-header-email">@<%= currentUser.username %></div>
            <div style="margin-top: 0.35rem;">
              <% if (currentUser.role === 'admin') { %>
                <span class="tech-badge" style="font-size: 0.68rem; padding: 0.1rem 0.45rem; background: #fffbe6; color: #d46b08; border-color: #ffe58f;">🛡️ Administrator</span>
              <% } else { %>
                <span class="tech-badge" style="font-size: 0.68rem; padding: 0.1rem 0.45rem; background: var(--primary-indigo-light); color: var(--primary-indigo);">⚡ Developer</span>
              <% } %>
            </div>
          </div>

          <div class="dropdown-divider"></div>

          <a href="/account" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>My Cabinet</span>
          </a>

          <a href="/my/posts/new" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            <span>Write Article</span>
          </a>

          <a href="/my/bookmarks" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            <span>Bookmarks</span>
          </a>

          <a href="/my/likes" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span>Liked Articles</span>
          </a>

          <a href="/account/edit" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Settings</span>
          </a>

          <% if (currentUser.role === 'admin') { %>
            <div class="dropdown-divider"></div>
            <a href="/dashboard" class="dropdown-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              <span>Admin Dashboard</span>
            </a>
          <% } %>

          <div class="dropdown-divider"></div>

          <a href="/auth/logout" class="dropdown-item dropdown-item--danger">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Sign Out</span>
          </a>
        </div>
      </div>

    <% } else { %>
      <!-- Guest User Action Buttons -->
      <a href="/auth" class="admin-link-btn" style="display: inline-flex; align-items: center; gap: 0.4rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        <span>Sign In</span>
      </a>
      <a href="/auth?tab=register" class="btn" style="padding: 0.45rem 1.1rem; font-size: 0.85rem; border-radius: var(--radius-full);">
        Register
      </a>
    <% } %>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dropdown Component Logic
    const dropdowns = document.querySelectorAll('.header-dropdown');

    dropdowns.forEach(dropdown => {
      const trigger = dropdown.querySelector('.dropdown-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdown.classList.contains('open');

        // Close all other open dropdowns
        dropdowns.forEach(d => {
          if (d !== dropdown) {
            d.classList.remove('open');
            const trig = d.querySelector('.dropdown-trigger');
            if (trig) trig.setAttribute('aria-expanded', 'false');
          }
        });

        dropdown.classList.toggle('open', !isOpen);
        trigger.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
      });
    });

    // Notifications Popover AJAX Logic
    const notifDropdown = document.getElementById('notifications-dropdown');
    const notifList = document.getElementById('notif-popover-list');
    const markAllBtn = document.getElementById('mark-all-read-btn');
    const notifBadge = document.getElementById('notif-badge');
    const notifPopoverBadge = document.getElementById('notif-popover-badge');

    async function loadNotifications() {
      if (!notifList) return;
      try {
        const res = await fetch('/api/notifications');
        const data = await res.json();
        if (data.success) {
          renderNotifications(data.notifications);
        }
      } catch (err) {
        if (notifList) notifList.innerHTML = '<div style="padding: 1.2rem; text-align: center; color: var(--text-muted);">Failed to load notifications</div>';
      }
    }

    function renderNotifications(items) {
      if (!items || items.length === 0) {
        notifList.innerHTML = '<div style="padding: 2rem 1.2rem; text-align: center; color: var(--text-muted); font-size: 0.88rem;">No notifications yet 🔔</div>';
        return;
      }
      notifList.innerHTML = items.map(n => `
        <a href="${n.link}" class="notif-item ${!n.isRead ? 'notif-item--unread' : ''}">
          <div class="notif-item__icon" style="${n.type === 'comment' ? 'background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo);' : (n.type === 'reply' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981;' : (n.type === 'moderation_approved' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981;' : 'background: rgba(239, 68, 68, 0.15); color: #dc2626;'))}">
            ${n.type === 'comment' ? '💬' : (n.type === 'reply' ? '↩️' : (n.type === 'moderation_approved' ? '✅' : (n.type === 'moderation_rejected' ? '⚠️' : '🔔')))}
          </div>
          <div style="flex: 1; min-width: 0;">
            <div style="font-size: 0.88rem; font-weight: ${!n.isRead ? '700' : '500'}; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${n.message}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.2rem;">${n.createdAtFormatted}</div>
          </div>
        </a>
      `).join('');
    }

    if (notifDropdown) {
      const trig = notifDropdown.querySelector('.dropdown-trigger');
      if (trig) {
        trig.addEventListener('click', () => {
          if (notifDropdown.classList.contains('open')) {
            loadNotifications();
          }
        });
      }
    }

    if (markAllBtn) {
      markAllBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        try {
          const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
          await fetch('/api/notifications/read-all', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrf
            }
          });
          if (notifBadge) notifBadge.style.display = 'none';
          if (notifPopoverBadge) notifPopoverBadge.style.display = 'none';
          loadNotifications();
        } catch (err) {}
      });
    }

    // Close dropdowns on outside click or ESC key
    document.addEventListener('click', () => {
      dropdowns.forEach(d => {
        d.classList.remove('open');
        const trig = d.querySelector('.dropdown-trigger');
        if (trig) trig.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdowns.forEach(d => {
          d.classList.remove('open');
          const trig = d.querySelector('.dropdown-trigger');
          if (trig) trig.setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>