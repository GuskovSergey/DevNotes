<header class="header">
  <!-- Brand Logo with Knowledge Book & Code SVG Emblem -->
  <a href="/" class="header__logo" title="DevHub — Единая база знаний">
    <div class="header__logo-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        <path d="M9 9.5l-2 2 2 2"></path>
        <path d="M15 9.5l2 2-2 2"></path>
      </svg>
    </div>
    <div class="header__logo-brand">
      <span class="header__logo-text">Dev<span class="header__logo-accent">Hub</span></span>
      <span class="header__logo-tag">База знаний</span>
    </div>
  </a>

  <!-- Navigation Links -->
  <nav class="header__nav">
    <ul>
      <li>
        <a href="/" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/') ? 'active' : '' %>">
          <span>🏠 Главная</span>
        </a>
      </li>
      <li>
        <a href="/posts" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/posts') ? 'active' : '' %>">
          <span>📝 Статьи</span>
        </a>
      </li>
      <li>
        <a href="/courses" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/courses') ? 'active' : '' %>">
          <span>📚 Курсы</span>
        </a>
      </li>
      <li>
        <a href="/faq" class="<%= (typeof currentRoute !== 'undefined' && currentRoute === '/faq') ? 'active' : '' %>">
          <span>💡 Вопросы FAQ</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Right Actions: Search, Theme Toggle & User Auth Dropdown -->
  <div class="header__right-actions">
    
    <!-- Command Palette Style Search Button (Icon Only Capsule - UNCHANGED) -->
    <button class="searchBtn searchBtn--icon-only" aria-expanded="false" title="Поиск статей и материалов (⌘K)" aria-label="Поиск по базе знаний (⌘K)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>

    <!-- Theme Toggle Switcher Button -->
    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Переключить тему" title="Переключить тему (Светлая / Тёмная)">
      🌙
    </button>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <!-- Notifications Bell Dropdown / Modal Popover -->
      <div class="header-dropdown" id="notifications-dropdown">
        <button type="button" class="header-notif-btn dropdown-trigger" aria-expanded="false" aria-haspopup="true" title="Уведомления" aria-label="Уведомления">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
            <span class="header-notif-badge" id="notif-badge"><%= unreadNotificationsCount %></span>
          <% } %>
        </button>

        <div class="dropdown-menu notif-popover-menu">
          <div class="notif-popover-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">Уведомления</span>
              <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
                <span class="tech-badge" id="notif-popover-badge" style="font-size: 0.7rem; padding: 0.1rem 0.4rem; background: #ef4444; color: white;"><%= unreadNotificationsCount %> новых</span>
              <% } %>
            </div>
            <button id="mark-all-read-btn" type="button" style="background: none; border: none; color: var(--primary-indigo); font-size: 0.78rem; font-weight: 600; cursor: pointer; padding: 0;">Прочитать все</button>
          </div>

          <div class="notif-popover-body" id="notif-popover-list">
            <div style="padding: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.85rem;">Загрузка уведомлений...</div>
          </div>

          <div class="notif-popover-footer">
            <a href="/my/notifications" style="color: var(--primary-indigo); font-size: 0.82rem; font-weight: 600; text-decoration: none;">Все уведомления &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Logged In User Profile Custom Dropdown -->
      <div class="header-dropdown" id="user-profile-dropdown">
        <button type="button" class="admin-link-btn dropdown-trigger" style="display: inline-flex; align-items: center; gap: 0.55rem; height: 40px; background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-main); font-weight: 600; padding: 0 0.85rem 0 0.35rem; border-radius: var(--radius-full);" aria-expanded="false" aria-haspopup="true">
          <span style="width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; font-weight: 800; overflow: hidden; flex-shrink: 0;">
            <% if (currentUser.avatarUrl) { %>
              <img src="<%= currentUser.avatarUrl %>" alt="Аватар" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
              <%= (currentUser.displayName || currentUser.username).charAt(0).toUpperCase() %>
            <% } %>
          </span>
          <span style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.9rem;"><%= currentUser.displayName || currentUser.username %></span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="dropdown-menu">
          <!-- User Details Banner -->
          <div class="dropdown-header-info">
            <div class="dropdown-header-name"><%= currentUser.displayName || currentUser.username %></div>
            <div class="dropdown-header-email">@<%= currentUser.username %></div>
            <div style="margin-top: 0.35rem;">
              <% if (currentUser.role === 'admin') { %>
                <span class="tech-badge" style="font-size: 0.68rem; padding: 0.1rem 0.45rem; background: #fffbe6; color: #d46b08; border-color: #ffe58f;">🛡️ Администратор</span>
              <% } else { %>
                <span class="tech-badge" style="font-size: 0.68rem; padding: 0.1rem 0.45rem; background: var(--primary-indigo-light); color: var(--primary-indigo);">⚡ Разработчик</span>
              <% } %>
            </div>
          </div>

          <div class="dropdown-divider"></div>

          <a href="/account" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>Личный кабинет</span>
          </a>

          <a href="/my/bookmarks" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            <span>Закладки</span>
          </a>

          <a href="/account/edit" class="dropdown-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Настройки</span>
          </a>

          <div class="dropdown-divider"></div>

          <a href="/auth/logout" class="dropdown-item dropdown-item--danger">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Выйти</span>
          </a>
        </div>
      </div>

    <% } else { %>
      <!-- Guest User Action Icon Buttons (UNCHANGED as requested) -->
      <a href="/auth" class="header-icon-btn header-icon-btn--signin" title="Войти" aria-label="Войти">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
      </a>
      <a href="/auth?tab=register" class="header-icon-btn header-icon-btn--register" title="Регистрация" aria-label="Создать аккаунт">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="20" y1="8" x2="20" y2="14"></line>
          <line x1="17" y1="11" x2="23" y2="11"></line>
        </svg>
      </a>
    <% } %>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dropdown Component Logic
    const dropdowns = document.querySelectorAll('.header-dropdown');

    dropdowns.forEach(dropdown => {
      const trigger = dropdown.querySelector('.dropdown-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdown.classList.contains('open');

        // Close all other open dropdowns
        dropdowns.forEach(d => {
          if (d !== dropdown) {
            d.classList.remove('open');
            const trig = d.querySelector('.dropdown-trigger');
            if (trig) trig.setAttribute('aria-expanded', 'false');
          }
        });

        dropdown.classList.toggle('open', !isOpen);
        trigger.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
      });
    });

    // Notifications Popover AJAX Logic
    const notifDropdown = document.getElementById('notifications-dropdown');
    const notifList = document.getElementById('notif-popover-list');
    const markAllBtn = document.getElementById('mark-all-read-btn');
    const notifBadge = document.getElementById('notif-badge');
    const notifPopoverBadge = document.getElementById('notif-popover-badge');

    async function loadNotifications() {
      if (!notifList) return;
      try {
        const res = await fetch('/api/notifications');
        const data = await res.json();
        if (data.success) {
          renderNotifications(data.notifications);
        }
      } catch (err) {
        if (notifList) notifList.innerHTML = '<div style="padding: 1.2rem; text-align: center; color: var(--text-muted);">Не удалось загрузить уведомления</div>';
      }
    }

    function renderNotifications(items) {
      if (!items || items.length === 0) {
        notifList.innerHTML = '<div style="padding: 2rem 1.2rem; text-align: center; color: var(--text-muted); font-size: 0.88rem;">Уведомлений пока нет 🔔</div>';
        return;
      }
      notifList.innerHTML = items.map(n => `
        <a href="${n.link}" class="notif-item ${!n.isRead ? 'notif-item--unread' : ''}">
          <div class="notif-item__icon" style="${n.type === 'comment' ? 'background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo);' : (n.type === 'reply' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981;' : (n.type === 'moderation_approved' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981;' : 'background: rgba(239, 68, 68, 0.15); color: #dc2626;'))}">
            ${n.type === 'comment' ? '💬' : (n.type === 'reply' ? '↩️' : (n.type === 'moderation_approved' ? '✅' : (n.type === 'moderation_rejected' ? '⚠️' : '🔔')))}
          </div>
          <div style="flex: 1; min-width: 0;">
            <div style="font-size: 0.88rem; font-weight: ${!n.isRead ? '700' : '500'}; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${n.message}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.2rem;">${n.createdAtFormatted}</div>
          </div>
        </a>
      `).join('');
    }

    if (notifDropdown) {
      const trig = notifDropdown.querySelector('.dropdown-trigger');
      if (trig) {
        trig.addEventListener('click', () => {
          if (notifDropdown.classList.contains('open')) {
            loadNotifications();
          }
        });
      }
    }

    if (markAllBtn) {
      markAllBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        try {
          const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
          await fetch('/api/notifications/read-all', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrf
            }
          });
          if (notifBadge) notifBadge.style.display = 'none';
          if (notifPopoverBadge) notifPopoverBadge.style.display = 'none';
          loadNotifications();
        } catch (err) {}
      });
    }

    // Close dropdowns on outside click or ESC key
    document.addEventListener('click', () => {
      dropdowns.forEach(d => {
        d.classList.remove('open');
        const trig = d.querySelector('.dropdown-trigger');
        if (trig) trig.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdowns.forEach(d => {
          d.classList.remove('open');
          const trig = d.querySelector('.dropdown-trigger');
          if (trig) trig.setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>