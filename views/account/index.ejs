<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'overview' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <!-- Success Alert Banner -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 1rem 1.4rem; border-radius: var(--radius-lg); margin-bottom: 1.6rem; font-weight: 500; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.2rem;">✓</span>
          <span><%= successMessage %></span>
        </div>
      </div>
    <% } %>

    <!-- Quick Overview Header Banner -->
    <div style="background: linear-gradient(135deg, var(--primary-indigo) 0%, #312e81 100%); border-radius: var(--radius-xl); padding: 1.8rem 2.2rem; color: #ffffff; margin-bottom: 1.8rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.2rem;">
      <div>
        <div style="font-family: var(--font-mono); font-size: 0.82rem; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.3rem;">Developer Workspace</div>
        <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0; color: #ffffff; line-height: 1.2;">Welcome back, <%= user.displayName || user.username %>!</h1>
        <p style="margin: 0.4rem 0 0 0; opacity: 0.9; font-size: 0.92rem;">Manage your technical publications, saved resources, and community engagement.</p>
      </div>

      <a href="/my/posts/new" class="btn" style="background: #ffffff; color: var(--primary-indigo); border: none; font-weight: 700; padding: 0.7rem 1.3rem; box-shadow: var(--shadow-sm); white-space: nowrap;">
        ✏️ Write New Article
      </a>
    </div>

    <!-- KPI Stats Ribbon -->
    <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin-bottom: 1.8rem;">
      <a href="/my/posts" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo);">
          📝
        </div>
        <div>
          <div class="stat-card__number"><%= typeof stats !== 'undefined' ? stats.postsCount : 0 %></div>
          <div class="stat-card__label">My Articles</div>
        </div>
      </a>

      <a href="/my/bookmarks" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
          🔖
        </div>
        <div>
          <div class="stat-card__number"><%= typeof stats !== 'undefined' ? stats.bookmarksCount : 0 %></div>
          <div class="stat-card__label">Bookmarks</div>
        </div>
      </a>

      <a href="/my/likes" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(239, 68, 68, 0.15); color: #dc2626;">
          ❤️
        </div>
        <div>
          <div class="stat-card__number"><%= typeof stats !== 'undefined' ? stats.likesCount : 0 %></div>
          <div class="stat-card__label">Liked Posts</div>
        </div>
      </a>

      <div class="stat-card">
        <div class="stat-card__icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
          💬
        </div>
        <div>
          <div class="stat-card__number"><%= comments.length %></div>
          <div class="stat-card__label">Comments</div>
        </div>
      </div>

      <a href="/my/questions" class="stat-card" style="text-decoration: none;">
        <div class="stat-card__icon" style="background: rgba(129, 140, 248, 0.15); color: var(--primary-indigo);">
          💡
        </div>
        <div>
          <div class="stat-card__number"><%= typeof stats !== 'undefined' && typeof stats.faqQuestionsCount !== 'undefined' ? (stats.faqQuestionsCount + stats.faqAnswersCount) : 0 %></div>
          <div class="stat-card__label">Q&amp;A Activity</div>
        </div>
      </a>
    </div>

    <!-- Author Performance Analytics Widget -->
    <% if (typeof analytics !== 'undefined') { %>
      <section id="author-analytics" class="dashboard-section">
        <div class="dashboard-section__header">
          <div>
            <h2 class="dashboard-section__title">
              <span>📊 Author Performance Analytics</span>
            </h2>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Overview of reader engagement across your published articles.</p>
          </div>

          <span class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent); font-size: 0.8rem;">
            <%= analytics.totalArticles %> Published Articles
          </span>
        </div>

        <!-- Metric Cards Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 1.6rem;">
          
          <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem 1.2rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.3rem;">
              <span style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted);">Total Views</span>
              <span style="color: #6366f1;">👁</span>
            </div>
            <div style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); font-family: var(--font-mono);"><%= (analytics.totalViews || 0).toLocaleString() %></div>
          </div>

          <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem 1.2rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.3rem;">
              <span style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted);">Total Likes</span>
              <span style="color: #ef4444;">💖</span>
            </div>
            <div style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); font-family: var(--font-mono);"><%= analytics.totalLikes || 0 %></div>
          </div>

          <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem 1.2rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.3rem;">
              <span style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted);">Bookmarks</span>
              <span style="color: #10b981;">🔖</span>
            </div>
            <div style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); font-family: var(--font-mono);"><%= analytics.totalBookmarks || 0 %></div>
          </div>

          <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem 1.2rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.3rem;">
              <span style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted);">Comments</span>
              <span style="color: #f59e0b;">💬</span>
            </div>
            <div style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); font-family: var(--font-mono);"><%= analytics.totalComments || 0 %></div>
          </div>

        </div>

        <!-- Top Performing Posts Leaderboard -->
        <div style="border-top: 1px solid var(--border-light); padding-top: 1.2rem;">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.4rem;">
            <span>🔥 Top Performing Articles</span>
          </h3>

          <% if (analytics.topPosts && analytics.topPosts.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0.6rem;">
              <% analytics.topPosts.forEach((tp, idx) => { %>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 1rem; background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-lg); gap: 1rem; flex-wrap: wrap;">
                  <div style="display: flex; align-items: center; gap: 0.75rem; flex: 1; min-width: 240px;">
                    <span style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; width: 24px; height: 24px; border-radius: 50%; background: var(--primary-indigo-light); color: var(--primary-indigo); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
                      #<%= idx + 1 %>
                    </span>
                    <a href="/post/<%= tp._id %>" style="color: var(--text-main); font-weight: 600; font-size: 0.95rem; text-decoration: none;">
                      <%= tp.title %>
                    </a>
                  </div>

                  <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 0.82rem; font-family: var(--font-mono); color: var(--text-muted);">
                    <span>👁 <%= tp.viewsCount %> views</span>
                    <span>💖 <%= tp.likesCount %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 1.4rem; border-radius: var(--radius-lg); text-align: center; color: var(--text-muted); font-size: 0.88rem;">
              <span>No published articles yet. </span>
              <a href="/my/posts/new" style="color: var(--primary-indigo); font-weight: 600; text-decoration: none; margin-left: 0.3rem;">Write your first article &rarr;</a>
            </div>
          <% } %>
        </div>

      </section>
    <% } %>

    <!-- Activity & Comments Section -->
    <section class="dashboard-section" style="margin-bottom: 0;">
      <div class="dashboard-section__header">
        <h2 class="dashboard-section__title">
          <span>💬 My Discussions &amp; Activity</span>
        </h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% if (comments.length === 0) { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3rem 1.8rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
            <div style="font-size: 2.2rem; margin-bottom: 0.6rem;">💬</div>
            <h3 style="font-size: 1.1rem; color: var(--text-main); margin-bottom: 0.3rem;">No comments left yet</h3>
            <p style="margin-bottom: 1.2rem; font-size: 0.9rem;">Join discussions on architecture, Express patterns, and database engineering.</p>
            <a href="/" class="btn" style="padding: 0.55rem 1.2rem; border-radius: var(--radius-full); font-size: 0.88rem;">Browse Latest Articles &rarr;</a>
          </div>
        <% } else { %>
          <% comments.forEach(comment => { %>
            <div class="user-comment-card">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.6rem; flex-wrap: wrap;">
                <div>
                  <a href="/post/<%= comment.postId %>" style="font-weight: 700; font-size: 1.02rem; color: var(--text-main); text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <span>Article: <%= comment.post ? comment.post.title : 'Discussion' %></span>
                    <span style="color: var(--primary-indigo); font-size: 0.88rem;">&rarr;</span>
                  </a>
                  <div style="color: var(--text-muted); font-size: 0.82rem; font-family: var(--font-mono); margin-top: 0.2rem;">
                    Posted on <%= new Date(comment.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </div>
                </div>

                <% if (comment.isApproved) { %>
                  <span class="comment-status-pill comment-status-pill--approved">
                    ✓ Published
                  </span>
                <% } else { %>
                  <span class="comment-status-pill comment-status-pill--pending">
                    ⏳ Under Review
                  </span>
                <% } %>
              </div>

              <p style="color: var(--text-body); font-size: 0.95rem; line-height: 1.5; margin: 0; background: var(--bg-subtle); padding: 0.85rem 1.1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
                <%= comment.content %>
              </p>
            </div>
          <% }) %>
        <% } %>
      </div>
    </section>

    <!-- Q&A Submissions & Activity Section -->
    <section class="dashboard-section" style="margin-top: 2rem;">
      <div class="dashboard-section__header">
        <div>
          <h2 class="dashboard-section__title">
            <span>💡 Technical Q&amp;A Submissions &amp; Insights</span>
          </h2>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Recent technical interview questions and community answers submitted by you.</p>
        </div>

        <div style="display: flex; gap: 0.6rem;">
          <a href="/my/questions/new" class="btn" style="border-radius: var(--radius-lg); padding: 0.45rem 1rem; font-size: 0.85rem;">
            + Ask Question
          </a>
          <a href="/my/questions" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); border-radius: var(--radius-lg); padding: 0.45rem 1rem; font-size: 0.85rem;">
            View All &rarr;
          </a>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.9rem;">
        <% if (typeof faqSubmissions !== 'undefined' && ((faqSubmissions.questions && faqSubmissions.questions.length > 0) || (faqSubmissions.answers && faqSubmissions.answers.length > 0))) { %>
          <% if (faqSubmissions.questions && faqSubmissions.questions.length > 0) { %>
            <% faqSubmissions.questions.slice(0, 3).forEach(q => { %>
              <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.1rem 1.4rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                <div>
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem;">
                    <span class="tech-badge" style="font-size: 0.72rem; padding: 0.12rem 0.45rem; background: var(--primary-indigo-light); color: var(--primary-indigo);">
                      <%= q.category %>
                    </span>
                    <span class="status-pill <%= q.status === 'approved' ? 'status-pill--approved' : (q.status === 'pending' ? 'status-pill--pending' : 'status-pill--rejected') %>">
                      <%= q.status === 'approved' ? '✓ Approved' : (q.status === 'pending' ? '⏳ Pending' : '✕ Rejected') %>
                    </span>
                  </div>
                  <div style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">
                    ❓ <%= q.question %>
                  </div>
                </div>
                <a href="/faq?q=<%= encodeURIComponent(q.question) %>" style="font-size: 0.82rem; color: var(--primary-indigo); font-weight: 700; text-decoration: none;">
                  View on Hub &rarr;
                </a>
              </div>
            <% }) %>
          <% } %>
        <% } else { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 2rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted); font-size: 0.88rem;">
            No interview questions or answers submitted yet. <a href="/my/questions/new" style="color: var(--primary-indigo); font-weight: 700;">Submit your first question &rarr;</a>
          </div>
        <% } %>
      </div>
    </section>

  </main>
</div>
