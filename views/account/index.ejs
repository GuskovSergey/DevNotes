<div class="cabinet-container">
  
  <!-- Success Alert Banner -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 1rem 1.4rem; border-radius: var(--radius-lg); margin-bottom: 2rem; font-weight: 500; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <span style="font-size: 1.2rem;">✓</span>
        <span><%= successMessage %></span>
      </div>
    </div>
  <% } %>

  <!-- User Profile Technical Hero Card -->
  <div class="cabinet-hero">
    <!-- Code Pattern Header Banner -->
    <div class="cabinet-hero__banner">
      &lt;DevHub / Profile&gt;
    </div>

    <div class="cabinet-hero__body">
      <!-- Avatar & Action Buttons Row -->
      <div class="cabinet-avatar-wrapper">
        <div class="cabinet-avatar">
          <%= (user.displayName || user.username).charAt(0).toUpperCase() %>
          <div class="cabinet-avatar__status" title="Active Developer Account"></div>
        </div>

        <div style="display: flex; gap: 0.8rem; flex-wrap: wrap;">
          <a href="/account/edit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); box-shadow: none; padding: 0.55rem 1.1rem; font-size: 0.9rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.4rem;">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            Edit Profile
          </a>
          <a href="/account/password" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); box-shadow: none; padding: 0.55rem 1.1rem; font-size: 0.9rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.4rem;">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Security
          </a>
          <% if (user.role === 'admin') { %>
            <a href="/dashboard" class="btn" style="padding: 0.55rem 1.1rem; font-size: 0.9rem;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.4rem;">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Admin Dashboard
            </a>
          <% } %>
        </div>
      </div>

      <!-- User Title & Details -->
      <div class="cabinet-user-title">
        <h1>
          <span><%= user.displayName || user.username %></span>
          <% if (user.role === 'admin') { %>
            <span class="role-badge role-badge--admin">👑 Admin</span>
          <% } else { %>
            <span class="role-badge role-badge--user">⚡ Community Member</span>
          <% } %>
        </h1>

        <div class="cabinet-user-meta">
          @<%= user.username %> • <%= user.email || 'No email associated' %>
        </div>

        <p style="color: var(--text-dim); font-size: 0.88rem; margin-top: 0.4rem;">
          Joined DevHub on <%= new Date(user.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </p>

        <% if (user.bio) { %>
          <div style="margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--border-light); color: var(--text-body); font-size: 1rem; line-height: 1.6;">
            <%= user.bio %>
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <!-- Cabinet Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <div>
        <div class="stat-card__number"><%= comments.length %></div>
        <div class="stat-card__label">Total Comments</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div>
        <div class="stat-card__number"><%= comments.filter(c => c.isApproved).length %></div>
        <div class="stat-card__label">Published Comments</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card__icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div>
        <div class="stat-card__number"><%= comments.filter(c => !c.isApproved).length %></div>
        <div class="stat-card__label">In Moderation</div>
      </div>
    </div>
  </div>

  <!-- Activity & Comments Section -->
  <section style="margin-top: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.5rem; color: var(--text-main);">My Discussions &amp; Activity</h2>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1.2rem;">
      <% if (comments.length === 0) { %>
        <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 3.5rem 2rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
          <div style="font-size: 2.5rem; margin-bottom: 0.8rem;">💬</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem;">No comments left yet</h3>
          <p style="margin-bottom: 1.5rem;">Join discussions on architecture, Express patterns, and database engineering.</p>
          <a href="/" class="btn" style="padding: 0.6rem 1.2rem; border-radius: var(--radius-full);">Browse Latest Articles &rarr;</a>
        </div>
      <% } else { %>
        <% comments.forEach(comment => { %>
          <div class="user-comment-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.8rem; flex-wrap: wrap;">
              <div>
                <a href="/post/<%= comment.postId %>" style="font-weight: 700; font-size: 1.1rem; color: var(--text-main); text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
                  <span>Article: <%= comment.post ? comment.post.title : 'Discussion' %></span>
                  <span style="color: var(--primary-indigo); font-size: 0.9rem;">&rarr;</span>
                </a>
                <div style="color: var(--text-muted); font-size: 0.85rem; font-family: var(--font-mono); margin-top: 0.2rem;">
                  Posted on <%= new Date(comment.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </div>
              </div>

              <% if (comment.isApproved) { %>
                <span class="comment-status-pill comment-status-pill--approved">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Published
                </span>
              <% } else { %>
                <span class="comment-status-pill comment-status-pill--pending">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  </svg>
                  Under Review
                </span>
              <% } %>
            </div>

            <p style="color: var(--text-body); font-size: 0.98rem; line-height: 1.6; margin: 0; background: var(--bg-subtle); padding: 1rem 1.2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
              <%= comment.content %>
            </p>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

</div>
