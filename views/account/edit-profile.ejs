<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'settings' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div style="max-width: 920px;">
      
      <!-- Page Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.3rem 0; letter-spacing: -0.02em;">
            ⚙️ Profile &amp; Security Settings
          </h1>
          <p style="color: var(--text-muted); font-size: 0.92rem; margin: 0;">
            Customize your developer identity, avatar photo, social media links, and password.
          </p>
        </div>

        <a href="/user/<%= user.username %>" target="_blank" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.55rem 1.2rem; font-size: 0.86rem; border-radius: var(--radius-lg); font-weight: 600;">
          👁 View Public Profile ↗
        </a>
      </div>

      <!-- Error Message Banner -->
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; padding: 0.9rem 1.2rem; border-radius: var(--radius-lg); margin-bottom: 1.8rem; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 0.6rem;">
          <span>⚠️</span>
          <span><%= errorMessage %></span>
        </div>
      <% } %>

      <!-- Unified Form for Updating Profile Settings -->
      <form action="/account/profile?_method=PUT" method="POST" enctype="multipart/form-data" id="profile-settings-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="checkbox" name="removeAvatar" id="remove-avatar-checkbox" value="true" style="display: none;">

        <!-- CARD 1: AVATAR MANAGEMENT & PREVIEW -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem; margin-bottom: 1.8rem; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.12rem; font-weight: 800; color: var(--text-main); margin: 0 0 1.2rem 0; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.8rem;">
            <span>🎨 Profile Avatar Settings</span>
          </h3>

          <div style="display: flex; align-items: center; gap: 1.8rem; flex-wrap: wrap;">
            <!-- Circular Avatar Frame with Live Preview -->
            <div id="avatar-preview-container" style="width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; font-weight: 800; overflow: hidden; flex-shrink: 0; border: 3px solid var(--border-accent); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12); position: relative;">
              <img id="avatar-preview-img" src="<%= user.avatarUrl || '' %>" alt="Avatar Preview" style="width: 100%; height: 100%; object-fit: cover; display: <%= user.avatarUrl ? 'block' : 'none' %>;">
              <span id="avatar-initial-badge" style="display: <%= user.avatarUrl ? 'none' : 'block' %>;">
                <%= (user.displayName || user.username).charAt(0).toUpperCase() %>
              </span>
            </div>

            <!-- Upload Controls & Remove Action -->
            <div style="flex: 1; min-width: 260px; display: flex; flex-direction: column; gap: 0.6rem;">
              <div style="display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;">
                <label for="avatar-file-input" class="btn" style="background: var(--primary-indigo); color: #ffffff; padding: 0.55rem 1.2rem; font-size: 0.86rem; border-radius: var(--radius-lg); font-weight: 700; cursor: pointer; margin: 0;">
                  📷 Choose New Photo
                </label>
                <input type="file" id="avatar-file-input" name="avatar" accept="image/jpeg,image/png,image/webp" style="display: none;">

                <button type="button" id="reset-avatar-btn" class="btn" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.25); padding: 0.55rem 1.1rem; font-size: 0.85rem; border-radius: var(--radius-lg); font-weight: 700; display: <%= user.avatarUrl ? 'inline-flex' : 'none' %>;">
                  🗑 Remove Custom Avatar
                </button>
              </div>

              <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">
                Supported formats: JPG, PNG, WEBP. Max file size: 2MB. Recommended 1:1 aspect ratio.
              </span>
            </div>
          </div>
        </div>

        <!-- CARD 2: PUBLIC DEVELOPER IDENTITY -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem; margin-bottom: 1.8rem; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.12rem; font-weight: 800; color: var(--text-main); margin: 0 0 1.2rem 0; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.8rem;">
            <span>👤 Developer Identity</span>
          </h3>

          <div style="display: flex; flex-direction: column; gap: 1.2rem;">
            <!-- Display Name Input -->
            <div class="auth-field" style="margin-bottom: 0;">
              <label for="displayName" style="font-size: 0.85rem; font-weight: 700;">Full Name / Display Name</label>
              <div class="auth-input-wrapper">
                <input type="text" id="displayName" name="displayName" value="<%= user.displayName || '' %>" placeholder="e.g. Alexey Ivanov" required style="height: 44px;">
                <span class="auth-input-icon">👤</span>
              </div>
            </div>

            <!-- Email Address Input -->
            <div class="auth-field" style="margin-bottom: 0;">
              <label for="email" style="font-size: 0.85rem; font-weight: 700;">Email Address</label>
              <div class="auth-input-wrapper">
                <input type="email" id="email" name="email" value="<%= user.email || '' %>" placeholder="alexey@example.com" required style="height: 44px;">
                <span class="auth-input-icon">✉️</span>
              </div>
            </div>

            <!-- Developer Bio Input -->
            <div class="auth-field" style="margin-bottom: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                <label for="bio" style="font-size: 0.85rem; font-weight: 700;">Developer Bio (About You)</label>
                <span style="font-size: 0.76rem; font-family: var(--font-mono); color: var(--text-muted);" id="bio-char-count"><%= (user.bio || '').length %>/500</span>
              </div>
              <div class="auth-input-wrapper" style="height: auto;">
                <textarea id="bio" name="bio" rows="3" maxlength="500" placeholder="Backend engineer specializing in Node.js, Express, SQLite & System Architecture..." style="width: 100%; padding: 0.85rem 1rem 0.85rem 2.6rem; border: 1px solid var(--border-light); border-radius: var(--radius-lg); background: var(--bg-subtle); color: var(--text-main); font-family: var(--font-body); font-size: 0.92rem; resize: vertical; outline: none; transition: border-color 0.2s ease;"><%= user.bio || '' %></textarea>
                <span class="auth-input-icon" style="top: 1rem; transform: none;">📝</span>
              </div>
            </div>
          </div>
        </div>

        <!-- CARD 3: OPTIONAL SOCIAL & COMMUNITY LINKS -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem; margin-bottom: 1.8rem; box-shadow: var(--shadow-sm);">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 0.8rem; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="font-size: 1.12rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
              <span>🌐 Social &amp; Community Links</span>
            </h3>
            <span class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); font-size: 0.76rem; padding: 0.15rem 0.55rem; font-family: var(--font-mono);">
              Optional Fields
            </span>
          </div>

          <p style="font-size: 0.84rem; color: var(--text-muted); margin: 0 0 1.2rem 0; line-height: 1.5;">
            These social profile links are completely optional. Leave them blank if you prefer not to display external badges on your public author page.
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.2rem;">
            <!-- GitHub Profile -->
            <div class="auth-field" style="margin-bottom: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                <label for="githubUrl" style="font-size: 0.84rem; font-weight: 700;">GitHub Profile</label>
                <span style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">(Optional)</span>
              </div>
              <div class="auth-input-wrapper">
                <input type="url" id="githubUrl" name="githubUrl" value="<%= user.githubUrl || '' %>" placeholder="https://github.com/username" style="height: 44px;">
                <span class="auth-input-icon">🐙</span>
              </div>
            </div>

            <!-- Twitter / X -->
            <div class="auth-field" style="margin-bottom: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                <label for="twitterUrl" style="font-size: 0.84rem; font-weight: 700;">Twitter / X Profile</label>
                <span style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">(Optional)</span>
              </div>
              <div class="auth-input-wrapper">
                <input type="url" id="twitterUrl" name="twitterUrl" value="<%= user.twitterUrl || '' %>" placeholder="https://twitter.com/username" style="height: 44px;">
                <span class="auth-input-icon">🐦</span>
              </div>
            </div>

            <!-- Personal Website -->
            <div class="auth-field" style="margin-bottom: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                <label for="websiteUrl" style="font-size: 0.84rem; font-weight: 700;">Personal Website</label>
                <span style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">(Optional)</span>
              </div>
              <div class="auth-input-wrapper">
                <input type="url" id="websiteUrl" name="websiteUrl" value="<%= user.websiteUrl || '' %>" placeholder="https://yourdomain.dev" style="height: 44px;">
                <span class="auth-input-icon">🌐</span>
              </div>
            </div>
          </div>
        </div>

        <!-- CARD 4: SECURITY & PASSWORD UPDATE -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.8rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.12rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.3rem 0; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.8rem;">
            <span>🔒 Security &amp; Password Update</span>
          </h3>
          <p style="font-size: 0.84rem; color: var(--text-muted); margin: 0 0 1.2rem 0;">
            Leave password fields empty if you do not want to change your account password.
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.2rem;">
            <div class="auth-field" style="margin-bottom: 0;">
              <label for="oldPassword" style="font-size: 0.84rem; font-weight: 700;">Current Password</label>
              <div class="auth-input-wrapper">
                <input type="password" id="oldPassword" name="oldPassword" placeholder="••••••••" style="height: 44px;">
                <span class="auth-input-icon">🔑</span>
              </div>
            </div>

            <div class="auth-field" style="margin-bottom: 0;">
              <label for="newPassword" style="font-size: 0.84rem; font-weight: 700;">New Password</label>
              <div class="auth-input-wrapper">
                <input type="password" id="newPassword" name="newPassword" placeholder="Min 4 characters" style="height: 44px;">
                <span class="auth-input-icon">✨</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit & Cancel Actions -->
        <div style="display: flex; gap: 1rem; margin-bottom: 3rem;">
          <button type="submit" class="btn" style="flex: 1; padding: 0.85rem; font-size: 1rem; font-weight: 800; border-radius: var(--radius-lg); justify-content: center; box-shadow: 0 4px 14px var(--primary-indigo-light);">
            <span>Save Profile Settings &rarr;</span>
          </button>
          
          <a href="/account" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.85rem 1.6rem; font-size: 0.92rem; border-radius: var(--radius-lg); font-weight: 600; text-decoration: none;">
            Cancel
          </a>
        </div>

      </form>
    </div>

  </main>
</div>

<!-- Interactive Client-side Script for Live Avatar Preview, Character Counter & Remove Avatar -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('avatar-file-input');
    const previewImg = document.getElementById('avatar-preview-img');
    const initialBadge = document.getElementById('avatar-initial-badge');
    const resetAvatarBtn = document.getElementById('reset-avatar-btn');
    const removeCheckbox = document.getElementById('remove-avatar-checkbox');
    const bioTextarea = document.getElementById('bio');
    const bioCountSpan = document.getElementById('bio-char-count');

    // Live FileReader Preview for New Image File
    if (fileInput && previewImg && initialBadge) {
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (evt) => {
            previewImg.src = evt.target.result;
            previewImg.style.display = 'block';
            initialBadge.style.display = 'none';
            if (removeCheckbox) removeCheckbox.checked = false;
            if (resetAvatarBtn) resetAvatarBtn.style.display = 'inline-flex';
          };
          reader.readAsDataURL(file);
        }
      });
    }

    // Reset / Remove Custom Avatar Handler
    if (resetAvatarBtn) {
      resetAvatarBtn.addEventListener('click', () => {
        if (fileInput) fileInput.value = '';
        if (previewImg) {
          previewImg.src = '';
          previewImg.style.display = 'none';
        }
        if (initialBadge) initialBadge.style.display = 'block';
        if (removeCheckbox) removeCheckbox.checked = true;
        resetAvatarBtn.style.display = 'none';
      });
    }

    // Live Bio Character Counter
    if (bioTextarea && bioCountSpan) {
      bioTextarea.addEventListener('input', () => {
        const len = bioTextarea.value.length;
        bioCountSpan.textContent = `${len}/500`;
      });
    }
  });
</script>
