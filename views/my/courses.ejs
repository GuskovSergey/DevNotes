<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'courses' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <!-- Success Notification -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 1rem 1.4rem; border-radius: var(--radius-lg); margin-bottom: 1.6rem; font-weight: 500; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.2rem;">✓</span>
          <span><%= successMessage %></span>
        </div>
      </div>
    <% } %>

    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>📚 My Engineering Courses &amp; Modules</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Manage your published courses, draft modules, and track moderation status.</p>
        </div>

        <a href="/my/courses/new" class="btn" style="border-radius: var(--radius-lg); padding: 0.55rem 1.2rem; font-size: 0.88rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.35rem;">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Create Course Track
        </a>
      </div>

      <!-- Courses List -->
      <div style="display: flex; flex-direction: column; gap: 1.1rem;">
        <% if (courses.length === 0) { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
            <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🎓</div>
            <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem;">You haven't created any courses yet</h3>
            <p style="margin-bottom: 1.5rem; max-width: 420px; margin-left: auto; margin-right: auto; font-size: 0.9rem; line-height: 1.5;">Share your engineering expertise by building structured, text-based learning tracks for the DevHub community.</p>
            <a href="/my/courses/new" class="btn" style="padding: 0.65rem 1.4rem; border-radius: var(--radius-full); font-size: 0.9rem;">Start Course Track &rarr;</a>
          </div>
        <% } else { %>
          <% courses.forEach(course => { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.4rem 1.6rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; gap: 1.2rem; flex-wrap: wrap;">
              <div style="flex: 1; min-width: 260px;">
                
                <div style="display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                  <% if (course.status === 'published') { %>
                    <span class="comment-status-pill comment-status-pill--approved">
                      ✓ Published
                    </span>
                  <% } else if (course.status === 'pending') { %>
                    <span class="comment-status-pill comment-status-pill--pending">
                      ⏳ Under Moderation
                    </span>
                  <% } else if (course.status === 'rejected') { %>
                    <span class="comment-status-pill" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">
                      ✕ Rejected
                    </span>
                  <% } else { %>
                    <span class="comment-status-pill" style="background: var(--bg-subtle); color: var(--text-muted); border: 1px solid var(--border-light);">
                      ✏️ Draft
                    </span>
                  <% } %>

                  <span class="tech-badge" style="font-size: 0.7rem; padding: 0.12rem 0.5rem; font-family: var(--font-mono); <%= course.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3);' : (course.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent);') %>">
                    <%= course.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (course.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
                  </span>

                  <span style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">
                    📚 <%= course.lessonsCount %> Lesson<%= course.lessonsCount !== 1 ? 's' : '' %>
                  </span>
                </div>

                <h3 style="font-size: 1.15rem; color: var(--text-main); font-weight: 700; margin-bottom: 0.3rem;">
                  <% if (course.status === 'published') { %>
                    <a href="/courses/<%= course.slug %>" target="_blank" style="color: var(--text-main); text-decoration: none;"><%= course.title %> ↗</a>
                  <% } else { %>
                    <%= course.title %>
                  <% } %>
                </h3>

                <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 640px;">
                  <%= course.descriptionSnippet %>
                </p>
              </div>

              <!-- Action Controls -->
              <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <a href="/my/courses/<%= course.id %>/edit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.45rem 0.95rem; font-size: 0.85rem; box-shadow: none; border-radius: var(--radius-lg);">
                  Edit Track
                </a>

                <form action="/my/courses/<%= course.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this course and all its lessons?');" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-delete" style="padding: 0.45rem 0.85rem; font-size: 0.85rem; border-radius: var(--radius-lg);">
                    Delete
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </main>
</div>
