<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'history' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>🕒 Reading History</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Automatically logged articles you've recently visited.</p>
        </div>

        <% if (history && history.length > 0) { %>
          <form action="/my/history/clear" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-muted); padding: 0.4rem 0.9rem; font-size: 0.82rem; box-shadow: none;">
              🗑 Clear History
            </button>
          </form>
        <% } %>
      </div>

      <% if (!history || history.length === 0) { %>
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center;">
          <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">📖</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 700;">No Reading History Yet</h3>
          <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto 1.5rem auto; font-size: 0.9rem; line-height: 1.5;">
            Articles you read while logged in will automatically appear here so you can easily pick up where you left off.
          </p>
          <a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.65rem 1.4rem; font-size: 0.9rem;">
            <span>Explore Articles</span>
            &rarr;
          </a>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <% history.forEach(item => { %>
            <% const post = item.post; %>
            <article class="article-card" style="display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 1.6rem; gap: 1.2rem; flex-wrap: wrap; box-shadow: none; border-color: var(--border-light);">
              
              <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                  <% if (post.category) { %>
                    <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;">
                      <%= post.category.name %>
                    </span>
                  <% } %>
                  <span style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
                    Read on <%= item.readAtFormatted %>
                  </span>
                </div>

                <h2 style="font-size: 1.15rem; margin-bottom: 0.35rem; font-weight: 700; line-height: 1.4;">
                  <a href="/post/<%= post.id %>" style="color: var(--text-main); text-decoration: none;">
                    <%= post.title %>
                  </a>
                </h2>

                <div style="display: flex; align-items: center; gap: 0.7rem; font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono);">
                  <span>⏱ <%= post.readingTime %></span>
                  <span>•</span>
                  <span>👁 <%= post.viewsCount %> views</span>
                  <% if (post.author) { %>
                    <span>•</span>
                    <span>By <%= post.author.displayName %></span>
                  <% } %>
                </div>
              </div>

              <!-- Actions -->
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <a href="/post/<%= post.id %>" class="btn" style="padding: 0.5rem 1.1rem; font-size: 0.85rem;">
                  <span>Read Again</span>
                  &rarr;
                </a>
              </div>

            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>
</div>
