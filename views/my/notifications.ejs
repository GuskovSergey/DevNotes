<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'notifications' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>🔔 Activity Notifications</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Alerts for new comments, replies, and article moderation updates.</p>
        </div>

        <% if (notifications && notifications.length > 0) { %>
          <form action="/my/notifications/read-all" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-muted); padding: 0.4rem 0.9rem; font-size: 0.82rem; box-shadow: none;">
              ✓ Mark all as read
            </button>
          </form>
        <% } %>
      </div>

      <% if (!notifications || notifications.length === 0) { %>
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center;">
          <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">🔔</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 700;">No Notifications Yet</h3>
          <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto 1.5rem auto; font-size: 0.9rem; line-height: 1.5;">
            You'll receive notifications when readers comment on your articles, reply to your thoughts, or when your articles get moderated.
          </p>
          <a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.65rem 1.4rem; font-size: 0.9rem;">
            <span>Explore Articles</span>
            &rarr;
          </a>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <% notifications.forEach(notif => { %>
            <a href="<%= notif.link %>" style="display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.4rem; background: <%= notif.isRead ? 'var(--bg-surface)' : 'var(--primary-indigo-light)' %>; border: 1px solid <%= notif.isRead ? 'var(--border-light)' : 'var(--border-accent)' %>; border-radius: var(--radius-xl); text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; gap: 1rem; flex-wrap: wrap;">
              
              <div style="display: flex; align-items: center; gap: 0.9rem; flex: 1; min-width: 240px;">
                <div style="width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; flex-shrink: 0; <%= notif.type === 'comment' ? 'background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo);' : (notif.type === 'reply' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981;' : (notif.type === 'moderation_approved' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981;' : 'background: rgba(239, 68, 68, 0.15); color: #dc2626;')) %>">
                  <% if (notif.type === 'comment') { %>💬<% } else if (notif.type === 'reply') { %>↩️<% } else if (notif.type === 'moderation_approved') { %>✅<% } else if (notif.type === 'moderation_rejected') { %>⚠️<% } else { %>🔔<% } %>
                </div>

                <div>
                  <div style="font-size: 0.95rem; font-weight: <%= notif.isRead ? '500' : '700' %>; color: var(--text-main); line-height: 1.4;">
                    <%= notif.message %>
                  </div>
                  <div style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.2rem;">
                    <%= notif.createdAtFormatted %>
                  </div>
                </div>
              </div>

              <span style="font-size: 0.85rem; color: var(--primary-indigo); font-weight: 600;">
                View &rarr;
              </span>

            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>
</div>
