<div class="cabinet-container">
  
  <!-- Success Notification -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 1rem 1.4rem; border-radius: var(--radius-lg); margin-bottom: 2rem; font-weight: 500; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <span style="font-size: 1.2rem;">✓</span>
        <span><%= successMessage %></span>
      </div>
    </div>
  <% } %>

  <!-- Header & Action Bar -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <a href="/account" style="color: var(--text-muted); font-size: 0.9rem; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.5rem;">
        &larr; Back to Cabinet
      </a>
      <h1 style="font-size: 1.8rem; color: var(--text-main); margin: 0;">My Written Articles</h1>
    </div>

    <a href="/my/posts/new" class="btn" style="border-radius: var(--radius-full); padding: 0.65rem 1.4rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.4rem;">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      Write New Article
    </a>
  </div>

  <!-- Articles List -->
  <div style="display: flex; flex-direction: column; gap: 1.2rem;">
    <% if (posts.length === 0) { %>
      <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 3.5rem 2rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
        <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">✍️</div>
        <h3 style="font-size: 1.3rem; color: var(--text-main); margin-bottom: 0.4rem;">You haven't written any articles yet</h3>
        <p style="margin-bottom: 1.5rem; max-width: 460px; margin-left: auto; margin-right: auto;">Share your technical knowledge, architectural insights, and tutorial guides with the DevHub community.</p>
        <a href="/my/posts/new" class="btn" style="padding: 0.7rem 1.5rem; border-radius: var(--radius-full);">Start Writing &rarr;</a>
      </div>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.6rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
              <% if (post.status === 'published') { %>
                <span class="comment-status-pill comment-status-pill--approved">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Published
                </span>
              <% } else if (post.status === 'pending') { %>
                <span class="comment-status-pill comment-status-pill--pending">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  Under Moderation
                </span>
              <% } else if (post.status === 'rejected') { %>
                <span class="comment-status-pill" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">
                  ✕ Rejected
                </span>
              <% } else { %>
                <span class="comment-status-pill" style="background: var(--bg-subtle); color: var(--text-muted); border: 1px solid var(--border-light);">
                  Draft
                </span>
              <% } %>

              <% if (post.category) { %>
                <span class="article-card__badge"><%= post.category.name %></span>
              <% } %>

              <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-dim);">
                Created <%= post.createdAtFormatted %>
              </span>
            </div>

            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.4rem;">
              <% if (post.status === 'published') { %>
                <a href="/post/<%= post.id %>" style="color: var(--text-main); text-decoration: none;"><%= post.title %></a>
              <% } else { %>
                <span style="color: var(--text-main);"><%= post.title %></span>
              <% } %>
            </h3>

            <% if (post.tags && post.tags.length > 0) { %>
              <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.5rem;">
                <% post.tags.forEach(t => { %>
                  <span class="tech-badge" style="font-size: 0.7rem; padding: 0.15rem 0.5rem;">#<%= t.name %></span>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <a href="/my/posts/<%= post.id %>/edit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.45rem 0.95rem; font-size: 0.85rem; box-shadow: none;">
              Edit
            </a>

            <form action="/my/posts/<%= post.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this article?');" style="margin: 0;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-delete" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;">
                Delete
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

</div>
