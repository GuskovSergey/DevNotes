<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'articles' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <!-- Success Notification -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 1rem 1.4rem; border-radius: var(--radius-lg); margin-bottom: 1.6rem; font-weight: 500; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.2rem;">✓</span>
          <span><%= successMessage %></span>
        </div>
      </div>
    <% } %>

    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>📝 My Written Articles</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Manage your technical articles, drafts, and track moderation status.</p>
        </div>

        <a href="/my/posts/new" class="btn" style="border-radius: var(--radius-lg); padding: 0.55rem 1.2rem; font-size: 0.88rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.35rem;">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Write Article
        </a>
      </div>

      <!-- Articles List -->
      <div style="display: flex; flex-direction: column; gap: 1.1rem;">
        <% if (posts.length === 0) { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center; color: var(--text-muted);">
            <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">✍️</div>
            <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem;">You haven't written any articles yet</h3>
            <p style="margin-bottom: 1.5rem; max-width: 420px; margin-left: auto; margin-right: auto; font-size: 0.9rem; line-height: 1.5;">Share your technical knowledge, architectural insights, and tutorial guides with the DevHub community.</p>
            <a href="/my/posts/new" class="btn" style="padding: 0.65rem 1.4rem; border-radius: var(--radius-full); font-size: 0.9rem;">Start Writing &rarr;</a>
          </div>
        <% } else { %>
          <% posts.forEach(post => { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.4rem 1.6rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; gap: 1.2rem; flex-wrap: wrap;">
              <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                  <% if (post.status === 'published') { %>
                    <span class="comment-status-pill comment-status-pill--approved">
                      ✓ Published
                    </span>
                  <% } else if (post.status === 'pending') { %>
                    <span class="comment-status-pill comment-status-pill--pending">
                      ⏳ Under Moderation
                    </span>
                  <% } else if (post.status === 'rejected') { %>
                    <span class="comment-status-pill" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">
                      ✕ Rejected
                    </span>
                  <% } else { %>
                    <span class="comment-status-pill" style="background: var(--bg-subtle); color: var(--text-muted); border: 1px solid var(--border-light);">
                      Draft
                    </span>
                  <% } %>

                  <% if (post.category) { %>
                    <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;"><%= post.category.name %></span>
                  <% } %>

                  <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-dim);">
                    Created <%= post.createdAtFormatted %>
                  </span>
                </div>

                <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.35rem; line-height: 1.4;">
                  <% if (post.status === 'published') { %>
                    <a href="/post/<%= post.id %>" style="color: var(--text-main); text-decoration: none;"><%= post.title %></a>
                  <% } else { %>
                    <span style="color: var(--text-main);"><%= post.title %></span>
                  <% } %>
                </h3>

                <% if (post.tags && post.tags.length > 0) { %>
                  <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.4rem;">
                    <% post.tags.forEach(t => { %>
                      <span class="tech-badge" style="font-size: 0.7rem; padding: 0.12rem 0.45rem;">#<%= t.name %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>

              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <a href="/my/posts/<%= post.id %>/edit" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.45rem 0.9rem; font-size: 0.85rem; box-shadow: none;">
                  Edit
                </a>

                <form action="/my/posts/<%= post.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this article?');" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-delete" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </main>
</div>
