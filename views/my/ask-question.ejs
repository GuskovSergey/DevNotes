<div class="dashboard">
  
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'my-questions' }) %>

  <main class="dashboard__content">
    
    <div style="margin-bottom: 1.8rem;">
      <a href="/my/questions" style="font-size: 0.88rem; font-family: var(--font-mono); color: var(--text-muted); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; transition: color 0.2s;" onmouseover="this.style.color='var(--primary-indigo)'" onmouseout="this.style.color='var(--text-muted)'">
        &larr; Back to My Q&amp;A Submissions
      </a>
      <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0.6rem 0 0.2rem 0;">
        💡 Ask a Technical Question
      </h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
        Submit an interview question or backend architecture query to the community. Submissions pass through admin moderation.
      </p>
    </div>

    <form action="/my/questions/new" method="POST" style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.4rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 1.6rem; animation: fadeSlideUp 0.3s ease;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="question" style="display: block; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem; font-size: 0.95rem;">
          Question Title *
        </label>
        <input type="text" name="question" id="question" required placeholder="e.g., How does indexing work in SQLite under high concurrency?" class="faq-search-input" style="padding-left: 1rem;">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
        <div>
          <label for="category" style="display: block; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem; font-size: 0.95rem;">
            Категория / Тема *
          </label>
          <select name="category" id="category" required style="width: 100%; padding: 0.8rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); background: var(--bg-subtle); color: var(--text-main); font-size: 0.92rem; outline: none; transition: border-color 0.2s ease;">
            <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            <% } else { %>
              <option value="Общее">Общее</option>
              <option value="Node.js Core">Node.js Core</option>
              <option value="Databases &amp; SQL">Databases &amp; SQL</option>
              <option value="System Architecture">System Architecture</option>
            <% } %>
          </select>
        </div>

        <div>
          <label for="difficulty" style="display: block; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem; font-size: 0.95rem;">
            Уровень сложности *
          </label>
          <select name="difficulty" id="difficulty" required style="width: 100%; padding: 0.8rem 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); background: var(--bg-subtle); color: var(--text-main); font-size: 0.92rem; outline: none; transition: border-color 0.2s ease;">
            <option value="Junior">🌱 Начальный (Junior)</option>
            <option value="Mid" selected>⚡ Средний (Mid)</option>
            <option value="Senior">🚀 Продвинутый (Senior)</option>
          </select>
        </div>
      </div>

      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <label for="answer" style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">
            Explanation / Initial Answer (Optional Markdown)
          </label>
          <span style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">Supports Code Blocks &amp; Markdown</span>
        </div>
        <textarea name="answer" id="answer" rows="9" placeholder="Provide your initial thoughts, explanation, or code snippet example..." style="width: 100%; padding: 1rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); background: var(--bg-subtle); color: var(--text-main); font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.6; outline: none; resize: vertical; transition: border-color 0.2s ease, box-shadow 0.2s ease;" onfocus="this.style.borderColor='var(--primary-indigo)'; this.style.boxShadow='0 0 0 3px var(--primary-indigo-light)'" onblur="this.style.borderColor='var(--border-light)'; this.style.boxShadow='none'"></textarea>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 0.5rem; border-top: 1px solid var(--border-light); padding-top: 1.4rem;">
        <a href="/my/questions" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.75rem 1.6rem; font-size: 0.9rem; border-radius: var(--radius-lg);">
          Cancel
        </a>
        <button type="submit" class="btn" style="padding: 0.75rem 2rem; font-size: 0.9rem; font-weight: 800; border-radius: var(--radius-lg); box-shadow: 0 4px 14px var(--primary-indigo-light);">
          Submit Question for Moderation &rarr;
        </button>
      </div>
    </form>

  </main>

</div>
