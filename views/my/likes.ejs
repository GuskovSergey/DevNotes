<div style="max-width: 1000px; margin: 0 auto; padding-bottom: 3rem;">
  
  <!-- Back & Top Bar -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <a href="/account" style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-muted); font-size: 0.9rem; text-decoration: none; font-weight: 600; margin-bottom: 0.4rem;">
        &larr; Back to Cabinet
      </a>
      <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
        ❤️ Liked Articles
      </h1>
    </div>

    <span class="tech-badge" style="background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3); font-size: 0.85rem; padding: 0.35rem 0.9rem;">
      <%= posts.length %> Liked
    </span>
  </div>

  <% if (posts.length === 0) { %>
    <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 4rem 2rem; border-radius: var(--radius-xl); text-align: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">❤️</div>
      <h3 style="font-size: 1.4rem; color: var(--text-main); margin-bottom: 0.5rem; font-weight: 700;">No Liked Articles Yet</h3>
      <p style="color: var(--text-muted); max-width: 460px; margin: 0 auto 1.8rem auto; line-height: 1.6;">
        Like articles to save them here for quick reference. Show appreciation for great technical content!
      </p>
      <a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.6rem;">
        <span>Explore Articles</span>
        &rarr;
      </a>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% posts.forEach(post => { %>
        <article class="article-card" style="display: flex; justify-content: space-between; align-items: center; padding: 1.6rem 2rem; gap: 1.5rem; flex-wrap: wrap;">
          
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
              <% if (post.category) { %>
                <span class="category-pill" style="font-size: 0.75rem; padding: 0.2rem 0.65rem;">
                  <%= post.category.name %>
                </span>
              <% } %>
              <span class="tech-badge" style="font-size: 0.75rem; padding: 0.15rem 0.55rem; font-family: var(--font-mono);">
                <%= post.createdAtFormatted %>
              </span>
              <span style="font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono);">
                ⏱ <%= post.readingTime %>
              </span>
            </div>

            <h2 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; line-height: 1.4;">
              <a href="/post/<%= post._id %>" style="color: var(--text-main); text-decoration: none;">
                <%= post.title %>
              </a>
            </h2>

            <p style="color: var(--text-muted); font-size: 0.92rem; margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= post.body ? post.body.replace(/[#*`_]/g, '').substring(0, 150) + '...' : '' %>
            </p>
          </div>

          <!-- Actions -->
          <div style="display: flex; align-items: center; gap: 0.8rem;">
            <a href="/post/<%= post._id %>" class="btn" style="padding: 0.6rem 1.2rem; font-size: 0.9rem;">
              <span>Read</span>
              &rarr;
            </a>

            <form action="/my/likes/toggle/<%= post._id %>" method="POST" style="margin: 0;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); color: #dc2626; padding: 0.6rem 1rem; font-size: 0.85rem; box-shadow: none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.3rem;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                Unlike
              </button>
            </form>
          </div>

        </article>
      <% }) %>
    </div>
  <% } %>

</div>
