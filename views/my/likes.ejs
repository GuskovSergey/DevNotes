<div class="dashboard">
  
  <!-- Sidebar Navigation -->
  <%- include('../partials/sidebar-cabinet', { user, activeTab: 'likes' }) %>

  <!-- Main Content Area -->
  <main class="dashboard__content">
    
    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <h1 class="dashboard-section__title">
            <span>❤️ Liked Articles</span>
          </h1>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Technical articles you've appreciated and saved for quick access.</p>
        </div>

        <span class="tech-badge" style="background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3); font-size: 0.82rem; padding: 0.3rem 0.8rem;">
          <%= posts.length %> Liked
        </span>
      </div>

      <% if (posts.length === 0) { %>
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 3.5rem 1.8rem; border-radius: var(--radius-xl); text-align: center;">
          <div style="font-size: 2.8rem; margin-bottom: 0.8rem;">❤️</div>
          <h3 style="font-size: 1.2rem; color: var(--text-main); margin-bottom: 0.4rem; font-weight: 700;">No Liked Articles Yet</h3>
          <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto 1.5rem auto; font-size: 0.9rem; line-height: 1.5;">
            Like articles to save them here for quick reference and support great technical authors.
          </p>
          <a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.65rem 1.4rem; font-size: 0.9rem;">
            <span>Explore Articles</span>
            &rarr;
          </a>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.2rem;">
          <% posts.forEach(post => { %>
            <article class="article-card" style="display: flex; justify-content: space-between; align-items: center; padding: 1.4rem 1.6rem; gap: 1.2rem; flex-wrap: wrap; box-shadow: none; border-color: var(--border-light);">
              
              <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                  <% if (post.category) { %>
                    <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;">
                      <%= post.category.name %>
                    </span>
                  <% } %>
                  <span class="tech-badge" style="font-size: 0.72rem; padding: 0.12rem 0.5rem; font-family: var(--font-mono);">
                    <%= post.createdAtFormatted %>
                  </span>
                  <span style="font-size: 0.78rem; color: var(--text-dim); font-family: var(--font-mono);">
                    ⏱ <%= post.readingTime %>
                  </span>
                </div>

                <h2 style="font-size: 1.2rem; margin-bottom: 0.4rem; font-weight: 700; line-height: 1.4;">
                  <a href="/post/<%= post._id %>" style="color: var(--text-main); text-decoration: none;">
                    <%= post.title %>
                  </a>
                </h2>

                <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= post.body ? post.body.replace(/[#*`_]/g, '').substring(0, 140) + '...' : '' %>
                </p>
              </div>

              <!-- Actions -->
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <a href="/post/<%= post._id %>" class="btn" style="padding: 0.5rem 1.1rem; font-size: 0.88rem;">
                  <span>Read</span>
                  &rarr;
                </a>

                <form action="/my/likes/toggle/<%= post._id %>" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); color: #dc2626; padding: 0.5rem 0.85rem; font-size: 0.82rem; box-shadow: none;">
                    Unlike
                  </button>
                </form>
              </div>

            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>
</div>
