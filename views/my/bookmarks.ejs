<div style="max-width: 1000px; margin: 0 auto; padding-bottom: 3rem;">
  
  <!-- Back & Top Bar -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <a href="/account" style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-muted); font-size: 0.9rem; text-decoration: none; font-weight: 600; margin-bottom: 0.4rem;">
        &larr; Back to Cabinet
      </a>
      <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
        🔖 Saved Articles
      </h1>
    </div>

    <span class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent); font-size: 0.85rem; padding: 0.35rem 0.9rem;">
      <%= posts.length %> Saved
    </span>
  </div>

  <% if (posts.length === 0) { %>
    <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 4rem 2rem; border-radius: var(--radius-xl); text-align: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🔖</div>
      <h3 style="font-size: 1.4rem; color: var(--text-main); margin-bottom: 0.5rem; font-weight: 700;">No Saved Articles Yet</h3>
      <p style="color: var(--text-muted); max-width: 460px; margin: 0 auto 1.8rem auto; line-height: 1.6;">
        Bookmark technical posts while browsing to read them later or save them to your personal reference collection.
      </p>
      <a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.6rem;">
        <span>Explore Articles</span>
        &rarr;
      </a>
    </div>
  <% } else { %>
    <div class="articles-grid" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% posts.forEach(post => { %>
        <article class="article-card" style="display: flex; justify-content: space-between; align-items: center; padding: 1.6rem 2rem; gap: 1.5rem; flex-wrap: wrap;">
          
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
              <% if (post.category) { %>
                <span class="category-pill" style="font-size: 0.75rem; padding: 0.2rem 0.65rem;">
                  <%= post.category.name %>
                </span>
              <% } %>
              <span class="tech-badge" style="font-size: 0.75rem; padding: 0.15rem 0.55rem; font-family: var(--font-mono);">
                <%= post.createdAtFormatted %>
              </span>
            </div>

            <h2 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; line-height: 1.4;">
              <a href="/post/<%= post.id %>" style="color: var(--text-main); text-decoration: none;">
                <%= post.title %>
              </a>
            </h2>

            <p style="color: var(--text-muted); font-size: 0.92rem; margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= post.bodySnippet %>
            </p>
          </div>

          <!-- Actions -->
          <div style="display: flex; align-items: center; gap: 0.8rem;">
            <a href="/post/<%= post.id %>" class="btn" style="padding: 0.6rem 1.2rem; font-size: 0.9rem;">
              <span>Read</span>
              &rarr;
            </a>

            <form action="/my/bookmarks/toggle/<%= post.id %>" method="POST" style="margin: 0;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 0.6rem 1rem; font-size: 0.85rem; box-shadow: none;">
                Remove
              </button>
            </form>
          </div>

        </article>
      <% }) %>
    </div>
  <% } %>

</div>
