<div style="max-width: 1240px; margin: 0 auto; padding-bottom: 3.5rem;">
  
  <!-- Breadcrumbs Bar -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.8rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; font-family: var(--font-mono); color: var(--text-muted);">
      <a href="/courses" style="color: var(--text-muted); text-decoration: none;">Courses</a>
      <span>&rsaquo;</span>
      <% if (lesson.course) { %>
        <a href="/courses/<%= lesson.course.slug %>" style="color: var(--text-muted); text-decoration: none;"><%= lesson.course.title %></a>
        <span>&rsaquo;</span>
      <% } %>
      <span style="color: var(--primary-indigo); font-weight: 700;">Lesson <%= lesson.order %></span>
    </div>

    <!-- Toggle Completion Button (Form & AJAX) -->
    <% if (currentUser) { %>
      <form action="/courses/<%= lesson.course ? lesson.course.slug : '' %>/lessons/<%= lesson.slug %>/complete" method="POST" id="lesson-complete-form" style="margin: 0;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="courseId" value="<%= lesson.courseId %>">
        <input type="hidden" name="lessonId" value="<%= lesson.id %>">
        <button type="submit" id="toggle-complete-btn" class="btn" style="<%= lesson.isCompleted ? 'background: #059669; color: #ffffff;' : 'background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-main);' %> padding: 0.5rem 1.2rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
          <span id="complete-btn-icon"><%= lesson.isCompleted ? '✓' : '○' %></span>
          <span id="complete-btn-text"><%= lesson.isCompleted ? 'Completed' : 'Mark as Complete' %></span>
        </button>
      </form>
    <% } %>
  </div>

  <!-- Two-Column Interactive Reader Layout -->
  <div style="display: grid; grid-template-columns: 300px 1fr; gap: 2.2rem; align-items: flex-start;" class="home-layout">
    
    <!-- Left Syllabus Sidebar (Lesson Index & Progress) -->
    <aside style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.6rem; box-shadow: var(--shadow-sm); position: sticky; top: 80px;">
      
      <div style="margin-bottom: 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-light);">
        <a href="/courses/<%= lesson.course ? lesson.course.slug : '' %>" style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--primary-indigo); text-decoration: none; font-weight: 700; display: block; margin-bottom: 0.3rem;">
          &larr; Overview
        </a>
        <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0; line-height: 1.3;">
          <%= lesson.course ? lesson.course.title : 'Course Syllabus' %>
        </h2>
      </div>

      <!-- Syllabus Module Links -->
      <% if (lesson.course && lesson.course.totalLessons) { %>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 520px; overflow-y: auto; padding-right: 0.2rem;">
          <div style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem;">
            Course Modules (<%= lesson.course.totalLessons %>)
          </div>

          <!-- Note: The syllabus links dynamically map from course -->
          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            <div style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-main); font-weight: 700; padding: 0.6rem 0.8rem; background: var(--primary-indigo-light); border-radius: var(--radius-md); border-left: 3px solid var(--primary-indigo);">
              📖 Lesson <%= lesson.order %>: <%= lesson.title %>
            </div>
          </div>
        </div>
      <% } %>

    </aside>

    <!-- Right Main Reader Area -->
    <main style="min-width: 0;">
      
      <!-- Main Lesson Editorial Card -->
      <article class="single-post-card" style="margin-bottom: 2.2rem; padding: 2.8rem;">
        
        <header style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-light);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.8rem; flex-wrap: wrap;">
            <span class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent); font-size: 0.78rem; padding: 0.2rem 0.65rem;">
              Module <%= lesson.order %>
            </span>
            <span style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-muted);">⏱ <%= lesson.readingTime %></span>
          </div>

          <h1 style="font-size: clamp(1.8rem, 3.2vw, 2.4rem); font-weight: 800; color: var(--text-main); line-height: 1.25; margin: 0;">
            <%= lesson.title %>
          </h1>
        </header>

        <!-- Markdown Rendered HTML Body Content -->
        <div class="article-content" style="line-height: 1.7; font-size: 1.05rem;">
          <%- lesson.bodyHtml %>
        </div>

        <!-- Lesson Bottom Navigation (Prev / Next Buttons) -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; padding-top: 1.8rem; border-top: 1px solid var(--border-light); flex-wrap: wrap; gap: 1rem;">
          <% if (lesson.prevLesson) { %>
            <a href="/courses/<%= lesson.course ? lesson.course.slug : '' %>/lessons/<%= lesson.prevLesson.slug %>" class="btn" style="background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.6rem 1.2rem; font-size: 0.9rem; border-radius: var(--radius-lg); box-shadow: none;">
              &larr; Previous: <%= lesson.prevLesson.title %>
            </a>
          <% } else { %>
            <div></div>
          <% } %>

          <% if (lesson.nextLesson) { %>
            <a href="/courses/<%= lesson.course ? lesson.course.slug : '' %>/lessons/<%= lesson.nextLesson.slug %>" class="btn" style="padding: 0.65rem 1.4rem; font-size: 0.9rem; border-radius: var(--radius-lg);">
              <span>Next: <%= lesson.nextLesson.title %></span>
              &rarr;
            </a>
          <% } else { %>
            <a href="/courses/<%= lesson.course ? lesson.course.slug : '' %>" class="btn" style="background: #059669; color: #ffffff; padding: 0.65rem 1.4rem; font-size: 0.9rem; border-radius: var(--radius-lg);">
              🎉 Complete Course Overview &rarr;
            </a>
          <% } %>
        </div>

      </article>

      <!-- Lesson Discussion / Comments Section -->
      <section style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin: 0 0 1.5rem 0;">
          💬 Lesson Discussion (<%= lesson.comments.length %>)
        </h3>

        <!-- Comment Submission Form -->
        <% if (currentUser) { %>
          <form action="/courses/<%= lesson.course ? lesson.course.slug : '' %>/lessons/<%= lesson.slug %>/comment" method="POST" style="margin-bottom: 2rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="lessonId" value="<%= lesson.id %>">

            <div style="margin-bottom: 1rem;">
              <textarea name="content" rows="3" placeholder="Have a question or insight about this lesson? Leave a comment..." required style="width: 100%; padding: 0.85rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); font-size: 0.92rem; background: var(--bg-surface); color: var(--text-main); outline: none; resize: vertical;"></textarea>
            </div>

            <button type="submit" class="btn" style="padding: 0.55rem 1.3rem; font-size: 0.88rem; border-radius: var(--radius-lg);">
              Post Comment
            </button>
          </form>
        <% } else { %>
          <div style="background: var(--bg-subtle); border: 1px dashed var(--border-light); padding: 1.5rem; border-radius: var(--radius-lg); text-align: center; margin-bottom: 2rem; color: var(--text-muted); font-size: 0.9rem;">
            <span>Only registered developers can post comments in lessons. </span>
            <a href="/auth" style="color: var(--primary-indigo); font-weight: 700; text-decoration: none;">Sign In to join discussion &rarr;</a>
          </div>
        <% } %>

        <!-- Existing Comments List -->
        <% if (lesson.comments.length === 0) { %>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0; text-align: center; padding: 1rem 0;">No comments on this lesson yet. Be the first to share an insight!</p>
        <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% lesson.comments.forEach(c => { %>
              <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); padding: 1.2rem; border-radius: var(--radius-lg);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <strong style="color: var(--text-main); font-size: 0.95rem;"><%= c.authorName %></strong>
                  <span style="font-size: 0.78rem; color: var(--text-dim); font-family: var(--font-mono);"><%= c.createdAtFormatted %></span>
                </div>
                <div style="font-size: 0.92rem; color: var(--text-body); line-height: 1.5;"><%- c.contentHtml %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

    </main>

  </div>

</div>

<!-- Client-side Syntax Highlighting & AJAX Progress Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.hljs) {
      document.querySelectorAll('.article-content pre code').forEach((el) => {
        hljs.highlightElement(el);
      });
    }

    // AJAX Toggle Completion Form Handler
    const completeForm = document.getElementById('lesson-complete-form');
    const completeBtn = document.getElementById('toggle-complete-btn');
    const btnIcon = document.getElementById('complete-btn-icon');
    const btnText = document.getElementById('complete-btn-text');

    if (completeForm && completeBtn) {
      completeForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          const csrf = document.querySelector('input[name="_csrf"]')?.value || '';
          const courseId = document.querySelector('input[name="courseId"]')?.value || '';
          const lessonId = document.querySelector('input[name="lessonId"]')?.value || '';

          const res = await fetch(completeForm.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrf,
              'Accept': 'application/json'
            },
            body: JSON.stringify({ courseId, lessonId })
          });

          const data = await res.json();
          if (data.success) {
            if (data.completed) {
              completeBtn.style.background = '#059669';
              completeBtn.style.color = '#ffffff';
              btnIcon.textContent = '✓';
              btnText.textContent = 'Completed';
            } else {
              completeBtn.style.background = 'var(--bg-surface)';
              completeBtn.style.color = 'var(--text-main)';
              completeBtn.style.border = '1px solid var(--border-light)';
              btnIcon.textContent = '○';
              btnText.textContent = 'Mark as Complete';
            }
          }
        } catch (err) {
          completeForm.submit(); // fallback to standard form submit
        }
      });
    }
  });
</script>
