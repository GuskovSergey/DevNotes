<article class="post-container"
  style="background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: var(--radius-lg); padding: 2.5rem; backdrop-filter: blur(16px); margin-bottom: 3rem;">
  <header style="margin-bottom: 2rem;">
    <div style="display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1rem;">
      <% if (data.category) { %>
        <span class="article-card__badge">
          <%= data.category.name %>
        </span>
        <% } %>
          <span style="color: var(--text-dim); font-size: 0.85rem;">
            <%= data.createdAtFormatted %>
          </span>
          <span style="color: var(--text-dim); font-size: 0.85rem;">• 👁 <%= data.viewsCount %> views</span>
    </div>

    <h1 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; margin-bottom: 1rem;">
      <%= data.title %>
    </h1>

    <% if (data.tags && data.tags.length > 0) { %>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
        <% data.tags.forEach(tag => { %>
          <a href="/tag/<%= tag.slug %>" class="tech-badge" style="text-decoration: none; font-size: 0.8rem; padding: 0.25rem 0.7rem;">
            #<%= tag.name %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </header>

  <% if (data.featuredImage) { %>
    <div
      style="margin-bottom: 2.5rem; overflow: hidden; border-radius: var(--radius-md); border: 1px solid var(--border-glass);">
      <img src="<%= data.featuredImage %>" alt="<%= data.title %>"
        style="width: 100%; max-height: 450px; object-fit: cover; display: block;">
    </div>
    <% } %>

      <div class="article-body" style="font-size: 1.15rem; line-height: 1.8; color: #cbd5e1; white-space: pre-line;">
        <%= data.body %>
      </div>
</article>

<!-- Comments Section -->
<section class="comments-section" style="margin-top: 3rem;">
  <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem;">Comments (<%= data.comments.length %>)</h2>

  <% if (typeof successMessage !=='undefined' && successMessage) { %>
    <div
      style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
      ✓ <%= successMessage %>
    </div>
    <% } %>

      <div class="comments-list" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem;">
        <% if (data.comments.length===0) { %>
          <div
            style="background: var(--bg-card); border: 1px dashed var(--border-glass); padding: 2rem; border-radius: var(--radius-md); text-align: center; color: var(--text-muted);">
            No comments yet. Share your thoughts below!
          </div>
          <% } else { %>
            <% data.comments.forEach(comment=> { %>
              <div
                style="background: var(--bg-card); border: 1px solid var(--border-glass); padding: 1.2rem 1.5rem; border-radius: var(--radius-md); border-left: 3px solid var(--primary-indigo);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <strong style="color: var(--text-main); font-size: 1.05rem;">
                    <%= comment.authorName %>
                  </strong>
                  <small style="color: var(--text-dim);">
                    <%= comment.createdAtFormatted %>
                  </small>
                </div>
                <p style="color: var(--text-muted); font-size: 0.98rem; margin: 0;">
                  <%= comment.content %>
                </p>
              </div>
              <% }) %>
                <% } %>
      </div>

      <!-- Add Comment Box -->
      <div
        style="background: var(--bg-glass); border: 1px solid var(--border-glass); backdrop-filter: blur(16px); padding: 2rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
        <h3 style="margin-bottom: 1.2rem; font-size: 1.4rem;">Leave a Comment</h3>

        <form action="/post/<%= data.id %>/comment" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
              <label for="authorName"
                style="display: block; font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.4rem;">Your
                Name</label>
              <input type="text" name="authorName" placeholder="e.g. John Doe" required>
            </div>

            <div>
              <label for="authorEmail"
                style="display: block; font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.4rem;">Your
                Email</label>
              <input type="email" name="authorEmail" placeholder="e.g. john@example.com" required>
            </div>
          </div>

          <div style="margin-top: 0.5rem;">
            <label for="content"
              style="display: block; font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.4rem;">Comment
              Content</label>
            <textarea name="content" rows="4" placeholder="Write your thoughts..." required></textarea>
          </div>

          <button type="submit" class="btn" style="margin-top: 0.5rem; width: auto;">
            <span>Submit Comment</span>
            &rarr;
          </button>
        </form>
      </div>
</section>