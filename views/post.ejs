<!-- Top Reading Progress Indicator Bar -->
<div id="reading-progress-bar"></div>

<!-- Toast Notification for Share Link Copy -->
<div id="share-toast">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
  <span>Link copied to clipboard!</span>
</div>

<!-- Floating Bottom Sticky Reading Dock -->
<div class="sticky-reading-dock" id="sticky-reading-dock">
  <span class="dock-progress-pill" id="dock-progress-text">0%</span>
  
  <button 
    type="button" 
    class="dock-btn ajax-like-btn <%= (typeof isLiked !== 'undefined' && isLiked) ? 'is-active-like' : '' %>" 
    id="dock-like-btn"
    title="<%= (typeof isLiked !== 'undefined' && isLiked) ? 'Unlike Article' : 'Like Article' %>"
  >
    <span>❤️</span>
    <span id="dock-like-count"><%= data.likesCount || 0 %></span>
  </button>

  <button 
    type="button" 
    class="dock-btn ajax-bookmark-btn <%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'is-active-bookmark' : '' %>" 
    id="dock-bookmark-btn"
    title="<%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'Remove Bookmark' : 'Save Bookmark' %>"
  >
    <span>🔖</span>
    <span id="dock-bookmark-text"><%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'Saved' : 'Bookmark' %></span>
  </button>

  <button type="button" class="dock-btn" id="dock-share-btn" title="Share Article">
    <span>🔗</span>
    <span>Share</span>
  </button>

  <button type="button" class="dock-btn" id="dock-top-btn" title="Scroll to Top">
    <span>↑</span>
    <span>Top</span>
  </button>
</div>

<div class="post-page-wrapper">
  
  <!-- 2-Column Reading Layout Container with Sticky TOC Sidebar -->
  <div class="post-reading-layout">
    
    <!-- Main Article Body Column -->
    <article class="single-post-card" style="min-width: 0;">
      
      <header style="margin-bottom: 2.2rem;">
        
        <!-- Category, Meta & Quick Actions Bar -->
        <div style="display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1.4rem; flex-wrap: wrap;">
          <% if (data.category) { %>
            <a href="/category/<%= data.category.slug %>" class="article-card__badge" style="text-decoration: none;">
              <%= data.category.name %>
            </a>
          <% } %>

          <span class="tech-badge" style="font-size: 0.78rem; padding: 0.2rem 0.65rem; font-family: var(--font-mono); <%= data.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.15); color: #dc2626; border-color: rgba(239, 68, 68, 0.3);' : (data.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent);') %>">
            <%= data.difficultyLevel === 'Advanced' ? '🚀 Advanced' : (data.difficultyLevel === 'Beginner' ? '🌱 Beginner' : '⚡ Intermediate') %>
          </span>

          <span style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-muted); font-size: 0.85rem; font-family: var(--font-mono);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <%= data.readingTime %>
          </span>

          <span style="color: var(--text-dim); font-size: 0.85rem;">•</span>

          <span style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-muted); font-size: 0.85rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <%= data.createdAtFormatted %>
          </span>

          <span style="color: var(--text-dim); font-size: 0.85rem;">•</span>

          <span style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-muted); font-size: 0.85rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <%= data.viewsCount %> views
          </span>

          <!-- Instant Action Buttons Group -->
          <div class="post-action-icon-group" style="margin-left: auto;">
            
            <!-- 1. Seamless AJAX Like Button -->
            <button 
              type="button" 
              class="post-action-icon-btn ajax-like-btn <%= (typeof isLiked !== 'undefined' && isLiked) ? 'active-like' : '' %>" 
              id="header-like-btn"
              title="<%= (typeof isLiked !== 'undefined' && isLiked) ? 'Unlike Article' : 'Like Article' %>"
              data-post-id="<%= data.id %>"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="<%= (typeof isLiked !== 'undefined' && isLiked) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              <span class="post-action-icon-badge" id="header-like-badge" style="display: <%= (data.likesCount && data.likesCount > 0) ? 'inline-flex' : 'none' %>;"><%= data.likesCount || 0 %></span>
            </button>

            <!-- 2. Seamless AJAX Bookmark Button -->
            <button 
              type="button" 
              class="post-action-icon-btn ajax-bookmark-btn <%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'active-bookmark' : '' %>" 
              id="header-bookmark-btn"
              title="<%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'Remove Bookmark' : 'Save Bookmark' %>"
              data-post-id="<%= data.id %>"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="<%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            </button>

            <!-- 3. Export Markdown Button -->
            <a href="/post/<%= data.id %>/export" class="post-action-icon-btn" title="Export Article as Markdown (.md)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </a>

            <!-- 4. Share Link Button -->
            <button id="share-post-btn" type="button" class="post-action-icon-btn" title="Share / Copy Article Link">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            </button>

          </div>
        </div>

        <!-- Article Title -->
        <h1 style="font-size: clamp(2.1rem, 4.8vw, 3.4rem); line-height: 1.18; margin-bottom: 1.4rem; color: var(--text-main); font-weight: 800; letter-spacing: -0.025em;">
          <%= data.title %>
        </h1>

        <!-- Author Header Bar -->
        <% if (data.author) { %>
          <div style="display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.6rem;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.15rem; flex-shrink: 0; box-shadow: var(--shadow-sm);">
              <%= data.author.displayName.charAt(0).toUpperCase() %>
            </div>
            <div>
              <a href="/user/<%= data.author.username %>" style="color: var(--text-main); font-size: 1rem; font-weight: 700; text-decoration: none; display: block;">
                <%= data.author.displayName %>
              </a>
              <span style="color: var(--text-muted); font-size: 0.83rem;">
                @<%= data.author.username %>
              </span>
            </div>
          </div>
        <% } %>

        <!-- Tags List -->
        <% if (data.tags && data.tags.length > 0) { %>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            <% data.tags.forEach(tag => { %>
              <a href="/tag/<%= tag.slug %>" class="tech-badge" style="text-decoration: none; font-size: 0.8rem; padding: 0.25rem 0.75rem;">
                #<%= tag.name %>
              </a>
            <% }) %>
          </div>
        <% } %>
      </header>

      <!-- Series Navigation Box (Knowledge Base Collection) -->
      <% if (data.series) { %>
        <div class="series-nav-box" style="background: var(--bg-surface); border: 1px solid var(--border-accent); border-radius: var(--radius-xl); padding: 1.6rem 1.8rem; margin: 0 0 2.8rem 0; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 0.6rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; color: var(--text-main);">
              <span>📚 Series: <%= data.series.name %></span>
            </div>
            <span class="tech-badge" style="font-size: 0.78rem; background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent);">
              Chapter <%= data.series.currentOrder %> of <%= data.series.totalChapters %>
            </span>
          </div>

          <% if (data.series.description) { %>
            <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 1.2rem; line-height: 1.5;"><%= data.series.description %></p>
          <% } %>

          <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.4rem;">
            <% data.series.posts.forEach((sp, idx) => { %>
              <a href="/post/<%= sp.id %>" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.9rem; border-radius: var(--radius-lg); font-size: 0.92rem; text-decoration: none; transition: background 0.18s ease; <%= sp.isCurrent ? 'background: var(--primary-indigo-light); color: var(--primary-indigo); font-weight: 700;' : 'color: var(--text-main); background: var(--bg-subtle);' %>">
                <span style="font-family: var(--font-mono); font-size: 0.8rem; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; <%= sp.isCurrent ? 'background: var(--primary-indigo); color: white;' : 'background: var(--border-light); color: var(--text-muted);' %>">
                  <%= sp.seriesOrder || (idx + 1) %>
                </span>
                <span style="flex: 1;"><%= sp.title %></span>
                <% if (sp.isCurrent) { %>
                  <span class="tech-badge" style="font-size: 0.7rem; padding: 0.1rem 0.45rem; background: var(--primary-indigo); color: white;">Current Chapter</span>
                <% } %>
              </a>
            <% }) %>
          </div>

          <div style="display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border-light); padding-top: 1rem; flex-wrap: wrap;">
            <% if (data.series.prevPost) { %>
              <a href="/post/<%= data.series.prevPost.id %>" class="btn" style="padding: 0.45rem 1rem; font-size: 0.85rem; background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); box-shadow: none; text-decoration: none;">
                &larr; Previous: <%= data.series.prevPost.title %>
              </a>
            <% } else { %>
              <div></div>
            <% } %>

            <% if (data.series.nextPost) { %>
              <a href="/post/<%= data.series.nextPost.id %>" class="btn" style="padding: 0.45rem 1rem; font-size: 0.85rem; text-decoration: none; margin-left: auto;">
                Next: <%= data.series.nextPost.title %> &rarr;
              </a>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Featured Image Header -->
      <% if (data.featuredImage) { %>
        <div style="margin-bottom: 2.8rem; overflow: hidden; border-radius: var(--radius-xl); border: 1px solid var(--border-light); box-shadow: var(--shadow-card);">
          <img src="<%= data.featuredImage %>" alt="<%= data.title %>" style="width: 100%; max-height: 520px; object-fit: cover; display: block;">
        </div>
      <% } %>

      <!-- Markdown Article Body -->
      <div class="article-body" id="article-body-content" style="font-size: 1.12rem; line-height: 1.88; color: var(--text-body);">
        <%- data.bodyHtml || data.body %>
      </div>

      <!-- Author Bio Card Widget -->
      <% if (data.author) { %>
        <div class="author-bio-card" style="margin-top: 3.5rem;">
          <div class="author-bio-avatar">
            <%= data.author.displayName.charAt(0).toUpperCase() %>
          </div>
          <div class="author-bio-info">
            <div class="author-bio-name"><%= data.author.displayName %></div>
            <div class="author-bio-role">✍️ Автор материала</div>
            <p class="author-bio-desc">
              Автор материалов базы знаний DevHub. Делится практическим опытом, руководствами и готовыми решениями.
            </p>
          </div>
          <a href="/user/<%= data.author.username %>" class="btn" style="padding: 0.6rem 1.2rem; font-size: 0.85rem; text-decoration: none; background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-main); box-shadow: none;">
            Профиль автора &rarr;
          </a>
        </div>
      <% } %>

      <!-- Recommended Next Reads Section -->
      <% if (typeof relatedPosts !== 'undefined' && relatedPosts && relatedPosts.length > 0) { %>
        <section style="margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border-light);">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.4rem;">
            📖 Рекомендуемые материалы по теме
          </h2>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.4rem;">
            Подобранные статьи и руководства базы знаний из категории <%= data.category ? '#' + data.category.name : 'базы знаний' %>.
          </p>

          <div class="related-posts-grid">
            <% relatedPosts.forEach(rp => { %>
              <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.4rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s ease, border-color 0.2s ease;" onmouseover="this.style.borderColor='var(--border-accent)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'">
                <div>
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; flex-wrap: wrap;">
                    <% if (rp.category) { %>
                      <span class="category-pill" style="font-size: 0.72rem; padding: 0.15rem 0.5rem;"><%= rp.category.name %></span>
                    <% } %>
                    <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">⏱ <%= rp.readingTime %></span>
                  </div>

                  <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.35;">
                    <a href="/post/<%= rp.id %>" style="color: var(--text-main); text-decoration: none;"><%= rp.title %></a>
                  </h3>

                  <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= rp.bodySnippet %>
                  </p>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 0.8rem; border-top: 1px dashed var(--border-light);">
                  <span style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">👁 <%= (rp.viewsCount || 0).toLocaleString() %> reads</span>
                  <a href="/post/<%= rp.id %>" class="article-card__read-link">Read &rarr;</a>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

    </article>

    <!-- Right Column: Glassmorphic Table of Contents Sidebar -->
    <aside class="post-toc-container" id="post-toc-sidebar">
      <div class="toc-title">
        <span>📑 Table of Contents</span>
      </div>
      <ul class="toc-list" id="post-toc-list">
        <!-- Dynamically generated via JS -->
      </ul>
    </aside>

  </div>

  <!-- Threaded Comments Section -->
  <section class="comments-section" style="margin-top: 4rem;">
    <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--text-main);">Comments (<%= data.comments.length %>)</h2>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #059669; padding: 1rem 1.4rem; border-radius: var(--radius-lg); margin-bottom: 1.8rem; font-weight: 500;">
        ✓ <%= successMessage %>
      </div>
    <% } %>

    <div class="comments-list" style="display: flex; flex-direction: column; gap: 1.2rem; margin-bottom: 3rem;">
      <% if (data.comments.length === 0) { %>
        <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 2.5rem; border-radius: var(--radius-lg); text-align: center; color: var(--text-muted);">
          No comments yet. Be the first to share your technical thoughts!
        </div>
      <% } else { %>
        <% data.comments.forEach(comment => { %>
          <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 1.4rem 1.6rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);">
            
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 0.8rem;">
              <div style="display: flex; align-items: center; gap: 0.8rem;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; flex-shrink: 0;">
                  <%= comment.authorName.charAt(0).toUpperCase() %>
                </div>

                <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                  <strong style="color: var(--text-main); font-size: 1.05rem;">
                    <%= comment.authorName %>
                  </strong>

                  <% if (data.author && comment.userId === data.author.id) { %>
                    <span class="tech-badge" style="background: var(--primary-indigo-light); color: var(--primary-indigo); border-color: var(--border-accent); font-size: 0.7rem; padding: 0.15rem 0.55rem;">
                      ✍️ Article Author
                    </span>
                  <% } else if (comment.userId) { %>
                    <span class="tech-badge" style="background: rgba(16, 185, 129, 0.15); color: #059669; border-color: rgba(16, 185, 129, 0.3); font-size: 0.7rem; padding: 0.15rem 0.55rem;">
                      ✓ Member
                    </span>
                  <% } %>
                </div>
              </div>

              <span style="color: var(--text-dim); font-size: 0.82rem; font-family: var(--font-mono);">
                <%= comment.createdAtFormatted %>
              </span>
            </div>

            <!-- Rendered Markdown Content in Comment -->
            <div style="color: var(--text-body); font-size: 0.98rem; line-height: 1.6; margin-bottom: 0.8rem; padding-left: 2.8rem;">
              <%- comment.contentHtml || comment.content %>
            </div>

            <!-- Reply Action Button -->
            <div style="padding-left: 2.8rem;">
              <button type="button" class="reply-toggle-btn" data-comment-id="<%= comment.id %>" style="background: none; border: none; color: var(--primary-indigo); font-size: 0.82rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.3rem;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>
                <span>Reply</span>
              </button>

              <!-- Inline Threaded Reply Form -->
              <form id="reply-form-<%= comment.id %>" action="/post/<%= data.id %>/comment" method="POST" style="display: none; margin-top: 1rem; background: var(--bg-subtle); padding: 1.2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="parentId" value="<%= comment.id %>">
                
                <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.6rem;">Replying to <%= comment.authorName %></div>
                
                <% if (typeof currentUser === 'undefined' || !currentUser) { %>
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 0.8rem;">
                    <input type="text" name="authorName" placeholder="Your Name" required style="font-size: 0.88rem; padding: 0.55rem 0.85rem; margin-bottom: 0;">
                    <input type="email" name="authorEmail" placeholder="Your Email" required style="font-size: 0.88rem; padding: 0.55rem 0.85rem; margin-bottom: 0;">
                  </div>
                <% } %>
                <textarea name="content" rows="2" placeholder="Write a reply (Markdown supported)..." required style="font-size: 0.9rem; padding: 0.6rem; margin-bottom: 0.8rem;"></textarea>
                <button type="submit" class="btn" style="padding: 0.45rem 1rem; font-size: 0.82rem;">Submit Reply</button>
              </form>
            </div>

            <!-- Nested Threaded Replies -->
            <% if (comment.replies && comment.replies.length > 0) { %>
              <div style="margin-top: 1.2rem; padding-left: 2.5rem; display: flex; flex-direction: column; gap: 0.9rem; border-left: 2px solid var(--border-light);">
                <% comment.replies.forEach(reply => { %>
                  <div style="background: var(--bg-subtle); padding: 1rem 1.2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; gap: 0.6rem;">
                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <strong style="font-size: 0.9rem; color: var(--text-main);"><%= reply.authorName %></strong>
                        <span class="tech-badge" style="font-size: 0.68rem; padding: 0.1rem 0.4rem;">Reply</span>
                      </div>
                      <span style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-dim);"><%= reply.createdAtFormatted %></span>
                    </div>
                    <div style="font-size: 0.92rem; color: var(--text-body);">
                      <%- reply.contentHtml || reply.content %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- Add Comment Form Container -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 2.2rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-card);">
      <h3 style="margin-bottom: 1.2rem; font-size: 1.4rem; color: var(--text-main);">Leave a Comment</h3>

      <form action="/post/<%= data.id %>/comment" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div style="background: var(--bg-main); border: 1px solid var(--border-light); padding: 0.9rem 1.2rem; border-radius: var(--radius-lg); margin-bottom: 1.4rem; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">
              <%= (currentUser.displayName || currentUser.username).charAt(0).toUpperCase() %>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <span style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;"><%= currentUser.displayName || currentUser.username %></span>
              <span style="color: var(--text-muted); font-size: 0.85rem;">(<%= currentUser.email %>)</span>
              <span class="tech-badge" style="font-size: 0.7rem; padding: 0.1rem 0.5rem; background: var(--primary-indigo-light); color: var(--primary-indigo);">Posting as Member</span>
            </div>
          </div>
        <% } else { %>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1rem;">
            <div>
              <label for="authorName" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">Your Name</label>
              <input type="text" name="authorName" placeholder="e.g. John Doe" required>
            </div>

            <div>
              <label for="authorEmail" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">Your Email</label>
              <input type="email" name="authorEmail" placeholder="e.g. john@example.com" required>
            </div>
          </div>
        <% } %>

        <div>
          <label for="content" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">Comment Content</label>
          <textarea name="content" rows="4" placeholder="Write your technical thoughts or questions..." required></textarea>
        </div>

        <button type="submit" class="btn" style="margin-top: 1.2rem; padding: 0.75rem 1.8rem;">
          <span>Submit Comment</span>
          &rarr;
        </button>
      </form>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const postId = '<%= data.id %>';
    const csrfToken = '<%= csrfToken %>';

    // State
    let isLiked = <%= (typeof isLiked !== 'undefined' && isLiked) ? 'true' : 'false' %>;
    let isBookmarked = <%= (typeof isBookmarked !== 'undefined' && isBookmarked) ? 'true' : 'false' %>;
    let likesCount = <%= data.likesCount || 0 %>;

    // UI elements
    const progressBar = document.getElementById('reading-progress-bar');
    const stickyDock = document.getElementById('sticky-reading-dock');
    const dockProgressText = document.getElementById('dock-progress-text');
    const headerLikeBtn = document.getElementById('header-like-btn');
    const headerLikeBadge = document.getElementById('header-like-badge');
    const headerBookmarkBtn = document.getElementById('header-bookmark-btn');
    const dockLikeBtn = document.getElementById('dock-like-btn');
    const dockLikeCount = document.getElementById('dock-like-count');
    const dockBookmarkBtn = document.getElementById('dock-bookmark-btn');
    const dockBookmarkText = document.getElementById('dock-bookmark-text');
    const dockTopBtn = document.getElementById('dock-top-btn');
    const dockShareBtn = document.getElementById('dock-share-btn');
    const shareBtn = document.getElementById('share-post-btn');
    const shareToast = document.getElementById('share-toast');

    // 1. Reading Progress Bar & Sticky Dock Scroll Handler
    window.addEventListener('scroll', () => {
      const windowHeight = window.innerHeight;
      const fullHeight = document.documentElement.scrollHeight - windowHeight;
      const scrolled = window.scrollY;
      const progressPercent = fullHeight > 0 ? Math.min(100, Math.max(0, Math.round((scrolled / fullHeight) * 100))) : 0;
      
      if (progressBar) {
        progressBar.style.width = progressPercent + '%';
      }

      if (dockProgressText) {
        dockProgressText.innerText = progressPercent + '%';
      }

      if (stickyDock) {
        if (scrolled > 280) {
          stickyDock.classList.add('show');
        } else {
          stickyDock.classList.remove('show');
        }
      }
    });

    if (dockTopBtn) {
      dockTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 2. Seamless Instant AJAX Like Action
    async function handleLikeToggle() {
      <% if (typeof currentUser === 'undefined' || !currentUser) { %>
        window.location.href = '/auth';
        return;
      <% } %>

      try {
        const res = await fetch(`/my/likes/toggle/${postId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          }
        });
        const data = await res.json();
        if (data.success) {
          isLiked = data.liked;
          likesCount = data.liked ? (likesCount + 1) : Math.max(0, likesCount - 1);
          updateLikeUI();
        }
      } catch (err) {
        console.error('Failed to toggle like:', err);
      }
    }

    function updateLikeUI() {
      // Header like button
      if (headerLikeBtn) {
        const svg = headerLikeBtn.querySelector('svg');
        if (isLiked) {
          headerLikeBtn.classList.add('active-like');
          headerLikeBtn.title = 'Unlike Article';
          if (svg) svg.setAttribute('fill', 'currentColor');
        } else {
          headerLikeBtn.classList.remove('active-like');
          headerLikeBtn.title = 'Like Article';
          if (svg) svg.setAttribute('fill', 'none');
        }
        headerLikeBtn.classList.add('heart-pulse-anim');
        setTimeout(() => headerLikeBtn.classList.remove('heart-pulse-anim'), 400);
      }

      if (headerLikeBadge) {
        headerLikeBadge.innerText = likesCount;
        headerLikeBadge.style.display = likesCount > 0 ? 'inline-flex' : 'none';
      }

      // Dock like button
      if (dockLikeBtn) {
        if (isLiked) {
          dockLikeBtn.classList.add('is-active-like');
          dockLikeBtn.title = 'Unlike Article';
        } else {
          dockLikeBtn.classList.remove('is-active-like');
          dockLikeBtn.title = 'Like Article';
        }
        dockLikeBtn.classList.add('heart-pulse-anim');
        setTimeout(() => dockLikeBtn.classList.remove('heart-pulse-anim'), 400);
      }

      if (dockLikeCount) {
        dockLikeCount.innerText = likesCount;
      }
    }

    document.querySelectorAll('.ajax-like-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        handleLikeToggle();
      });
    });

    // 3. Seamless Instant AJAX Bookmark Action
    async function handleBookmarkToggle() {
      <% if (typeof currentUser === 'undefined' || !currentUser) { %>
        window.location.href = '/auth';
        return;
      <% } %>

      try {
        const res = await fetch(`/my/bookmarks/toggle/${postId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          }
        });
        const data = await res.json();
        if (data.success) {
          isBookmarked = data.bookmarked;
          updateBookmarkUI();
        }
      } catch (err) {
        console.error('Failed to toggle bookmark:', err);
      }
    }

    function updateBookmarkUI() {
      // Header bookmark button
      if (headerBookmarkBtn) {
        const svg = headerBookmarkBtn.querySelector('svg');
        if (isBookmarked) {
          headerBookmarkBtn.classList.add('active-bookmark');
          headerBookmarkBtn.title = 'Remove Bookmark';
          if (svg) svg.setAttribute('fill', 'currentColor');
        } else {
          headerBookmarkBtn.classList.remove('active-bookmark');
          headerBookmarkBtn.title = 'Save Bookmark';
          if (svg) svg.setAttribute('fill', 'none');
        }
      }

      // Dock bookmark button
      if (dockBookmarkBtn) {
        if (isBookmarked) {
          dockBookmarkBtn.classList.add('is-active-bookmark');
          dockBookmarkBtn.title = 'Remove Bookmark';
          if (dockBookmarkText) dockBookmarkText.innerText = 'Saved';
        } else {
          dockBookmarkBtn.classList.remove('is-active-bookmark');
          dockBookmarkBtn.title = 'Save Bookmark';
          if (dockBookmarkText) dockBookmarkText.innerText = 'Bookmark';
        }
      }
    }

    document.querySelectorAll('.ajax-bookmark-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        handleBookmarkToggle();
      });
    });

    // 4. Table of Contents (TOC) Generator & Observer Script
    const articleBody = document.getElementById('article-body-content');
    const tocSidebar = document.getElementById('post-toc-sidebar');
    const tocList = document.getElementById('post-toc-list');

    if (articleBody && tocList) {
      const headings = articleBody.querySelectorAll('h2, h3');
      if (headings.length === 0) {
        if (tocSidebar) tocSidebar.style.display = 'none';
      } else {
        let tocHtml = '';
        headings.forEach((heading, idx) => {
          if (!heading.id) {
            heading.id = 'article-heading-' + (idx + 1);
          }
          const isH3 = heading.tagName.toLowerCase() === 'h3';
          const text = heading.innerText || heading.textContent;
          tocHtml += `
            <li>
              <a href="#${heading.id}" class="toc-link ${isH3 ? 'toc-h3' : ''}" data-heading-id="${heading.id}">
                ${isH3 ? '└ ' : ''}${text}
              </a>
            </li>
          `;
        });
        tocList.innerHTML = tocHtml;

        // Smooth scroll for TOC links
        tocList.querySelectorAll('.toc-link').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('data-heading-id');
            const target = document.getElementById(targetId);
            if (target) {
              const yOffset = -90;
              const y = target.getBoundingClientRect().top + window.pageYOffset + yOffset;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
          });
        });

        // IntersectionObserver for active TOC highlight
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              tocList.querySelectorAll('.toc-link').forEach(l => {
                l.classList.toggle('active', l.getAttribute('data-heading-id') === id);
              });
            }
          });
        }, { rootMargin: '-80px 0px -60% 0px' });

        headings.forEach(h => observer.observe(h));
      }
    }

    // 5. IntelliJ Syntax Tokenizer & Code Block Wrapper Script
    function highlightCodeTokens(codeText) {
      let escaped = codeText
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      const comments = [];
      escaped = escaped.replace(/(\/\/[^\n]*|\/\*[\s\S]*?\*\/)/g, (match) => {
        comments.push(match);
        return `___COMMENT_${comments.length - 1}___`;
      });

      const strings = [];
      escaped = escaped.replace(/("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|`(?:[^`\\]|\\.)*`)/g, (match) => {
        strings.push(match);
        return `___STRING_${strings.length - 1}___`;
      });

      const keywords = /\b(const|let|var|function|return|if|else|for|while|do|switch|case|break|continue|import|export|default|class|extends|super|this|new|try|catch|finally|throw|async|await|yield|typeof|instanceof|in|of|void|delete|true|false|null|undefined)\b/g;
      escaped = escaped.replace(keywords, '<span class="token-keyword">$1</span>');

      escaped = escaped.replace(/\b(\d+(?:\.\d+)?)\b/g, '<span class="token-number">$1</span>');

      escaped = escaped.replace(/___STRING_(\d+)___/g, (_, idx) => {
        return `<span class="token-string">${strings[idx]}</span>`;
      });

      escaped = escaped.replace(/___COMMENT_(\d+)___/g, (_, idx) => {
        return `<span class="token-comment">${comments[idx]}</span>`;
      });

      return escaped;
    }

    const codeBlocks = document.querySelectorAll('.article-body pre');
    codeBlocks.forEach(pre => {
      const code = pre.querySelector('code');
      if (!code) return;

      let lang = 'CODE';
      code.classList.forEach(cls => {
        if (cls.startsWith('language-')) {
          lang = cls.replace('language-', '').toUpperCase();
        }
      });

      // Apply Syntax Tokenizer
      const rawText = code.innerText || code.textContent;
      code.innerHTML = highlightCodeTokens(rawText);

      // Wrap <pre> inside a .code-block-wrapper container for IntelliJ themes & header
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const header = document.createElement('div');
      header.className = 'code-header-bar';

      const dots = document.createElement('div');
      dots.className = 'code-window-dots';
      dots.innerHTML = '<span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>';

      const langBadge = document.createElement('span');
      langBadge.className = 'code-lang-badge';
      langBadge.textContent = lang;

      const copyBtn = document.createElement('button');
      copyBtn.className = 'code-copy-btn';
      copyBtn.type = 'button';
      copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> <span>Copy</span>';

      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(rawText);
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> <span>Copied!</span>';
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> <span>Copy</span>';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code: ', err);
        }
      });

      header.appendChild(dots);
      header.appendChild(langBadge);
      header.appendChild(copyBtn);

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });

    // 6. Share Post Button & Toast Handler
    function triggerShareToast() {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(window.location.href).catch(() => {});
      }
      if (shareToast) {
        shareToast.classList.add('show');
        setTimeout(() => {
          shareToast.classList.remove('show');
        }, 3000);
      }
    }

    if (shareBtn) shareBtn.addEventListener('click', triggerShareToast);
    if (dockShareBtn) dockShareBtn.addEventListener('click', triggerShareToast);

    // 7. Threaded Comment Reply Form Toggler
    document.querySelectorAll('.reply-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const commentId = btn.getAttribute('data-comment-id');
        const replyForm = document.getElementById(`reply-form-${commentId}`);
        if (replyForm) {
          const isVisible = replyForm.style.display === 'block';
          replyForm.style.display = isVisible ? 'none' : 'block';
          if (!isVisible) {
            const textarea = replyForm.querySelector('textarea');
            if (textarea) textarea.focus();
          }
        }
      });
    });
  });
</script>