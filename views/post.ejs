<article class="post-container" style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.8rem; box-shadow: var(--shadow-card); margin-bottom: 3rem;">
  <header style="margin-bottom: 2rem;">
    <div style="display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1rem;">
      <% if (data.category) { %>
        <span class="article-card__badge"><%= data.category.name %></span>
      <% } %>
      <span style="color: var(--text-muted); font-size: 0.85rem; font-family: var(--font-mono);"><%= data.createdAtFormatted %></span>
      <span style="color: var(--text-muted); font-size: 0.85rem; font-family: var(--font-mono);">• ⏱ <%= data.readingTime %></span>
      <span style="color: var(--text-muted); font-size: 0.85rem; font-family: var(--font-mono);">• 👁 <%= data.viewsCount %> views</span>
    </div>

    <h1 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.25; margin-bottom: 1rem; color: var(--text-main);"><%= data.title %></h1>
  </header>

  <% if (data.featuredImage) { %>
    <div style="margin-bottom: 2.5rem; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
      <img src="<%= data.featuredImage %>" alt="<%= data.title %>" style="width: 100%; max-height: 450px; object-fit: cover; display: block;">
    </div>
  <% } %>

  <div class="article-body" style="font-size: 1.15rem; line-height: 1.8; color: var(--text-body); white-space: pre-line;">
    <%= data.body %>
  </div>
</article>

<!-- Comments Section -->
<section class="comments-section" style="margin-top: 3rem;">
  <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--text-main);">Comments (<%= data.comments.length %>)</h2>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; font-weight: 500;">
      ✓ <%= successMessage %>
    </div>
  <% } %>

  <div class="comments-list" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem;">
    <% if (data.comments.length === 0) { %>
      <div style="background: var(--bg-surface); border: 1px dashed var(--border-light); padding: 2.5rem; border-radius: var(--radius-lg); text-align: center; color: var(--text-muted);">
        No comments yet. Share your thoughts below!
      </div>
    <% } else { %>
      <% data.comments.forEach(comment => { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 1.4rem 1.6rem; border-radius: var(--radius-lg); border-left: 4px solid var(--primary-indigo); box-shadow: var(--shadow-sm);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <strong style="color: var(--text-main); font-size: 1.05rem;"><%= comment.authorName %></strong>
            <small style="color: var(--text-muted); font-family: var(--font-mono);"><%= comment.createdAtFormatted %></small>
          </div>
          <p style="color: var(--text-body); font-size: 1rem; margin: 0; line-height: 1.6;"><%= comment.content %></p>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Add Comment Box -->
  <div style="background: var(--bg-surface); border: 1px solid var(--border-light); padding: 2.5rem; border-radius: var(--radius-xl); box-shadow: var(--shadow-card);">
    <h3 style="margin-bottom: 1.2rem; font-size: 1.4rem; color: var(--text-main);">Leave a Comment</h3>
    
    <form action="/post/<%= data.id %>/comment" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="authorName" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">Your Name</label>
          <input type="text" name="authorName" placeholder="e.g. John Doe" required>
        </div>

        <div>
          <label for="authorEmail" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">Your Email</label>
          <input type="email" name="authorEmail" placeholder="e.g. john@example.com" required>
        </div>
      </div>

      <div style="margin-top: 0.5rem;">
        <label for="content" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">Comment Content</label>
        <textarea name="content" rows="4" placeholder="Write your thoughts..." required></textarea>
      </div>

      <button type="submit" class="btn" style="margin-top: 0.5rem; width: auto;">
        <span>Submit Comment</span>
        &rarr;
      </button>
    </form>
  </div>
</section>