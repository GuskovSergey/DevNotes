<!-- Redesigned DevHub Home Page (Stitch Design System) -->
<div
  style="background: radial-gradient(circle at 50% -20%, rgba(79, 70, 229, 0.25) 0%, rgba(15, 19, 28, 0) 70%), var(--bg-body); min-height: 100vh;">

  <!-- BLOCK 1: Hero Section (UNCHANGED) -->
  <section class="dev-hero" style="margin-bottom: 3rem; position: relative;">

    <!-- Background Aurora Light Blob -->
    <div
      style="position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 600px; height: 300px; background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, rgba(16, 185, 129, 0.1) 50%, transparent 80%); filter: blur(60px); pointer-events: none; z-index: 0;">
    </div>

    <div class="dev-hero__body" style="position: relative; z-index: 1;">

      <div class="dev-hero__badge"
        style="background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); color: #a5b4fc; box-shadow: 0 0 20px rgba(99, 102, 241, 0.15);">
        <span class="dev-hero__badge-dot" style="background: #10b981; box-shadow: 0 0 10px #10b981;"></span>
        <span>🚀 DevHub — Единая база знаний и инженерное сообщество</span>
      </div>

      <h1 class="dev-hero__heading"
        style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1.2rem;">
        Интерактивная база знаний <br>&amp; Обучающие материалы
      </h1>

      <p class="dev-hero__sub"
        style="font-size: 1.12rem; max-width: 720px; color: var(--text-muted); line-height: 1.65; margin: 0 auto 2rem auto;">
        Практические статьи, структурированные курсы, ответы на вопросы и проверенные решения в единой базе знаний.
      </p>

      <!-- Hero Action Buttons -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 1.2rem; flex-wrap: wrap;">
        <a href="/courses" class="btn"
          style="background: linear-gradient(135deg, var(--primary-indigo) 0%, #4338ca 100%); color: #ffffff; padding: 0.85rem 1.8rem; font-size: 0.98rem; font-weight: 700; border-radius: var(--radius-lg); box-shadow: 0 4px 20px rgba(79, 70, 229, 0.4); border: none;">
          <span>📚 Курсы и программы</span>
          &rarr;
        </a>

        <a href="/posts" class="btn"
          style="background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.85rem 1.8rem; font-size: 0.98rem; font-weight: 700; border-radius: var(--radius-lg); box-shadow: none;">
          <span>📝 Статьи и руководства</span>
        </a>

        <a href="/faq" class="btn"
          style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-light); color: var(--text-muted); padding: 0.85rem 1.6rem; font-size: 0.98rem; font-weight: 600; border-radius: var(--radius-lg); box-shadow: none;">
          <span>💡 Вопросы и ответы</span>
        </a>
      </div>

      <!-- Live Platform Counters Ribbon -->
      <div
        style="display: flex; align-items: center; justify-content: center; gap: 2.2rem; margin-top: 2.5rem; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.88rem;">
        <div
          style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-surface); padding: 0.5rem 1.2rem; border-radius: var(--radius-full); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
          <span style="color: var(--primary-indigo); font-weight: 800; font-size: 1.1rem;">
            <%= stats.totalPosts %>
          </span>
          <span style="color: var(--text-muted);">Статей в базе</span>
        </div>

        <div
          style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-surface); padding: 0.5rem 1.2rem; border-radius: var(--radius-full); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
          <span style="color: #10b981; font-weight: 800; font-size: 1.1rem;">
            <%= stats.totalCourses %>
          </span>
          <span style="color: var(--text-muted);">Курсов</span>
        </div>

        <div
          style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-surface); padding: 0.5rem 1.2rem; border-radius: var(--radius-full); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
          <span style="color: #f59e0b; font-weight: 800; font-size: 1.1rem;">
            <%= (stats.totalViews || 0).toLocaleString() %>
          </span>
          <span style="color: var(--text-muted);">Прочтений</span>
        </div>
      </div>

    </div>
  </section>

  <div style="max-width: 1240px; margin: 0 auto; padding-bottom: 4rem;">

    <!-- BLOCK 2: Core Feature Pillars Grid (UNCHANGED) -->
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <span class="tech-badge"
        style="background: rgba(99, 102, 241, 0.12); color: var(--primary-indigo); border-color: rgba(99, 102, 241, 0.3); font-size: 0.8rem; padding: 0.25rem 0.8rem;">
        ⚡ Разделы базы знаний
      </span>
      <h2
        style="font-size: 2rem; font-weight: 800; color: var(--text-main); margin: 0.6rem 0 0.4rem 0; letter-spacing: -0.02em;">
        Всё необходимое в одном месте
      </h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; max-width: 580px; margin: 0 auto;">
        Информационные статьи, структурированные курсы и быстрые ответы на вопросы.
      </p>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.8rem; margin-bottom: 4rem;">

      <!-- Feature 1: Engineering Courses -->
      <div
        style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; box-shadow: var(--shadow-sm); transition: all 0.3s ease; position: relative; overflow: hidden;"
        onmouseover="this.style.borderColor='var(--primary-indigo)'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 12px 30px rgba(79, 70, 229, 0.15)';"
        onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">
        <div
          style="width: 52px; height: 52px; border-radius: var(--radius-lg); background: rgba(79, 70, 229, 0.15); color: var(--primary-indigo); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1.4rem;">
          📚
        </div>
        <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.6rem;">
          Курсы и Обучение
        </h3>
        <p style="color: var(--text-muted); font-size: 0.93rem; line-height: 1.65; margin-bottom: 1.4rem;">
          Структурированные программы обучения с поэтапными модулями, материалами и отслеживанием прогресса.
        </p>
        <a href="/courses"
          style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--primary-indigo); font-weight: 700; font-size: 0.92rem; text-decoration: none;">
          <span>Смотреть все курсы</span>
          &rarr;
        </a>
      </div>

      <!-- Feature 2: Technical Articles -->
      <div
        style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; box-shadow: var(--shadow-sm); transition: all 0.3s ease; position: relative; overflow: hidden;"
        onmouseover="this.style.borderColor='#10b981'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 12px 30px rgba(16, 185, 129, 0.15)';"
        onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">
        <div
          style="width: 52px; height: 52px; border-radius: var(--radius-lg); background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1.4rem;">
          📝
        </div>
        <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.6rem;">
          База Статей и Гайдов
        </h3>
        <p style="color: var(--text-muted); font-size: 0.93rem; line-height: 1.65; margin-bottom: 1.4rem;">
          Полезные статьи, практические руководства, заметки и проверенные решения.
        </p>
        <a href="/posts"
          style="display: inline-flex; align-items: center; gap: 0.4rem; color: #10b981; font-weight: 700; font-size: 0.92rem; text-decoration: none;">
          <span>Читать все статьи</span>
          &rarr;
        </a>
      </div>

      <!-- Feature 3: Interview Q&A FAQ -->
      <div
        style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 2.2rem; box-shadow: var(--shadow-sm); transition: all 0.3s ease; position: relative; overflow: hidden;"
        onmouseover="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 12px 30px rgba(245, 158, 11, 0.15)';"
        onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">
        <div
          style="width: 52px; height: 52px; border-radius: var(--radius-lg); background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1.4rem;">
          💡
        </div>
        <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.6rem;">
          Вопросы и Ответы (FAQ)
        </h3>
        <p style="color: var(--text-muted); font-size: 0.93rem; line-height: 1.65; margin-bottom: 1.4rem;">
          Каталог частых вопросов, готовых ответов и полезных разъяснений для быстрого обращения.
        </p>
        <a href="/faq"
          style="display: inline-flex; align-items: center; gap: 0.4rem; color: #f59e0b; font-weight: 700; font-size: 0.92rem; text-decoration: none;">
          <span>Открыть базу FAQ</span>
          &rarr;
        </a>
      </div>

    </div>

    <!-- 🔥 REDESIGNED BLOCK 3: Popular & Trending Articles Showcase -->
    <% if (popularPosts && popularPosts.length> 0) { %>
      <section style="margin-bottom: 4rem;">
        <div
          style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
              <span class="tech-badge"
                style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3); font-size: 0.78rem; padding: 0.2rem 0.75rem;">
                🔥 Топ прочтений
              </span>
              <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">• Выбор
                сообщества</span>
            </div>
            <h2
              style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
              Популярные материалы базы знаний
            </h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.3rem 0 0 0;">Самые читаемые и
              высокооцененные статьи от наших инженеров.</p>
          </div>

          <a href="/posts?sort=popular"
            style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.2); color: var(--primary-indigo); padding: 0.5rem 1.1rem; border-radius: var(--radius-full); font-weight: 700; font-size: 0.88rem; text-decoration: none; transition: all 0.2s ease;">
            <span>Смотреть все популярные</span>
            <span style="transition: transform 0.2s;">&rarr;</span>
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
          <% popularPosts.forEach((post, index)=> { %>
            <article
              style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.6rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden;"
              onmouseover="this.style.borderColor='var(--primary-indigo)'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 16px 32px rgba(79, 70, 229, 0.16)';"
              onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">

              <!-- Subtle Accent Corner Glow -->
              <div
                style="position: absolute; top: -30px; right: -30px; width: 90px; height: 90px; background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%); pointer-events: none;">
              </div>

              <div>
                <!-- Top Rank & Category Pill -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                  <span
                    style="font-family: var(--font-mono); font-weight: 800; font-size: 0.82rem; background: linear-gradient(135deg, var(--primary-indigo) 0%, #6366f1 100%); color: #ffffff; border-radius: var(--radius-sm); padding: 0.22rem 0.65rem; box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);">
                    #<%= index + 1 %> TOP
                  </span>
                  <% if (post.category) { %>
                    <span class="category-pill"
                      style="font-size: 0.73rem; padding: 0.18rem 0.6rem; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-light);">
                      <%= post.category.name %>
                    </span>
                    <% } %>
                </div>

                <h3
                  style="font-size: 1.18rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.65rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <a href="/post/<%= post.id %>"
                    style="color: var(--text-main); text-decoration: none; transition: color 0.2s;"
                    onmouseover="this.style.color='var(--primary-indigo)'"
                    onmouseout="this.style.color='var(--text-main)'">
                    <%= post.title %>
                  </a>
                </h3>

                <p
                  style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.4rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= post.bodySnippet %>
                </p>
              </div>

              <!-- Footer Stats & Link -->
              <div
                style="border-top: 1px solid var(--border-light); padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">
                <div style="display: flex; align-items: center; gap: 0.9rem;">
                  <span style="display: inline-flex; align-items: center; gap: 0.3rem;">👁 <%= (post.viewsCount ||
                      0).toLocaleString() %></span>
                  <span style="display: inline-flex; align-items: center; gap: 0.3rem;">⏱ <%= post.readingTime %></span>
                </div>
                <a href="/post/<%= post.id %>"
                  style="color: var(--primary-indigo); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.2rem;">
                  <span>Читать</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </article>
            <% }) %>
        </div>
      </section>
      <% } %>

        <!-- 🗂️ REDESIGNED BLOCK 4: Knowledge Categories Navigator -->
        <% if (categories && categories.length> 0) { %>
          <section style="margin-bottom: 4rem;">
            <div style="margin-bottom: 1.8rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                <span class="tech-badge"
                  style="background: rgba(16, 185, 129, 0.12); color: #10b981; border-color: rgba(16, 185, 129, 0.3); font-size: 0.78rem; padding: 0.2rem 0.75rem;">
                  🗂️ Рубрикатор
                </span>
                <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">• Разделы
                  знаний</span>
              </div>
              <h2
                style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
                Навигатор по категориям знаний
              </h2>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.3rem 0 0 0;">Мгновенный доступ к
                руководствам по ключевым архитектурным темам.</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.3rem;">
              <% categories.forEach(cat=> { %>
                <a href="/posts?category=<%= cat.slug %>"
                  style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.3rem 1.5rem; text-decoration: none; display: flex; align-items: center; justify-content: space-between; transition: all 0.3s ease; box-shadow: var(--shadow-sm);"
                  onmouseover="this.style.borderColor='#10b981'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 25px rgba(16, 185, 129, 0.15)'; this.querySelector('.arrow-icon').style.transform='translateX(5px)';"
                  onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)'; this.querySelector('.arrow-icon').style.transform='translateX(0)';">

                  <div style="display: flex; align-items: center; gap: 0.9rem;">
                    <div
                      style="width: 44px; height: 44px; border-radius: var(--radius-lg); background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.25); display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);">
                      📂
                    </div>
                    <div>
                      <h4
                        style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.2rem 0; line-height: 1.3;">
                        <%= cat.name %>
                      </h4>
                      <span
                        style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); background: rgba(255, 255, 255, 0.05); padding: 0.1rem 0.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
                        <%= cat.postsCount || 0 %>
                          <%= (cat.postsCount===1) ? 'статья' : ((cat.postsCount>= 2 && cat.postsCount <= 4) ? 'статьи'
                              : 'статей' ) %>
                      </span>
                    </div>
                  </div>

                  <span class="arrow-icon"
                    style="color: #10b981; font-weight: 700; font-size: 1.1rem; transition: transform 0.2s ease;">&rarr;</span>
                </a>
                <% }) %>
            </div>
          </section>
          <% } %>

            <!-- 🎓 REDESIGNED BLOCK 5: Featured Courses Section -->
            <% if (courses && courses.length> 0) { %>
              <section style="margin-bottom: 4rem;">
                <div
                  style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem;">
                  <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                      <span class="tech-badge"
                        style="background: rgba(99, 102, 241, 0.12); color: var(--primary-indigo); border-color: rgba(99, 102, 241, 0.3); font-size: 0.78rem; padding: 0.2rem 0.75rem;">
                        🎓 Структурированное обучение
                      </span>
                      <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">•
                        Инженерные треки</span>
                    </div>
                    <h2
                      style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
                      Рекомендуемые курсы базы знаний
                    </h2>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.3rem 0 0 0;">Пошаговые программы с
                      модулями, практикой и контролем прогресса.</p>
                  </div>

                  <a href="/courses"
                    style="display: inline-flex; align-items: center; gap: 0.4rem; background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.5rem 1.2rem; border-radius: var(--radius-full); font-weight: 700; font-size: 0.88rem; text-decoration: none; transition: all 0.2s ease;"
                    onmouseover="this.style.borderColor='var(--primary-indigo)'"
                    onmouseout="this.style.borderColor='var(--border-light)'">
                    <span>Все курсы</span>
                    &rarr;
                  </a>
                </div>

                <div class="article-grid"
                  style="grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.6rem;">
                  <% courses.forEach(course=> { %>
                    <article class="article-card"
                      style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm); transition: all 0.3s ease;"
                      onmouseover="this.style.borderColor='var(--primary-indigo)'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 16px 35px rgba(79, 70, 229, 0.15)';"
                      onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">

                      <!-- Gradient Accent Top Header Ribbon -->
                      <div
                        style="height: 6px; background: linear-gradient(90deg, var(--primary-indigo) 0%, #10b981 50%, #f59e0b 100%);">
                      </div>

                      <div style="padding: 1.6rem;">
                        <!-- Course Meta Top -->
                        <div
                          style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
                          <span class="tech-badge"
                            style="font-size: 0.74rem; padding: 0.2rem 0.65rem; font-family: var(--font-mono); <%= course.difficultyLevel === 'Advanced' ? 'background: rgba(239, 68, 68, 0.15); color: #ef4444; border-color: rgba(239, 68, 68, 0.3);' : (course.difficultyLevel === 'Beginner' ? 'background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);' : 'background: rgba(99, 102, 241, 0.15); color: #818cf8; border-color: rgba(99, 102, 241, 0.3);') %>">
                            <%= course.difficultyLevel==='Advanced' ? '🚀 Продвинутый' :
                              (course.difficultyLevel==='Beginner' ? '🌱 Начальный' : '⚡ Средний' ) %>
                          </span>

                          <div
                            style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">
                            <span>⏱ <%= course.estimatedTime %></span>
                            <span>•</span>
                            <span>📚 <%= course.lessonsCount %> модулей</span>
                          </div>
                        </div>

                        <h3
                          style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.65rem; line-height: 1.35;">
                          <a href="/courses/<%= course.slug %>" style="color: var(--text-main); text-decoration: none;">
                            <%= course.title %>
                          </a>
                        </h3>

                        <p
                          style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                          <%= course.descriptionSnippet %>
                        </p>
                      </div>

                      <!-- Footer Author & Action Button -->
                      <div
                        style="background: rgba(255, 255, 255, 0.02); border-top: 1px solid var(--border-light); padding: 1.1rem 1.6rem; display: flex; align-items: center; justify-content: space-between;">
                        <% if (course.author) { %>
                          <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <div
                              style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-indigo) 0%, #10b981 100%); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; overflow: hidden; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);">
                              <% if (course.author.avatarUrl) { %>
                                <img src="<%= course.author.avatarUrl %>" alt="Автор"
                                  style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                  <%= (course.author.displayName || course.author.username).charAt(0).toUpperCase() %>
                                    <% } %>
                            </div>
                            <span
                              style="font-size: 0.84rem; font-weight: 600; color: var(--text-main); font-family: var(--font-mono);">@
                              <%= course.author.username %></span>
                          </div>
                          <% } %>

                            <a href="/courses/<%= course.slug %>" class="btn"
                              style="background: linear-gradient(135deg, var(--primary-indigo) 0%, #4338ca 100%); color: #ffffff; padding: 0.5rem 1.3rem; font-size: 0.86rem; font-weight: 700; border-radius: var(--radius-lg); border: none; box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35); margin-left: auto;">
                              <span>Пройти курс</span>
                              &rarr;
                            </a>
                      </div>
                    </article>
                    <% }) %>
                </div>
              </section>
              <% } %>

                <!-- 💡 REDESIGNED BLOCK 6: Featured FAQ Spotlight -->
                <% if (featuredFaqs && featuredFaqs.length> 0) { %>
                  <section style="margin-bottom: 4rem;">
                    <div
                      style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem;">
                      <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                          <span class="tech-badge"
                            style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3); font-size: 0.78rem; padding: 0.2rem 0.75rem;">
                            💡 Избранные ответы
                          </span>
                          <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">•
                            Инженерный FAQ</span>
                        </div>
                        <h2
                          style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
                          Частые вопросы и ответы (FAQ)
                        </h2>
                        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.3rem 0 0 0;">Быстрые решения,
                          разборы кейсов и практические пояснения.</p>
                      </div>

                      <a href="/faq"
                        style="display: inline-flex; align-items: center; gap: 0.4rem; color: #f59e0b; font-weight: 700; font-size: 0.9rem; text-decoration: none;">
                        <span>Вся база FAQ</span>
                        &rarr;
                      </a>
                    </div>

                    <div
                      style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
                      <% featuredFaqs.forEach(faq=> { %>
                        <div
                          style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.6rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s ease; position: relative;"
                          onmouseover="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 28px rgba(245, 158, 11, 0.15)';"
                          onmouseout="this.style.borderColor='var(--border-light)'; this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">
                          <div>
                            <!-- Top Category & Upvotes Pill -->
                            <div
                              style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.9rem;">
                              <span class="tech-badge"
                                style="font-size: 0.73rem; padding: 0.18rem 0.6rem; font-family: var(--font-mono); background: rgba(245, 158, 11, 0.12); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3);">
                                <%= faq.category %>
                              </span>
                              <span
                                style="font-size: 0.78rem; color: #f59e0b; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); padding: 0.15rem 0.55rem; border-radius: var(--radius-full); font-family: var(--font-mono); font-weight: 700;">
                                👍 <%= faq.upvotesCount || 0 %>
                              </span>
                            </div>

                            <h3
                              style="font-size: 1.12rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.6rem; line-height: 1.45;">
                              <%= faq.question %>
                            </h3>
                          </div>

                          <div
                            style="margin-top: 1.4rem; padding-top: 0.9rem; border-top: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
                              Сложность: <%= faq.difficulty %>
                            </span>
                            <a href="/faq"
                              style="color: #f59e0b; font-weight: 700; font-size: 0.86rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
                              <span>Ответ</span>
                              <span>&rarr;</span>
                            </a>
                          </div>
                        </div>
                        <% }) %>
                    </div>
                  </section>
                  <% } %>

                    <!-- 📝 REDESIGNED BLOCK 7: Recent Technical Articles Stream -->
                    <% if (latestPosts && latestPosts.length> 0) { %>
                      <section style="margin-bottom: 4rem;">
                        <div
                          style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem;">
                          <div>
                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                              <span class="tech-badge"
                                style="background: rgba(99, 102, 241, 0.12); color: var(--primary-indigo); border-color: rgba(99, 102, 241, 0.3); font-size: 0.78rem; padding: 0.2rem 0.75rem;">
                                📝 Свежие публикации
                              </span>
                              <span
                                style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">•
                                Инженерный поток</span>
                            </div>
                            <h2
                              style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;">
                              Свежий поток материалов
                            </h2>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.3rem 0 0 0;">Новые
                              руководства, разборы архитектур и заметки от сообщества.</p>
                          </div>

                          <a href="/posts"
                            style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--primary-indigo); font-weight: 700; font-size: 0.9rem; text-decoration: none;">
                            <span>Все статьи</span>
                            &rarr;
                          </a>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 1.2rem;">
                          <% latestPosts.forEach(post=> { %>
                            <article
                              style="background: var(--bg-surface); border: 1px solid var(--border-light); border-left: 4px solid var(--primary-indigo); border-radius: var(--radius-xl); padding: 1.6rem 1.8rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; transition: all 0.25s ease;"
                              onmouseover="this.style.borderColor='var(--primary-indigo)'; this.style.transform='translateX(4px)';"
                              onmouseout="this.style.borderColor='var(--border-light)'; this.style.borderLeftColor='var(--primary-indigo)'; this.style.transform='translateX(0)';">

                              <div style="flex: 1; min-width: 280px;">
                                <div
                                  style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
                                  <% if (post.category) { %>
                                    <span class="category-pill" style="font-size: 0.75rem; padding: 0.18rem 0.6rem;">
                                      <%= post.category.name %>
                                    </span>
                                    <% } %>
                                      <span
                                        style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">⏱
                                        <%= post.readingTime %></span>
                                      <span
                                        style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--text-muted);">👁
                                        <%= (post.viewsCount || 0).toLocaleString() %> просмотров</span>
                                </div>

                                <h3
                                  style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.45rem; line-height: 1.35;">
                                  <a href="/post/<%= post.id %>"
                                    style="color: var(--text-main); text-decoration: none; transition: color 0.2s;"
                                    onmouseover="this.style.color='var(--primary-indigo)'"
                                    onmouseout="this.style.color='var(--text-main)'">
                                    <%= post.title %>
                                  </a>
                                </h3>

                                <p
                                  style="font-size: 0.9rem; color: var(--text-muted); margin: 0; line-height: 1.55; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 720px;">
                                  <%= post.bodySnippet %>
                                </p>
                              </div>

                              <div style="display: flex; align-items: center; gap: 1.2rem; flex-shrink: 0;">
                                <% if (post.author) { %>
                                  <span
                                    style="font-size: 0.84rem; color: var(--text-muted); font-family: var(--font-mono);">Автор:
                                    @<%= post.author.username %></span>
                                  <% } %>
                                    <a href="/post/<%= post.id %>" class="btn"
                                      style="background: var(--bg-body); border: 1px solid var(--border-light); color: var(--text-main); padding: 0.55rem 1.3rem; font-size: 0.88rem; font-weight: 700; border-radius: var(--radius-lg); transition: all 0.2s ease;">
                                      <span>Читать</span>
                                      &rarr;
                                    </a>
                              </div>

                            </article>
                            <% }) %>
                        </div>
                      </section>
                      <% } %>

                        <!-- 🚀 REDESIGNED BLOCK 8: Community Contribution CTA Banner -->
                        <section
                          style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%); border-radius: var(--radius-xl); padding: 3.8rem 2.5rem; color: #ffffff; text-align: center; box-shadow: 0 20px 45px rgba(15, 23, 42, 0.4); border: 1px solid rgba(99, 102, 241, 0.35); position: relative; overflow: hidden;">

                          <!-- Background Code Watermark Decoration -->
                          <div
                            style="position: absolute; top: -20px; right: -20px; font-size: 14rem; font-family: var(--font-mono); color: rgba(255, 255, 255, 0.02); font-weight: 900; user-select: none; pointer-events: none;">
                            &lt;/&gt;
                          </div>

                          <div style="position: relative; z-index: 1;">
                            <span class="tech-badge"
                              style="background: rgba(255, 255, 255, 0.1); color: #a5b4fc; border-color: rgba(255, 255, 255, 0.2); font-size: 0.8rem; padding: 0.25rem 0.85rem; margin-bottom: 1rem; display: inline-block;">
                              🤝 Инженерное сообщество
                            </span>

                            <h2
                              style="font-size: 2.2rem; font-weight: 800; color: #ffffff; margin-bottom: 0.8rem; letter-spacing: -0.02em; line-height: 1.2;">
                              Делитесь знаниями и опытом
                            </h2>

                            <p
                              style="font-size: 1.1rem; color: rgba(255, 255, 255, 0.85); max-width: 650px; margin: 0 auto 2.2rem auto; line-height: 1.65;">
                              Присоединяйтесь к разработчикам, публикующим практические статьи, архитектурные гайды и
                              курсы в единой базе знаний DevHub.
                            </p>

                            <div style="display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap;">
                              <a href="/my/posts/new" class="btn"
                                style="background: #ffffff; color: var(--primary-indigo); border: none; font-weight: 800; padding: 0.85rem 2.2rem; font-size: 1rem; border-radius: var(--radius-lg); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25); transition: transform 0.2s ease;"
                                onmouseover="this.style.transform='translateY(-2px)'"
                                onmouseout="this.style.transform='translateY(0)'">
                                ✍️ Написать статью
                              </a>
                              <a href="/my/courses/new" class="btn"
                                style="background: rgba(255, 255, 255, 0.12); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); font-weight: 700; padding: 0.85rem 2.2rem; font-size: 1rem; border-radius: var(--radius-lg); backdrop-filter: blur(10px); transition: background 0.2s ease;"
                                onmouseover="this.style.background='rgba(255, 255, 255, 0.2)'"
                                onmouseout="this.style.background='rgba(255, 255, 255, 0.12)'">
                                🎓 Создать курс
                              </a>
                            </div>
                          </div>

                        </section>

  </div>

</div>